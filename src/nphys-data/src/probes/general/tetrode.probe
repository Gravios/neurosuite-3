probeFile:
  version: '1.0'
  vendor: general
  model: tetrode
  totalChannels: 4

  # ── Physical construction ────────────────────────────────────────────────
  # A tetrode is a bundle of 4 insulated nichrome or tungsten wires twisted
  # together and cut at the tip.  The four recording sites therefore sit at
  # essentially the same depth in tissue.
  #
  # This file describes a single tetrode (one shank, 4 sites).  For multi-
  # tetrode arrays, reference this file once per tetrode in the session YAML
  # probes: list and set each entry's channelOffset accordingly.
  substrate: { material: wire-bundle, thickness_um: null }

  shanks:
    count: 1
    spacing_um: null       # single tetrode
    length_mm: null        # cut length is experiment-specific; fill in if known

  # ── Electrode sites ──────────────────────────────────────────────────────
  # count_per_shank may be a scalar (all shanks equal) or a list
  # [n0, n1, ...] for probes with unequal channel counts per shank.
  # Here all 4 channels are on the single shank.
  #
  # geometry lists every site as [x_um, y_um] in the probe reference frame:
  #   x  — lateral position in the bundle cross-section (µm)
  #   y  — depth along the penetration axis (µm, tip = 0)
  # All four wires are cut at the same depth so y = 0 for every site.
  # The x spread (~36 µm total) reflects a standard nichrome tetrode bundle.
  sites:
    count_per_shank: 4     # scalar: all shanks (here just one) have 4 sites
    layout: tetrode
    area_um2: 25            # ~5.6 µm diameter (nichrome); use 25-50 for tungsten
    spacing_um: null        # sites are not linearly arranged
    geometry:               # explicit enumeration: one [x_um, y_um] per site
      - [-18, 0]            # wire 1
      - [ -6, 0]            # wire 2
      - [  6, 0]            # wire 3
      - [ 18, 0]            # wire 4

  # ── Channel mapping ──────────────────────────────────────────────────────
  # null → sequential from channelOffset (0 → wire1, 1 → wire2, ...)
  # Replace with [2, 0, 3, 1] etc. if your wiring order differs.
  channelMap:
    description: "Sequential — wire order matches amplifier channel order."
    map: null

  notes: "Vendor-agnostic single tetrode (4-wire bundle).  All sites at y=0
    (same recording depth); ndm_estimatedrift treats the tetrode as a point
    sensor.  For tungsten or PtIr tetrodes adjust area_um2 to 25-50 µm²."
