# NeuroNexus A4x1-tet-3mm-150-121 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 26.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A4x1-tet-3mm-150-121
  catalogPage: 26
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 4
    spacing_um: 150
    length_mm: 3.0
  sites:
    count_per_shank: 4
    layout: tetrode
    area_um2: 121
    spacing_um: null
    geometry:
    # shank 0
    - [0, 92.7]
    - [-17.7, 75]
    - [17.7, 75]
    - [0, 57.3]
    # shank 1
    - [150, 92.7]
    - [132.3, 75]
    - [167.7, 75]
    - [150, 57.3]
    # shank 2
    - [300, 92.7]
    - [282.3, 75]
    - [317.7, 75]
    - [300, 57.3]
    # shank 3
    - [450, 92.7]
    - [432.3, 75]
    - [467.7, 75]
    - [450, 57.3]
  channelMap:
    description: null
    map: null
  notes: '4 shanks 150 µm apart, one diamond tetrode per shank centred 75 µm above the tip. Sites 11 × 11 µm, 25 µm apart (measured). Also made 50 µm thick (p26).'
