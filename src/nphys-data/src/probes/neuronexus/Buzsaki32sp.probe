# NeuroNexus Buzsaki32sp — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 73.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki32sp
  catalogPage: 73
  totalChannels: 32
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 4
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: octrode
    area_um2: 160
    spacing_um: null
    geometry:
    # shank 0
    - [-14.8, 162]
    - [12.3, 142]
    - [-12.3, 122]
    - [9.7, 102]
    - [-9.7, 82]
    - [7.2, 62]
    - [-7.2, 42]
    - [0, 22]
    # shank 1
    - [185.2, 162]
    - [212.3, 142]
    - [187.7, 122]
    - [209.7, 102]
    - [190.3, 82]
    - [207.2, 62]
    - [192.8, 42]
    - [200, 22]
    # shank 2
    - [385.2, 162]
    - [412.3, 142]
    - [387.7, 122]
    - [409.7, 102]
    - [390.3, 82]
    - [407.2, 62]
    - [392.8, 42]
    - [400, 22]
    # shank 3
    - [585.2, 162]
    - [612.3, 142]
    - [587.7, 122]
    - [609.7, 102]
    - [590.3, 82]
    - [607.2, 62]
    - [592.8, 42]
    - [600, 22]
  channelMap:
    description: null
    map: null
  notes: '4 shanks 200 µm apart. 8 staggered sites per shank in a narrower cluster, 20 µm apart vertically, lowest 22 µm above the tip; lateral offsets measured.'
