# NeuroNexus A1x32-5mm-25-177 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 34.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A1x32-5mm-25-177
  catalogPage: 34
  totalChannels: 32
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 1
    spacing_um: null
    length_mm: 5.0
  sites:
    count_per_shank: 32
    layout: linear
    area_um2: 177
    spacing_um: 25
    geometry:
    # shank 0
    - [0, 825]
    - [0, 800]
    - [0, 775]
    - [0, 750]
    - [0, 725]
    - [0, 700]
    - [0, 675]
    - [0, 650]
    - [0, 625]
    - [0, 600]
    - [0, 575]
    - [0, 550]
    - [0, 525]
    - [0, 500]
    - [0, 475]
    - [0, 450]
    - [0, 425]
    - [0, 400]
    - [0, 375]
    - [0, 350]
    - [0, 325]
    - [0, 300]
    - [0, 275]
    - [0, 250]
    - [0, 225]
    - [0, 200]
    - [0, 175]
    - [0, 150]
    - [0, 125]
    - [0, 100]
    - [0, 75]
    - [0, 50]
  channelMap:
    description: null
    map: null
  notes: '1 shank, 32 sites each in one column, 25 µm pitch, lowest site 50 µm above the tip. Also made 50 µm thick (p34).'
