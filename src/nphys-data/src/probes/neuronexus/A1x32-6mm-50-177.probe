# NeuroNexus A1x32-6mm-50-177 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 36.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A1x32-6mm-50-177
  catalogPage: 36
  totalChannels: 32
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 1
    spacing_um: null
    length_mm: 6.0
  sites:
    count_per_shank: 32
    layout: linear
    area_um2: 177
    spacing_um: 50
    geometry:
    # shank 0
    - [0, 1600]
    - [0, 1550]
    - [0, 1500]
    - [0, 1450]
    - [0, 1400]
    - [0, 1350]
    - [0, 1300]
    - [0, 1250]
    - [0, 1200]
    - [0, 1150]
    - [0, 1100]
    - [0, 1050]
    - [0, 1000]
    - [0, 950]
    - [0, 900]
    - [0, 850]
    - [0, 800]
    - [0, 750]
    - [0, 700]
    - [0, 650]
    - [0, 600]
    - [0, 550]
    - [0, 500]
    - [0, 450]
    - [0, 400]
    - [0, 350]
    - [0, 300]
    - [0, 250]
    - [0, 200]
    - [0, 150]
    - [0, 100]
    - [0, 50]
  channelMap:
    description: null
    map: null
  notes: '1 shank, 32 sites each in one column, 50 µm pitch, lowest site 50 µm above the tip. Also made 50 µm thick (p36).'
