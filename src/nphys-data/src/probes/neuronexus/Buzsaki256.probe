# NeuroNexus Buzsaki256 — NeuroSuite-3 probe configuration
# Source: 2026 Penetrating Probe Catalog v2.1, page 136
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki256
  catalogPage: 136
  totalChannels: 256
  substrate:
    material: silicon
    thickness_um: 13        # ultra-thin confirmed from catalog
  shanks:
    count: 32
    spacing_um: 65          # 2100 µm total span / 32 shanks ≈ 65 µm outer pitch; inner groups 50 µm
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: octrode
    area_um2: 160
    spacing_um: null
    geometry:
      - [0,    0]
      - [-11,  20]
      - [11,   40]
      - [-11,  60]
      - [11,   80]
      - [-11, 100]
      - [11,  120]
      - [-11, 140]
  channelMap: { description: "AV256 Activus or I256 Intan connector", map: null }
  notes: >
    32-shank ultra-dense probe. 2100 µm lateral span. Up to 15% irregular sites.
    Requires Activus or 256-ch Intan system. 300 µm between 8-shank groups.
