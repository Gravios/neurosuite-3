# NeuroNexus Buzsaki16 — NeuroSuite-3 probe configuration
# Source: 2026 Penetrating Probe Catalog v2.1, page 34
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki16
  catalogPage: 34
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 2
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: octrode
    area_um2: 160
    spacing_um: null
    # x = lateral offset (µm), y = depth from tip (µm). Deepest site first.
    geometry:
      - [0,    0]
      - [-11,  20]
      - [11,   40]
      - [-11,  60]
      - [11,   80]
      - [-11, 100]
      - [11,  120]
      - [-11, 140]
  channelMap: { description: "A16 Omnetics connector", map: null }
  notes: >
    2-shank 16-ch Buzsaki octrode probe. Reference sites 4200 µm² at shank base
    (not counted). Shanks 200 µm apart. Superficial site is 8.5 µm tip.
