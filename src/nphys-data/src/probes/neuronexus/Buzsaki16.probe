# NeuroNexus Buzsaki16 — neurosuite-3 probe configuration
# Catalog page 34
# 2 shanks, 8 sites/shank, 16 total channels
# Geometry fully enumerated: all 16 sites as [x_um, y_um]
#   x = lateral position from first shank tip (µm)
#   y = depth from shank tip (µm); sites ordered tip-to-base
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki16
  catalogPage: 34
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 2
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: octrode
    area_um2: 160
    spacing_um: null
    geometry:
    - [0, 0]
    - [-11, 20]
    - [11, 40]
    - [-11, 60]
    - [11, 80]
    - [-11, 100]
    - [11, 120]
    - [-11, 140]
    - [200, 0]
    - [189, 20]
    - [211, 40]
    - [189, 60]
    - [211, 80]
    - [189, 100]
    - [211, 120]
    - [189, 140]
  channelMap:
    description: A16 Omnetics connector
    map: null
  notes: '2-shank 16-ch Buzsaki octrode probe. Reference sites 4200 µm² at shank base (not counted). Shanks 200 µm apart.
    Superficial site is 8.5 µm tip.

    '
