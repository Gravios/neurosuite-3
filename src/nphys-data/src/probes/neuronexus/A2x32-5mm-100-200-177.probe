# NeuroNexus A2x32-5mm-100-200-177 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 80.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A2x32-5mm-100-200-177
  catalogPage: 80
  totalChannels: 64
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 2
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 32
    layout: linear
    area_um2: 177
    spacing_um: 100
