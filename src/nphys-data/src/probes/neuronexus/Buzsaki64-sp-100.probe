# NeuroNexus Buzsaki64-sp-100 — NeuroSuite-3 probe configuration
# Source: 2026 Penetrating Probe Catalog v2.1, page 103
# Variant with 500 µm group spacing, graded site areas along shank
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki64-sp-100
  catalogPage: 103
  totalChannels: 64
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 1
    spacing_um: null
    length_mm: 5.0
  sites:
    count_per_shank: 64
    layout: octrode
    area_um2: 160           # nominal; actual graded 159-160 µm²
    spacing_um: null
    geometry_groups:
      group_spacing_um: 500
      n_groups: 8
      sites_per_group: 8
      # Graded lateral spread from tip (narrow) to base (wider)
      within_group:
        - [0,   0]
        - [-11, 20]
        - [11,  40]
        - [-11, 60]
        - [11,  80]
        - [-11, 100]
        - [11,  120]
        - [-11, 140]
  channelMap: { description: "H64LP dual 32-ch Omnetics", map: null }
  notes: >
    Graded-area single-shank probe. Site areas range from ~159 µm² at tip to
    160 µm² near base. Designed for equal signal amplitude across layers.
