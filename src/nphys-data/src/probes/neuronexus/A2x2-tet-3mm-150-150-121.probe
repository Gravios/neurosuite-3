# NeuroNexus A2x2-tet-3mm-150-150-121 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 24.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A2x2-tet-3mm-150-150-121
  catalogPage: 24
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 2
    spacing_um: 150
    length_mm: 3.0
  sites:
    count_per_shank: 8
    layout: tetrode
    area_um2: 121
    spacing_um: null
    geometry:
    # shank 0
    - [0, 245.7]
    - [-17.7, 228]
    - [17.7, 228]
    - [0, 210.3]
    - [0, 95.7]
    - [-17.7, 78]
    - [17.7, 78]
    - [0, 60.3]
    # shank 1
    - [150, 245.7]
    - [132.3, 228]
    - [167.7, 228]
    - [150, 210.3]
    - [150, 95.7]
    - [132.3, 78]
    - [167.7, 78]
    - [150, 60.3]
  channelMap:
    description: null
    map: null
  notes: '2 shanks 150 µm apart, 2 diamond tetrodes per shank, centres 78 and 228 µm above the tip (labelled 78; the drawing shows ~68). Sites 11 × 11 µm, 25 µm apart within a tetrode (measured). Also made 50 µm thick (p24).'
