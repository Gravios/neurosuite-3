# NeuroNexus Buzsaki64sp — NeuroSuite-3 probe configuration
# Source: 2026 Penetrating Probe Catalog v2.1, page 105 — single-shank 8×octrode
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki64sp
  catalogPage: 105
  totalChannels: 64
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 1
    spacing_um: null
    length_mm: 5.0
  sites:
    count_per_shank: 64
    layout: octrode     # 8 groups of 8 stacked octrodes along single shank
    area_um2: 160
    spacing_um: null
    # Groups of 8 octrode sites stacked 500 µm apart along a single shank
    # Within each group: ±11 µm, ~20 µm vertical step (140 µm span)
    geometry_groups:
      group_spacing_um: 500
      n_groups: 8
      sites_per_group: 8
      within_group:
        - [0,    0]
        - [-11,  20]
        - [11,   40]
        - [-11,  60]
        - [11,   80]
        - [-11, 100]
        - [11,  120]
        - [-11, 140]
  channelMap: { description: "H64LP dual 32-ch Omnetics", map: null }
  notes: >
    Single-shank version for simultaneous multi-layer recording.
    8 octrode groups separated by 500 µm allow coverage of ~3500 µm depth.
