# NeuroNexus A4x4-3mm-50-125-177 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 28.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A4x4-3mm-50-125-177
  catalogPage: 28
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 4
    spacing_um: 125
    length_mm: 3.0
  sites:
    count_per_shank: 4
    layout: linear
    area_um2: 177
    spacing_um: 50
    geometry:
    # shank 0
    - [0, 200]
    - [0, 150]
    - [0, 100]
    - [0, 50]
    # shank 1
    - [125, 200]
    - [125, 150]
    - [125, 100]
    - [125, 50]
    # shank 2
    - [250, 200]
    - [250, 150]
    - [250, 100]
    - [250, 50]
    # shank 3
    - [375, 200]
    - [375, 150]
    - [375, 100]
    - [375, 50]
  channelMap:
    description: null
    map: null
  notes: '4 shanks 125 µm apart, 4 sites each in one column, 50 µm pitch, lowest site 50 µm above the tip.'
