    area_um2: 177
    spacing_um: 50
    geometry:
    - [0, 0]
    - [0, 50]
    - [0, 100]
    - [0, 150]
    - [125, 0]
    - [125, 50]
    - [125, 100]
    - [125, 150]
    - [250, 0]
    - [250, 50]
    - [250, 100]
    - [250, 150]
    - [375, 0]
    - [375, 50]
    - [375, 100]
    - [375, 150]
  channelMap:
    description: null
    map: null
  notes: 4-shank, 4 ch/shank linear. 125 µm shank pitch.
