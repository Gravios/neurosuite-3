# NeuroNexus A1x16-10mm-100-177 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 21.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A1x16-10mm-100-177
  catalogPage: 21
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 1
    spacing_um: null
    length_mm: 10.0
  sites:
    count_per_shank: 16
    layout: linear
    area_um2: 177
    spacing_um: 100
    geometry:
    # shank 0
    - [0, 1550]
    - [0, 1450]
    - [0, 1350]
    - [0, 1250]
    - [0, 1150]
    - [0, 1050]
    - [0, 950]
    - [0, 850]
    - [0, 750]
    - [0, 650]
    - [0, 550]
    - [0, 450]
    - [0, 350]
    - [0, 250]
    - [0, 150]
    - [0, 50]
  channelMap:
    description: null
    map: null
  notes: '1 shank, 16 sites each in one column, 100 µm pitch, lowest site 50 µm above the tip. Also made 50 µm thick (p21).'
