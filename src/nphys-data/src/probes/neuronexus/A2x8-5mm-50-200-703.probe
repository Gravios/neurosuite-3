# NeuroNexus A2x8-5mm-50-200-703 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 25.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A2x8-5mm-50-200-703
  catalogPage: 25
  totalChannels: 16
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 2
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: linear
    area_um2: 703
    spacing_um: 50
    geometry:
    # shank 0
    - [0, 400]
    - [0, 350]
    - [0, 300]
    - [0, 250]
    - [0, 200]
    - [0, 150]
    - [0, 100]
    - [0, 50]
    # shank 1
    - [200, 400]
    - [200, 350]
    - [200, 300]
    - [200, 250]
    - [200, 200]
    - [200, 150]
    - [200, 100]
    - [200, 50]
  channelMap:
    description: null
    map: null
  notes: '2 shanks 200 µm apart, 8 sites each in one column, 50 µm pitch, lowest site 50 µm above the tip.'
