# NeuroNexus A4x8-5mm-100-200-177 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 64.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: A4x8-5mm-100-200-177
  catalogPage: 64
  totalChannels: 32
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 4
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: linear
    area_um2: 177
    spacing_um: 100
    geometry:
    # shank 0
    - [0, 750]
    - [0, 650]
    - [0, 550]
    - [0, 450]
    - [0, 350]
    - [0, 250]
    - [0, 150]
    - [0, 50]
    # shank 1
    - [200, 750]
    - [200, 650]
    - [200, 550]
    - [200, 450]
    - [200, 350]
    - [200, 250]
    - [200, 150]
    - [200, 50]
    # shank 2
    - [400, 750]
    - [400, 650]
    - [400, 550]
    - [400, 450]
    - [400, 350]
    - [400, 250]
    - [400, 150]
    - [400, 50]
    # shank 3
    - [600, 750]
    - [600, 650]
    - [600, 550]
    - [600, 450]
    - [600, 350]
    - [600, 250]
    - [600, 150]
    - [600, 50]
  channelMap:
    description: null
    map: null
  notes: '4 shanks 200 µm apart, 8 sites each in one column, 100 µm pitch, lowest site 50 µm above the tip. (The panel captions on p64 read 50-400; the drawing and title are 100-200.) Also made 50 µm thick (p64).'
