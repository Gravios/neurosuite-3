# NeuroNexus Buzsaki32 — neurosuite-3 probe configuration
# NeuroNexus Penetrating Probes catalogue, August 2025, page 70.
# Generated by src/nphys-data/tools/neuronexus_probes.py — edit the table there.
#   geometry: [x_um, y_um] per site, shank by shank, TOP SITE FIRST;
#   y = height above the shank tip, x = offset from the tip axis
#   + shank index × shanks.spacing_um.  Site j is channel channelOffset + j,
#   so channel numbers ascend with depth on every shank.
probeFile:
  version: '1.0'
  vendor: NeuroNexus
  model: Buzsaki32
  catalogPage: 70
  totalChannels: 32
  substrate:
    material: silicon
    thickness_um: 15
  shanks:
    count: 4
    spacing_um: 200
    length_mm: 5.0
  sites:
    count_per_shank: 8
    layout: octrode
    area_um2: 160
    spacing_um: null
    geometry:
    # shank 0
    - [-20.7, 162]
    - [16.6, 142]
    - [-16.6, 122]
    - [12.7, 102]
    - [-12.7, 82]
    - [8.6, 62]
    - [-8.6, 42]
    - [0, 22]
    # shank 1
    - [179.3, 162]
    - [216.6, 142]
    - [183.4, 122]
    - [212.7, 102]
    - [187.3, 82]
    - [208.6, 62]
    - [191.4, 42]
    - [200, 22]
    # shank 2
    - [379.3, 162]
    - [416.6, 142]
    - [383.4, 122]
    - [412.7, 102]
    - [387.3, 82]
    - [408.6, 62]
    - [391.4, 42]
    - [400, 22]
    # shank 3
    - [579.3, 162]
    - [616.6, 142]
    - [583.4, 122]
    - [612.7, 102]
    - [587.3, 82]
    - [608.6, 62]
    - [591.4, 42]
    - [600, 22]
  channelMap:
    description: null
    map: null
  notes: '4 shanks 200 µm apart. 8 staggered sites per shank, 20 µm apart vertically, lowest 22 µm above the tip; lateral offsets measured from the drawing. Sites 11 × 15 µm.'
