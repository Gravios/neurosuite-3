    geometry:
      - [0,    0]
      - [-11,  20]
      - [11,   40]
      - [-11,  60]
      - [11,   80]
      - [-11, 100]
      - [11,  120]
      - [-11, 140]
  channelMap: { description: "H64LP dual 32-ch Omnetics", map: null }
  notes: >
    8-shank 64-ch archetypal hippocampal probe. 1400 µm lateral span.
    Reference sites 4200 µm² at base. Tip width 8.5 µm.
    Cite: Berenyi et al. (2014) J Neurophysiol.
