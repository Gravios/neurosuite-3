{ "ndm_fiber-kit", "intrachunk.off_thr", "1.0", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.depth_gate", "35.0", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.amp_gate", "1.1", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.refrac_ceiling", "1.0", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.pre_merge_cos", "0.97", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.linkage", "complete", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.align_lag", "6", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.align_upsample", "1", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.cfiber_q", "0.9", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.cfiber_null", "order", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.cfiber_thr_floor", "0.0", "Optional", true,
  "" },
{ "ndm_fiber-kit", "intrachunk.sig_cap", "8000", "Optional", true,
  "" },
{ "ndm_hipass", "filter", "butterworth", "Optional", true,
  "butterworth (default when unset) or median.\n\nbutterworth: zero-phase Butterworth (process_butterworth) -- run forward then backward, so there is no phase distortion; the magnitude response is squared (-6 dB at each corner, effective order 2 x order). Linear, so it adds no content the .dat does not have. Double precision on the CPU and single on a GPU (auto); in double the .fil equals scipy's sosfiltfilt rounded to int16.\n\nmedian: the historical median-subtraction high-pass (process_medianfilter). Non-linear: the output is exactly 0 wherever the centre sample is the window median (about 5% of samples), its effective -3 dB corner is ~800 Hz at windowHalfLength 16 and 32.5 kHz, and it adds broadband content above 10 kHz." },
{ "ndm_hipass", "highPassHz", "800", "Optional", true,
  "butterworth: high-pass corner in Hz (default 800, matching the median filter's effective corner at windowHalfLength 16)." },
{ "ndm_hipass", "lowPassHz", "6000", "Optional", false,
  "butterworth: optional low-pass corner in Hz (default 0 = none), making the filter a band-pass." },
{ "ndm_hipass", "order", "3", "Optional", false,
  "butterworth: design order of each stage (default 3; 6 after zero phase)." },
{ "ndm_hipass", "precision", "auto", "Optional", false,
  "butterworth: auto (default; double on the CPU, single on a GPU), double or single. Single changes ~0.04% of samples by 1 LSB on the reference data." },
{ "ndm_hipass", "windowHalfLength", "16", "Optional", false,
  "median: half-length (samples) of the median window. 16 at 32.5 kHz gives an effective -3 dB corner of about 800 Hz." },
{ "ndm_hipass", "chunkSize", "134217728", "Optional", true,
  "median: bytes of .dat data processed per pass (default 134217728 = 128 MiB). Reduce if RAM is limited. Capped internally at 512 MiB to prevent OOM." },
{ "ndm_hipass", "inputExtension", "dat", "Optional", false,
  "Data file read for filtering, without the leading dot (default dat). Point it at an alternative, externally-processed source (e.g. car.dat) to filter that file instead of the raw recording.\n\nA leading dot is ignored (.lfp = lfp). When set, the file must exist: a missing one stops the step with an error rather than skipping it." },
{ "ndm_klustakwik", "minClusters", "2", "Optional", true,
  "Minimum clusters passed to KlustaKwik -MinClusters (default 2)." },
{ "ndm_klustakwik", "maxClusters", "100", "Optional", true,
  "Maximum clusters to fit. Tetrodes: 12-20; high-density probes: 50-100 (default 100)." },
{ "ndm_klustakwik", "maxPossibleClusters", "500", "Optional", true,
  "Hard upper bound on the internal cluster table; must be >= maxClusters. Increase for very large recordings (default 500)." },
{ "ndm_klustakwik", "nStarts", "3", "Optional", true,
  "Number of random restarts in non-chunked (two-phase) mode (default 3). In chunked mode, prefer nRuns." },
{ "ndm_klustakwik", "nRuns", "0", "Optional", true,
  "Per-chunk CEM restarts when using chunked mode (default 0 = single start per chunk). When nRuns > 0 and chunkMinutes > 0, each chunk independently runs CEMTwoPhase nRuns times with different random seeds and keeps its best-scoring result before handing it to Phase 2 cross-chunk matching. Phase 0 preseed, Phase 1.5 realignment, and Phase 2 each still run only once. This is the per-chunk analogue of nStarts in non-chunked mode. Recommended: 3." },
{ "ndm_klustakwik", "phase15Iters", "1", "Optional", true,
  "Passed as -Phase15Iters (default 2), an option KiloKlustaKwik does not read: it has no effect." },
{ "ndm_klustakwik", "subspaceDims", "0", "Optional", true,
  "Phase 2a/2b run on the top N spatial features, ranked by within-cluster or within-chunk variance (default 3); 0 uses every feature dimension." },
{ "ndm_klustakwik", "subspaceRecluster", "0", "Optional", true,
  "1 (default) re-clusters each cluster in its own feature subspace after Phase 2; 0 skips it." },
{ "ndm_klustakwik", "templateMatchScore", "0.0", "Optional", true,
  "Minimum waveform cross-correlation for merging two clusters of one chunk by their templates (default 0.0 = off)." },
{ "ndm_klustakwik", "templateMatchIters", "10", "Optional", true,
  "Maximum within-chunk template-merge iterations (default 10)." },
{ "ndm_klustakwik", "splitRecurseDepth", "1", "Optional", true,
  "Maximum recursion depth of the split search (default 0)." },
{ "ndm_klustakwik", "subspaceReclusterDepth", "0", "Optional", true,
  "Passed as -SubspaceReclusterDepth (default 2), an option KiloKlustaKwik does not read: it has no effect." },
{ "ndm_klustakwik", "crossChunkTemplateScore", "0.0", "Optional", true,
  "Minimum waveform cross-correlation for matching clusters across chunks by their templates (default 0.0 = off)." },
{ "ndm_klustakwik", "initMethod", "farthest", "Optional", true,
  "Cluster centre initialisation: \"farthest\" (default) or \"random\"." },
{ "ndm_klustakwik", "penaltyMix", "0", "Optional", true,
  "Penalty mix for the CEM objective; 0 = BIC penalty (default 0)." },
{ "ndm_klustakwik", "method", "standard", "Optional", true,
  "Detection method of the files to cluster: reads .fet.<method>.N and writes .clu.<method>.N (default standard). It must match the method of ndm_detectspikes / ndm_extractspikes / ndm_pca. --method on the command line overrides it." },
{ "ndm_klustakwik", "chunkMinutes", "10", "Optional", true,
  "Duration (minutes) of each temporal chunk. 0 disables chunking and uses standard two-phase CEM on the full recording (default 10)." },
{ "ndm_klustakwik", "chunkOverlapMinutes", "2", "Optional", true,
  "Overlap (minutes) added at each chunk boundary to smooth transitions (default 2)." },
{ "ndm_klustakwik", "chunkPreseedFraction", "0.05", "Optional", true,
  "Fraction of spikes used in a fast Phase-0 preseed pass to initialise cluster centres before per-chunk CEM; 0 disables preseeding (default 0.05)." },
{ "ndm_klustakwik", "mergeThresh", "42.0", "Optional", true,
  "Maximum Mahalanobis distance for merging cluster pairs across chunks. Must be calibrated to chi²(nDims, p): for 25 dims, chi²(25, 0.99) ≈ 44.3. A warning is emitted when this exceeds 1.5× chi²(nDims, 0.9999) (default 42.0)." },
{ "ndm_klustakwik", "globalMergeIter", "50", "Optional", true,
  "EM iterations run on the globally merged model after all chunks are combined (default 50)." },
{ "ndm_klustakwik", "timeMergeIter", "50", "Optional", true,
  "Phase-2 temporal merge iterations in two-phase CEM mode; 0 disables (default 50)." },
{ "ndm_klustakwik", "splitEvery", "25", "Optional", true,
  "CEM iterations between split attempts (default 25)." },
{ "ndm_klustakwik", "maxIter", "500", "Optional", true,
  "Maximum CEM iterations per chunk (default 500)." },
{ "ndm_klustakwik", "distThresh", "6.9", "Optional", true,
  "Mahalanobis distance threshold for assigning spikes to clusters (default 6.9)." },
{ "ndm_klustakwik", "fullStepEvery", "10", "Optional", true,
  "Full E-step recomputed every N iterations; partial steps used otherwise (default 10)." },
{ "ndm_klustakwik", "changedThresh", "0.05", "Optional", true,
  "Fractional change in cluster assignments below which CEM is considered converged (default 0.05)." },
{ "ndm_klustakwik", "log", "1", "Optional", true,
  "Write KlustaKwik log file (1 = yes, 0 = no, default 1)." },
{ "ndm_klustakwik", "screen", "0", "Optional", true,
  "Print progress to stdout (1 = yes, 0 = no, default 0)." },
{ "ndm_klustakwik", "fSaveModel", "1", "Optional", true,
  "Save the fitted mixture model to disk (1 = yes, 0 = no, default 1)." },
{ "ndm_klustakwik", "saveIntermediates", "0", "Optional", true,
  "Write .clu.N each time a new best score is found during CEM (1 = yes, 0 = no, default 0).\n\nPHASE 1.5 WAVEFORM REALIGNMENT\n\nPhase 1.5 runs after all per-chunk CEMTwoPhase jobs and before Phase 2.\n\nStep 1 — xcorr alignment: per-cluster mean waveform from .spk, xcorr each spike against its mean to find the shift. Home-chunk first-write-wins for overlap spikes. Needs NbChannels + nbSamplesPerSpike (auto from YAML).\n\nStep 2 — .fil re-extraction: re-reads the aligned waveform from the .fil broadband file at (rawTs - shift - PeakSampleIndex), projects through PCA, updates Data[] before Phase 2 matching. Falls back to circular shift from .spk when .fil is absent. Needs NbTotalChannels + GroupChannelIds (auto-detected from acquisitionSystem.nChannels and group channels)." },
{ "ndm_klustakwik", "overwrite", "0", "Optional", true,
  "If 1, delete an existing .clu.N and re-sort. If 0 (default), skip groups whose .clu.N already exists. Can be set per-group in spikeDetection.channelGroups[g].klustakwik.overwrite." },
{ "ndm_klustakwik", "nThreads", "0", "Optional", true,
  "Number of OpenMP threads passed to KlustaKwik via OMP_NUM_THREADS. KlustaKwik has no -nThreads flag; the value is exported into its environment before launch and unset afterwards so it does not leak to other tools. 0 (default) = use all available cores (nproc). Set explicitly only when you need to leave cores free for other concurrent work." },
{ "ndm_lfp", "samplingRate", "1250", "Mandatory", true,
  "Target sampling rate in Hz (default = 1250 Hz). Should match fieldPotentials.lfpSamplingRate." },
{ "ndm_lfp", "subtractSpikes", "auto", "Optional", true,
  "Whether to strip spikes before resampling (see above)." },
{ "ndm_lfp", "inputExtension", "dat", "Optional", false,
  "Data file read for resampling, without the leading dot (default dat). Point it at an alternative, externally-processed source (e.g. car.dat) to downsample that file instead of the raw recording.\n\nA leading dot is ignored (.lfp = lfp). When set, the file must exist: a missing one stops the step with an error rather than skipping it.\n\nAny value but dat selects the source outright: the spike-cleaned dat is not used even when present, because ndm_stripdat cleans session.dat and cannot produce a spike-free version of another file. Combining it with subtractSpikes=yes is refused rather than silently resolved one way or the other." },
{ "ndm_localise", "method", "monopole", "Optional", true,
  "Inverse model (default = monopole). monopole Point-source model; recovers x, y, z and amplitude per spike. com Amplitude-weighted centre-of-mass — fast but no z estimate." },
{ "ndm_localise", "clusterFilter", "good", "Optional", true,
  "Which spikes to fully localise (default = good). all Every spike regardless of cluster assignment. good Clusters ≥ 2 (noise/MUA spikes are localised but flagged with residual_rms = NaN so downstream tools can filter them)." },
{ "ndm_localise", "maxDistUm", "200", "Optional", true,
  "Reject a fit and output NaN if the estimated source is further than this distance from the nearest electrode site (µm, default = 200)." },
{ "ndm_localise", "nBootstrap", "0", "Optional", true,
  "Bootstrap replicates per spike for position uncertainty (default = 0 = disabled). When > 0, writes SESSION.loc.std.N with per-spike standard deviations across replicates. Values of 50–200 are typical." },
{ "ndm_localise", "overwrite", "0", "Optional", true,
  "If 1, delete existing .loc.N and re-localise (default = 0 = skip)." },
{ "ndm_localise", "probeLibrary", "", "Optional", true,
  "Override probe library search path. Default search order: $NEUROSUITE_PROBE_PATH, ~/.local/share/neurosuite/probes/, /usr/local/share/neurosuite/probes/, /usr/share/neurosuite/probes/, probes/ (session-local directory)." },
{ "ndm_mergedat", "suffixes", "", "Mandatory", true,
  "List of suffixes for the individual files to merge" },
{ "ndm_mergedat", "nChannels", "", "Mandatory", true,
  "Space-separated list of channel counts in individual files (one per suffix)" },
{ "ndm_ncs2dat", "reverse", "false", "Mandatory", true,
  "Whether the signals should be reversed (by default, NeuraLynx reverses all signals -- this sets them back to normal)" },
{ "ndm_ncs2dat", "suffixes", "nlx", "Mandatory", true,
  "List of suffixes of the directories where the NCS files are located" },
{ "ndm_ncs2dat", "gap", "1", "Optional", false,
  "Sampling gap threshold for 'acquisition restart' detection (seconds, default = 1)." },
{ "ndm_ncs2dat", "ignoreEvents", "false", "Optional", false,
  "Set to 'true' if NEV files incorrectly list acquisition start/stop events (default = false)." },
{ "ndm_nev2evt", "suffixes", "nlx", "Mandatory", true,
  "List of suffixes of the directories where the NEV files are located" },
{ "ndm_nev2evt", "gap", "1", "Optional", false,
  "Sampling gap threshold for 'acquisition restart' detection (seconds, default = 1)." },
{ "ndm_nvt2spots", "suffix", "", "Mandatory", true,
  "Suffix of the directory where the NVT file is located" },
{ "ndm_nvt2spots", "gap", "1", "Optional", false,
  "Sampling gap threshold for 'acquisition restart' detection (seconds, default = 1)." },
{ "ndm_nvt2spots", "ignoreEvents", "false", "Optional", true,
  "Set to 'true' if the NEV files list acquisition start/stop events incorrectly; 'restart acquisition' events are then guessed from the timestamps (default = false)." },
{ "ndm_pca", "before", "12", "Mandatory", true,
  "Samples before the waveform peak to include in PCA. Either a single value for all groups or a space-separated list (one per group). Default = 12." },
{ "ndm_pca", "after", "12", "Mandatory", true,
  "Samples after the waveform peak. Same format as before. Default = 12." },
{ "ndm_pca", "extra", "false", "Mandatory", true,
  "If true, include the spike peak value as an extra feature in the .fet file." },
{ "ndm_pca", "excludeClusters", "", "Optional", true,
  "Comma-separated list of cluster ids whose spikes are dropped from the PCA fit (e.g. \"5,12\"). All spikes are still projected through the resulting basis — the .fet has one row per spike — only the basis direction changes. Useful for second-pass PCA after an initial clustering identifies high-rate units (interneurons, artefact clusters) that would otherwise dominate the eigenvector solution.\n\nAuto-resolves the .clu path as session.clu.electrodeGroup; this file must exist before ndm_pca starts (run an initial PCA + clustering pass first, then re-run with excludeClusters set). Leave empty (or omit) on the first PCA pass." },
{ "ndm_pca", "dropLastChannel", "true", "Optional", true,
  "The spatial derivative leaves one channel that is dropped before PCA (N channels give N-1 feature groups). For orders 1 and 3 it is an exact combination of the others, so dropping it costs nothing; for a custom pattern (stderiv_C4 / stderiv_C5) it may carry information. true (default) drops it, false keeps it. ndm_refeaturize reads it from here unless its own block sets it." },
{ "ndm_pca", "varimax", "true", "Optional", true,
  "true (default) rotates the kept components (Varimax) so each follows a spike-shape source rather than a variance-ordered mixture, which makes the feature axes legible for hand-sorting. The rotation is saved in the .pca basis, so Klusters' reprojection follows it. false keeps the unrotated basis." },
{ "ndm_pca", "varimaxMaxIter", "30", "Optional", false,
  "Maximum Varimax iterations (process_pca default 30)." },
{ "ndm_pca", "varimaxTol", "1e-6", "Optional", false,
  "Relative change of the Varimax criterion that counts as converged (process_pca default 1e-6)." },
{ "ndm_pca", "method", "standard", "Optional", true,
  "standard, sdiff or stderiv (default standard): the waveform domain the PCA is fit in, stamped on the outputs (.fet.<method>.N, .pca.<method>.N). A suffix _D<lag><dims> (e.g. stderiv_C5_D34) also writes the lagged feature space -- per channel PC1 at -lag, 0 and +lag samples, plus PC2 when dims is 4 -- beside the ordinary features. --method on the command line overrides it." },
{ "ndm_pca", "methodOrder", "3", "Optional", true,
  "Spatial derivative order, 0-3 (default 3; stderiv only). The old name sdiffOrder is accepted. A suffixed method (stderiv_C4) states the order itself and wins. --methodOrder overrides it." },
{ "ndm_pca", "threadsPerGroup", "2", "Optional", false,
  "OpenMP threads per group when running all groups in parallel (`ndm_pca` with no explicit group argument launches one process per group). Default = floor(nCores / nGroups), minimum 1. Set explicitly to cap total CPU use: threadsPerGroup * nGroups <= nAvailableCores" },
{ "ndm_plx2dat", "plexonFile", "", "Mandatory", true,
  "Path to the .plx or .pl2 file, absolute or relative to the session directory. The container is detected from the file signature." },
{ "ndm_plx2dat", "stream", "", "Optional", true,
  "Channel-name prefix of the continuous stream to export: WB (wideband, default when recorded), SPKC (spike-filtered continuous), FP (field potentials), AI (auxiliary analog). When unset and there is no WB data, the fastest stream with data is used." },
{ "ndm_plx2dat", "channels", "", "Optional", true,
  "Subset and order within the stream: 1-based indices and ranges and/or channel names, e.g. 1-16,18 or WB01,WB05 (default = all)." },
{ "ndm_plx2dat", "keepEmpty", "true", "Optional", true,
  "Keep stream channels that recorded no data as all-zero .dat channels, so .dat channel k stays Plexon channel k+1 (default = true)." },
{ "ndm_plx2dat", "padToZero", "false", "Optional", true,
  "Start the .dat at timestamp 0 instead of at the first sample, so .dat sample n is Plexon tick n x ticksPerSample (default = false; the offset is always recorded as sourceRecording.export.firstSampleTimestamp_ticks)." },
{ "ndm_plx2dat", "evtId", "plx", "Optional", true,
  "Three-character id of the event file SESSION.<evtId>.evt (default = plx). NeuroScope requires exactly 3 characters, not all digits. The file holds every digital event (keyboard, single-bit inputs, strobed words, start/stop) in ms from .dat sample 0, labelled by channel name (with the value when a channel's values vary, always for strobed channels), plus \"gap start\" / \"gap end\" around zero-filled pauses." },
{ "ndm_plx2dat", "extraStreams", "auto", "Optional", true,
  "Other continuous streams to export, each to SESSION.px<stream> (e.g. SESSION.pxai, SESSION.pxfp) in the .dat layout at the stream's own rate, aligned to the .dat start: auto (default — every other stream with data except SPKC, the spike-filtered copy of WB), all, none, or a comma list such as AI,FP. Files with the .dat's channel count are added to the files: list so NeuroScope opens them at the right rate." },
{ "ndm_plx2dat", "exportSpikes", "true", "Optional", true,
  "Export Plexon's online spikes (default = true): per spike channel N, SESSION.pxres.N (.dat sample times, text like .res), SESSION.pxclu.N (cluster id = Plexon unit + 1, text like .clu: unsorted -> 1, unit a -> 2) and SESSION.pxspk.N (raw int16 waveforms like .spk). Own types, so they never shadow the pipeline's .res/.clu/.spk." },
{ "ndm_plx2dat", "chunkSamples", "", "Optional", true,
  "Output samples written per chunk (default = 2^21 / nChannels, about 4 MB of output — a cache-friendly buffer; much larger chunks are measurably slower)." },
{ "ndm_reextractspikes", "reextractThresholdFactor", "0.75", "Optional", true,
  "Scale factor applied to the per-group median-threshold baseline to obtain the re-extraction threshold. Lower values recover more low-amplitude events but also admit more noise crossings. Typical range: 0.5 .. 0.9. Default 0.75." },
{ "ndm_reextractspikes", "reextractMaskHalfWidth", "", "Optional", true,
  "Minimum sample distance a new candidate peak must maintain from every original spike timestamp. Defaults to refractoryPeriod if left blank." },
{ "ndm_reextractspikes", "reextractMinClusterSize", "50", "Optional", true,
  "Existing clusters with fewer members are not eligible as parents for shadow assignment (median / MAD statistics unreliable below this). Default 50." },
{ "ndm_reextractspikes", "reextractChi2", "0.999", "Optional", true,
  "χ² quantile for the squared-Mahalanobis admission threshold. Lower is stricter (more spikes fall into unmatched); higher is permissive. Default 0.999 (down from 0.9999 in 2026-04): 0.9999 on ~20D features proved over-permissive in practice and produced runaway absorption into a single over-dispersed parent cluster." },
{ "ndm_reextractspikes", "reextractExtraFeat", "auto", "Optional", true,
  "Whether the reference .fet.N includes the per-channel peak features appended by process_pca -x: auto (inferred from dimensionality), 0, or 1. Leave on auto." },
{ "ndm_reextractspikes", "reextractInflationRatio", "5.0", "Optional", true,
  "Upper bound on per-parent absorption as a multiple of |parent|. A parent with 1868 reference spikes may absorb at most max(reextractInflationCap, 5.0 × 1868) = 9340 new spikes. Excess spikes (largest d²) are demoted to the unmatched bin. Introduced in 2026-04 to fix runaway per-parent shadow inflation. Set to 0 to disable. Default 5.0." },
{ "ndm_reextractspikes", "reextractInflationCap", "500", "Optional", true,
  "Absolute minimum cap on per-parent absorption. Small reference clusters still get at least this many new spikes regardless of reextractInflationRatio. Default 500. Set to 0 to disable the guard." },
{ "ndm_reextractspikes", "reextractAutoSubcluster", "0", "Optional", true,
  "When 1, ndm_subcluster_unmatched is invoked on the merged session after re-extraction. The unmatched bin (typically 80-95 % of new spikes) receives KlustaKwik with its own parameter section — see programs[ndm_subcluster_unmatched] — so the operator sees real cluster labels in Klusters, not one amorphous pile. When 0 (default), the operator runs ndm_subcluster_unmatched manually." },
{ "ndm_reextractspikes", "method", "standard", "Optional", true,
  "Engine whose files this step reads and writes: standard (default), sdiff or stderiv. Must match the method of the detection / PCA / clustering run it continues; it selects the .<type>.<method>.N names." },
{ "ndm_reextractspikes", "methodOrder", "3", "Optional", true,
  "Spatial-derivative order 1-3 for sdiff / stderiv (default 3). thresholdFactor, refractoryPeriod, peakSearchLength, start and duration come from ndm_detectspikes unless set in this block." },
{ "ndm_refeaturize", "method", "standard", "Optional", true,
  "standard (default), sdiff or stderiv — as in ndm_pca." },
{ "ndm_refeaturize", "methodOrder", "3", "Optional", true,
  "Spatial-derivative order 1-3 for sdiff / stderiv (default 3)." },
{ "ndm_refeaturize", "extra", "false", "Optional", true,
  "Append per-channel peak values as extra features. Must match the extra setting ndm_pca used when it fit the basis (default false)." },
{ "ndm_reorderchannels", "channels", "", "Mandatory", true,
  "Space-separated list of reordered channel indices (0-based)" },
{ "ndm_resample", "suffixes", "", "Mandatory", true,
  "List of suffixes for the individual files to resample" },
{ "ndm_resample", "samplingRates", "", "Mandatory", true,
  "Space-separated list of original sampling rates (one per suffix)" },
{ "ndm_resample", "nChannels", "", "Mandatory", true,
  "Space-separated list of channel counts in the individual files (one per suffix)" },
{ "ndm_setupgroups", "nSamples", "52", "Optional", true,
  "Total waveform window width in samples (default = 52; use 32 at 20 kHz)." },
{ "ndm_setupgroups", "peakSampleIndex", "26", "Optional", true,
  "0-based index of the expected spike peak within the window (default = 26, i.e. midpoint of a 52-sample window)." },
{ "ndm_setupgroups", "nFeatures", "3", "Optional", true,
  "PCA components per channel for ndm_pca / ndm_klustakwik (default = 3)." },
{ "ndm_setupgroups", "probeLibrary", "", "Optional", true,
  "Extra probe library directory. A relative probeFile is looked up in the session directory, SESSION_DIR/probes/, this directory, probeLibraryPath, $NEUROSUITE_PROBE_PATH, then neurosuite/probes/ under the XDG data directories; the first that holds it wins." },
{ "ndm_setupgroups", "overwrite", "false", "Optional", true,
  "If false (default), abort if groups already exist. Set to true to replace them." },
{ "ndm_slicebinary", "slicedChannels", "", "Mandatory", true,
  "Channels to copy, 0-based, in output order. Comma- or whitespace-separated (0,1,4 and 0 1 4 are equivalent). Order is preserved so the list can also reorder, and a channel may be repeated. Only plain integers: the gain (5*1.5) and reference (5-2) spellings process_extractchannels accepts are refused, because a slice must be a byte-exact excerpt. Empty means \"no slice requested\" -- the stage says so and succeeds." },
{ "ndm_slicebinary", "tag", "", "Mandatory", true,
  "Names the output. Letters, digits, - and _ only; a dot, slash or whitespace is refused since the tag is a filename component. Re-running with the same tag is refused because the output exists." },
{ "ndm_slicebinary", "timeRange", "0,600", "Optional", false,
  "Temporal window as start,end in seconds (e.g. 0,600); empty means the whole recording. Half-open [start, end) so adjacent ranges tile exactly, rounded to the nearest sample. Converted with the rate of the STREAM being cut, not the acquisition rate: 2,4 is 2500 records of a 1250 Hz .lfp and 65104 of a 32552 Hz .dat. A window past the end of the file is refused, not clamped." },
{ "ndm_slicebinary", "inputExtension", "lfp", "Optional", false,
  "File to slice, without the leading dot (default lfp). Point it at dat, fil or any externally-processed source to excerpt that instead.\n\nA leading dot is ignored (.lfp = lfp). When set, the file must exist: a missing one stops the step with an error rather than skipping it." },
{ "ndm_smi2sts", "suffix", "", "Mandatory", true,
  "Suffix of the directory where the SMI file is located" },
{ "ndm_smi2sts", "gap", "1", "Optional", false,
  "Sampling gap threshold for 'acquisition restart' detection (seconds, default = 1)." },
{ "ndm_smr2dat", "reverse", "true", "Mandatory", true,
  "Whether the signals should be reversed" },
{ "ndm_smr2dat", "suffixes", "", "Mandatory", true,
  "List of suffixes for the individual files to convert" },
{ "ndm_smr2dat", "channelsExcluded", "", "Mandatory", true,
  "List of channels to exclude for each individual file (type - for none)" },
{ "ndm_smr2evt", "suffixes", "", "Optional", true,
  "List of suffixes for the individual files to convert" },
{ "ndm_smr2evt", "rename", "", "Optional", true,
  "Optional name of a script used to automatically rename events and event files" },
{ "ndm_spikecleaner", "removeFlatChannels", "1", "Optional", true,
  "Also remove waveforms where any channel has zero variance (constant, possibly non-zero) after DC removal (default 1). Set to 0 to detect only all-zero channels." },
{ "ndm_spikecleaner", "dryRun", "0", "Optional", true,
  "Report counts without modifying files (default 0). Useful to assess how many spikes are affected before committing." },
{ "ndm_spikegrouper", "thresholdFactor", "3.0", "Mandatory", true,
  "Spike detection threshold multiplier: threshold = factor * median(|x|)/0.6745. Should match or be slightly lower than ndm_detectspikes > thresholdFactor." },
{ "ndm_spikegrouper", "refractoryMs", "1.0", "Mandatory", true,
  "Minimum time (ms) between two consecutive detections on one channel (default 1.0)." },
{ "ndm_spikegrouper", "coincidenceMs", "0.4", "Mandatory", true,
  "Half-width (ms) of the coincidence window for estimating channel co-activation. 0.4 ms suits 30 kHz recordings (default 0.4)." },
{ "ndm_spikegrouper", "windowSec", "60", "Mandatory", true,
  "Seconds of .fil data used for coincidence estimation (default 60)." },
{ "ndm_spikegrouper", "maxSubGroups", "16", "Mandatory", true,
  "Upper bound on cluster count tested per shank. The silhouette score selects the best k in [1, maxSubGroups]. For high-density probes (64-128 ch/shank) use 16-24; the default of 16 is sufficient for tetrodes." },
{ "ndm_spikegrouper", "minChannels", "4", "Mandatory", true,
  "Minimum channels per group after clustering and merging (default 4)." },
{ "ndm_spikegrouper", "maxMergedSize", "12", "Mandatory", true,
  "Hard upper limit on a merged group's channel count (default 12). Must be >= 2 * minChannels." },
{ "ndm_spikegrouper", "channelOverlap", "0", "Mandatory", true,
  "Channels borrowed from each neighbouring group's boundary (default 0 = disabled). For high-density probes an overlap of 2-4 reduces boundary split artefacts." },
{ "ndm_spikegrouper", "excludeChannels", "", "Optional", false,
  "Comma-separated list of channel indices to exclude from all groups before processing (e.g. broken contacts or reference channels). Default: empty." },
{ "ndm_start", "suffixes", "nlx", "Mandatory", true,
  "List of suffixes for the individual files to convert" },
{ "ndm_start", "log", "false", "Mandatory", true,
  "Save progress information to log files for later review (use 'cat' or 'less -R' for correct formatting, default = false)" },
{ "ndm_start", "wideband", "true", "Optional", false,
  "Process the wideband data files: convert to .dat, resample, merge, extract and reorder channels (default = true)" },
{ "ndm_start", "video", "true", "Optional", false,
  "Process video files: transcode and extract LEDs (default = true)" },
{ "ndm_start", "events", "true", "Optional", false,
  "Process event files: convert to .evt and rename events (default = true)" },
{ "ndm_start", "concatenation", "true", "Optional", false,
  "Concatenate sessions from the same day (default = true)" },
{ "ndm_start", "spikes", "true", "Optional", false,
  "Detect and extract spike waveforms, perform PCA (default = true)" },
{ "ndm_start", "lfp", "true", "Optional", false,
  "Downsample wideband signals to produce LFP files (default = true)" },
{ "ndm_start", "clean", "false", "Optional", false,
  "Remove intermediate files after pre-processing is complete (default = false)" },
{ "ndm_stripdat", "redetectSpikes", "no", "Optional", true,
  "Whether to immediately run a second round of spike detection on the cleaned dat after writing it.\n\nno Write session-spkclean.dat and stop (default). yes Call ndm_redetectspikes: high-pass filters cleaned dat, detects missed spikes, merges into .res.N/.spk.N/.clu.N (new spikes get cluster ID 0), deletes stale .fet.N, removes the cleaned dat. After this, re-run ndm_pca and ndm_klustakwik." },
{ "ndm_stripdat", "stripClusters", "default", "Optional", true,
  "Default cluster list used when no per-group sidecar or autostrip file is found. Accepts:\n\ndefault Strip every cluster except 0 (artefact) and 1 (MUA). all Strip every cluster including 0 and 1. 2,3,5 Comma-separated explicit ID list. - or (empty) Same as default. @/path/to/file Read the list from the file (one ID per line)." },
{ "ndm_stripdat", "overwrite", "false", "Optional", true,
  "If false (default), ndm_stripdat checks whether <session>-spkclean.dat already exists and skips re-running. Stripping a multi-hour recording can take tens of minutes; this guards against accidental re-runs that would clobber a hand-verified result. Set to true to force regeneration." },
{ "ndm_stripdat", "subtractionMode", "raw", "Optional", true,
  "raw | model | botm — see SUBTRACTION MODE above. Default is raw." },
{ "ndm_stripdat", "botmRidge", "1e-3", "Optional", true,
  "Covariance-matrix ridge regularisation used in BOTM mode. Fraction of trace(C)/dim added to the diagonal before inversion. Only read when subtractionMode = botm. Default 1e-3; raise if inversion fails on short recordings or if BOTM residuals look unstable." },
{ "ndm_stripdat", "autoStrip", "true", "Optional", true,
  "Master switch for auto-generation of the per-group <session>.autostrip.<g> sidecar from the session YAML's top-level units: block. When true (default), ndm_stripdat reads every unit's quality: field and emits the cluster IDs whose labels match qualityTags. Auto-generated files are regenerated every run so they stay in sync with the current YAML curation. When false, only explicit <session>.strip.<g> sidecars and the global stripClusters parameter are consulted." },
{ "ndm_stripdat", "qualityTags", "good,great,excellent", "Optional", true,
  "Comma-separated list of quality labels that count as \"strip-worthy\" for autoStrip. Matching is case-insensitive and whitespace-tolerant. Default: good,great,excellent. Labs using a different vocabulary (e.g. SU,single-unit,accepted) configure it here." },
{ "ndm_subcluster_unmatched", "minClusters", "2", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Minimum clusters passed to KlustaKwik -MinClusters (default 2)." },
{ "ndm_subcluster_unmatched", "maxClusters", "100", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Maximum clusters to fit. Tetrodes: 12-20; high-density probes: 50-100 (default 100)." },
{ "ndm_subcluster_unmatched", "maxPossibleClusters", "1000", "Optional", true,
  "The outlier bin can contain dozens of low-SNR units in a single group. Raising the ceiling prevents KlustaKwik from prematurely capping the cluster table." },
{ "ndm_subcluster_unmatched", "nStarts", "5", "Optional", true,
  "Outlier bins have more local minima in the CEM objective; extra starts are cheap here because the bin is smaller than the main spike population." },
{ "ndm_subcluster_unmatched", "nRuns", "0", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Per-chunk CEM restarts when using chunked mode (default 0 = single start per chunk). When nRuns > 0 and chunkMinutes > 0, each chunk independently runs CEMTwoPhase nRuns times with different random seeds and keeps its best-scoring result before handing it to Phase 2 cross-chunk matching. Phase 0 preseed, Phase 1.5 realignment, and Phase 2 each still run only once. This is the per-chunk analogue of nStarts in non-chunked mode. Recommended: 3." },
{ "ndm_subcluster_unmatched", "phase15Iters", "2", "Optional", true,
  "Extra xcorr-realignment iterations sharpen within-cluster structure in the low-SNR regime where PCA features are blurred by the sample-wise noise." },
{ "ndm_subcluster_unmatched", "subspaceDims", "3", "Optional", true,
  "Enables the per-cluster subspace CEM splits described in programs[ndm_klustakwik] help. Main-sort defaults to off (subspaceRecluster: 0) because dense clusters rarely benefit. Outlier bins routinely contain clusters that coalesce in the full 21-D space but separate cleanly in a 3-D subspace, so we turn it on by default with a moderate recursion depth." },
{ "ndm_subcluster_unmatched", "subspaceRecluster", "1", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: 1 (default) re-clusters each cluster in its own feature subspace after Phase 2; 0 skips it." },
{ "ndm_subcluster_unmatched", "subspaceReclusterDepth", "2", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Passed as -SubspaceReclusterDepth (default 2), an option KiloKlustaKwik does not read: it has no effect." },
{ "ndm_subcluster_unmatched", "splitRecurseDepth", "1", "Optional", true,
  "One extra recursive split pass — outlier bins benefit from aggressive splitting that would be too disruptive on the main sort." },
{ "ndm_subcluster_unmatched", "templateMatchScore", "0.85", "Optional", true,
  "Enables within-chunk template matching with a relatively permissive score threshold; helps pull together scattered low-SNR members of the same underlying unit that PCA-Mahalanobis alone can't match. 0.0 (= disabled) is the main-sort default because template matching on dense clusters risks over-merging; the outlier bin is sparse enough for this to be a net win." },
{ "ndm_subcluster_unmatched", "templateMatchIters", "10", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Maximum within-chunk template-merge iterations (default 10)." },
{ "ndm_subcluster_unmatched", "crossChunkTemplateScore", "0.0", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Minimum waveform cross-correlation for matching clusters across chunks by their templates (default 0.0 = off)." },
{ "ndm_subcluster_unmatched", "initMethod", "farthest", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Cluster centre initialisation: \"farthest\" (default) or \"random\"." },
{ "ndm_subcluster_unmatched", "penaltyMix", "0.25", "Optional", true,
  "Slight mix toward AIC over pure BIC. The outlier bin has low per-cluster evidence, so BIC's logN penalty is disproportionately aggressive there; a small AIC mix admits more clusters without drowning in spurious singletons." },
{ "ndm_subcluster_unmatched", "chunkMinutes", "10", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Duration (minutes) of each temporal chunk. 0 disables chunking and uses standard two-phase CEM on the full recording (default 10)." },
{ "ndm_subcluster_unmatched", "chunkOverlapMinutes", "2", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Overlap (minutes) added at each chunk boundary to smooth transitions (default 2)." },
{ "ndm_subcluster_unmatched", "chunkPreseedFraction", "0.05", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Fraction of spikes used in a fast Phase-0 preseed pass to initialise cluster centres before per-chunk CEM; 0 disables preseeding (default 0.05)." },
{ "ndm_subcluster_unmatched", "mergeThresh", "30.0", "Optional", true,
  "Tighter Mahalanobis merge threshold: χ²(21, 0.99) ≈ 38.9 for typical 21-dim features; 30.0 sits below this comfortably and prevents two genuinely distinct low-amplitude units from being collapsed by a loose merge. Main-sort uses 42 to avoid fragmenting dense clusters — the outlier bin has no dense clusters to worry about." },
{ "ndm_subcluster_unmatched", "globalMergeIter", "50", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: EM iterations run on the globally merged model after all chunks are combined (default 50)." },
{ "ndm_subcluster_unmatched", "timeMergeIter", "50", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Phase-2 temporal merge iterations in two-phase CEM mode; 0 disables (default 50)." },
{ "ndm_subcluster_unmatched", "splitEvery", "25", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: CEM iterations between split attempts (default 25)." },
{ "ndm_subcluster_unmatched", "maxIter", "500", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Maximum CEM iterations per chunk (default 500)." },
{ "ndm_subcluster_unmatched", "distThresh", "6.9", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Mahalanobis distance threshold for assigning spikes to clusters (default 6.9)." },
{ "ndm_subcluster_unmatched", "fullStepEvery", "10", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Full E-step recomputed every N iterations; partial steps used otherwise (default 10)." },
{ "ndm_subcluster_unmatched", "changedThresh", "0.05", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Fractional change in cluster assignments below which CEM is considered converged (default 0.05)." },
{ "ndm_subcluster_unmatched", "nThreads", "0", "Optional", true,
  "As for ndm_klustakwik, for the sub-clustering: Number of OpenMP threads passed to KlustaKwik via OMP_NUM_THREADS. KlustaKwik has no -nThreads flag; the value is exported into its environment before launch and unset afterwards so it does not leak to other tools. 0 (default) = use all available cores (nproc). Set explicitly only when you need to leave cores free for other concurrent work." },
{ "ndm_subcluster_unmatched", "method", "standard", "Optional", true,
  "Engine whose files this step reads and writes: standard (default), sdiff or stderiv. Must match the method of the detection / PCA / clustering run it continues; it selects the .<type>.<method>.N names." },
{ "ndm_transcodevideo", "suffix", "", "Mandatory", true,
  "Suffix of the directory where the video files to transcode are located" },
{ "ndm_transcodevideo", "extension", "avi", "Mandatory", true,
  "Extension of the original video file (e.g. avi, mpg)" },
{ "ndm_transcodevideo", "codec", "", "Mandatory", true,
  "Output file codec: x264 (MPEG-4 AVC) or m1v (video-only MPEG-1). Leave empty if no transcoding is required." },
{ "ndm_transcodevideo", "frequency", "30", "Optional", false,
  "Output frame rate in frames per second (default = 30)" },
{ "ndm_tsp2sts", "suffix", "", "Mandatory", true,
  "Suffix of the directory where the TSP and META files are located" },
