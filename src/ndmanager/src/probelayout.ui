  <property name="windowTitle"><string>Probes</string></property>
  <layout class="QVBoxLayout" name="mainLayout" stretch="1,0,0">

   <!-- Top: probe table + diagram side-by-side -->
   <item>
    <layout class="QHBoxLayout" name="topLayout" stretch="3,1">

     <!-- Left: probe table -->
     <item>
      <widget class="QGroupBox" name="probeGroupBox">
       <property name="title"><string>Implanted Probes</string></property>
       <layout class="QVBoxLayout" name="probeGroupLayout">
        <item>
         <widget class="QTableWidget" name="probeTable">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch><verstretch>1</verstretch>
           </sizepolicy>
          </property>
          <property name="editTriggers">
           <set>QAbstractItemView::AnyKeyPressed|QAbstractItemView::CurrentChanged|QAbstractItemView::EditKeyPressed</set>
          </property>
          <property name="selectionBehavior">
           <enum>QAbstractItemView::SelectRows</enum>
          </property>
          <property name="selectionMode">
           <enum>QAbstractItemView::SingleSelection</enum>
          </property>
          <property name="columnCount"><number>6</number></property>
          <attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute>
          <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
          <column><property name="text"><string>ID</string></property></column>
          <column><property name="text"><string>Probe File</string></property></column>
          <column><property name="text"><string>Label</string></property></column>
          <column><property name="text"><string>Ch. Offset</string></property></column>
          <column><property name="text"><string>Anat. Groups</string></property></column>
          <column><property name="text"><string>Spike Groups</string></property></column>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="buttonLayout">
          <item>
           <widget class="QPushButton" name="addProbeButton">
            <property name="text"><string>Add Probe</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="removeProbeButton">
            <property name="text"><string>Remove Probe</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="browseProbeButton">
            <property name="text"><string>Browse Library…</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="moveUpButton">
            <property name="text"><string>↑</string></property>
            <property name="maximumWidth"><number>32</number></property>
            <property name="toolTip"><string>Move selected probe up</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="moveDownButton">
            <property name="text"><string>↓</string></property>
            <property name="maximumWidth"><number>32</number></property>
            <property name="toolTip"><string>Move selected probe down</string></property>
           </widget>
          </item>
          <item>
           <spacer name="buttonSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>

     <!-- Right: probe diagram placeholder -->
     <item>
      <widget class="QGroupBox" name="diagramGroupBox">
       <property name="title"><string>Probe Diagram</string></property>
       <layout class="QVBoxLayout" name="diagramLayout">
        <item>
         <widget class="QLabel" name="diagramLabel">
