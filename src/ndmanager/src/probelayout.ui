    <widget class="QLabel" name="hintLabel">
     <property name="text">
      <string>Anat. Groups and Spike Groups accept comma-separated 1-based IDs (e.g. "1, 2, 3, 4").  Spike Groups defaults to the same IDs as Anat. Groups when left empty.</string>
