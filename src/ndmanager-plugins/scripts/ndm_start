#!/bin/bash
# /////////////////////////////////////////////////////////////////////////////////////////////////
# // ndm_start — pipeline orchestrator (YAML-driven)
# /////////////////////////////////////////////////////////////////////////////////////////////////
#
# Reads a list of pipeline plugins from `programs:` in the session YAML and
# dispatches each in graph order.  The first program is expected to be the
# `ndm_start` orchestrator entry itself, which carries the legacy flag set
# (wideband/events/video/concatenation/spikes/lfp/clean) for backward-
# compat fallback to the old hard-coded dispatch path.
#
# Two execution phases are run for each session directory:
#
#     PER-SESSION  — plugins that operate on individual session files
#                    inside a directory (wideband detection, events, video)
#     PER-DIRECTORY — plugins that operate on the directory as a whole
#                    after per-session work is done (concatenation,
#                    spikes, sorting, LFP, post-processing, cleanup)
#
# Per-session plugin types are listed in PER_SESSION_PLUGINS below; everything
# else is per-directory.  This split was implicit in the old bash; making it
# data-driven by classification keeps the single-script-per-node graph
# convention while preserving existing behaviour.
#
# Backward compat: if `programs[0]` is not `ndm_start`, this script falls
# through to the legacy flag-driven dispatch (do_sessions/do_concatenation/
# do_spikes/do_lfp/do_clean) so existing session YAMLs continue to work
# without any graph data.
# /////////////////////////////////////////////////////////////////////////////////////////////////

# /////////////////////////////////////////////////////////////////////////////////////////////////
# // Setup
# /////////////////////////////////////////////////////////////////////////////////////////////////

program=`basename $0`
. ndm_functions

# Set program help message
help_message="
Usage:
    $program [parameter_file] [session1 session2 ...]

Description:
    Pipeline orchestrator.  Reads the program list from the session YAML
    and dispatches each plugin in order.  When the first program is
    ndm_start, its parameter block holds the orchestration flags (used as
    a fallback if no graph data is present).
"

# Help requested?
[ -n "$1" ] && [ "$1" = "-h" ] && echo "$help_message" && exit $NO_ERROR

# Parameter file
if [ $# -eq 0 ]
then
	template=`basename $(pwd)`
else
	template=`basename $1 .xml`
	template=`basename $template .yaml`
	template=`basename $template .yml`
	shift
fi

# Determine extension (.yaml, .yml or .xml)
if [ -f "$template.yaml" ]; then
	param_ext="yaml"
elif [ -f "$template.yml" ]; then
	param_ext="yml"
elif [ -f "$template.xml" ]; then
	param_ext="xml"
else
	echo_error "no parameter file found for template '$template' (.yaml, .yml, or .xml)"
	exit $INPUTS_MISSING
fi
template_file="$template.$param_ext"

# Check required files
inputs_missing "$template_file" && exit $INPUTS_MISSING

# /////////////////////////////////////////////////////////////////////////////////////////////////
# // Read orchestration flags (legacy fallback path)
# /////////////////////////////////////////////////////////////////////////////////////////////////

# Brain signals, video and events
wideband=$(read_script_parameter $template wideband)
check_optional_variable $wideband || wideband=true
video=$(read_script_parameter $template video)
check_optional_variable $video || video=true
events=$(read_script_parameter $template events)
check_optional_variable $events || events=true

# Suffixes
suffixes=($(read_script_parameter $template suffixes))
if $wideband || $events
then
	check_mandatory_variable ${suffixes[0]} "missing suffixes"
fi

# Concatenation, spikes and LFPs
concatenation=$(read_script_parameter $template concatenation)
check_optional_variable $concatenation || concatenation=true
spikes=$(read_script_parameter $template spikes)
check_optional_variable $spikes || spikes=true
lfp=$(read_script_parameter $template lfp)
check_optional_variable $lfp || lfp=true

# Cleaning of intermediate files
clean=$(read_script_parameter $template clean)
check_optional_variable $clean || clean=false

# Logging
log=$(read_script_parameter $template log)
check_optional_variable $log || log=true

# Make sure spike groups have been defined when spike-related work might run
if $spikes
then
	nGroups=$(yaml_count $template "//spikeDetection/channelGroups/group")
	if [ $nGroups -eq 0 ]
	then
		# Don't hard-fail here — the graph may not include any spike-related
		# nodes.  We re-check at dispatch time per-plugin.
		echo_warning "no spike groups defined; spike-related plugins will be skipped"
	fi
fi

# /////////////////////////////////////////////////////////////////////////////////////////////////
# // YAML-driven plugin discovery
# /////////////////////////////////////////////////////////////////////////////////////////////////

# Plugins that run inside the session loop, against individual session files,
# rather than once per directory.  Keep this list aligned with how the legacy
# do_sessions block invoked these.
PER_SESSION_PLUGINS=(
	ndm_ncs2dat
	ndm_smr2dat
	ndm_aom2dat
	ndm_smr2evt
	ndm_nev2evt
	ndm_extractleds
	ndm_transcodevideo
	ndm_extractchannels
	ndm_mergedat
	ndm_resample
)

is_per_session_plugin()
{
	local plugin=$1
	local p
	for p in "${PER_SESSION_PLUGINS[@]}"
	do
		[ "$plugin" = "$p" ] && return 0
	done
	return 1
}

# read_pipeline_file — extract plugin names (in order) from a
# `<session>.ndm.<name>.pipeline` file produced by ndmanager's
# Pipeline Designer.  Schema is documented in
# src/ndmanager/src/pipelinedesignerpage.cpp.  Outputs one plugin
# name per line on stdout, in topological order, skipping ndm_start
# itself.
read_pipeline_file()
{
	local pipefile="$1"
	[ -f "$pipefile" ] || return 1
	python3 - "$pipefile" << 'PYEOF' 2>/dev/null
import sys, yaml
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f) or {}
except Exception:
    sys.exit(0)
nodes = doc.get('nodes', []) or []
edges = doc.get('edges', []) or []
# Topological sort: build adjacency, run Kahn's algorithm.
node_by_id = {}
node_enabled = {}
indeg = {}
adj = {}
for n in nodes:
    if not isinstance(n, dict): continue
    nid = n.get('id', '')
    typ = n.get('type', '')
    if not nid: continue
    node_by_id[nid] = typ
    # Disabled nodes still participate in topology (so the order is
    # deterministic) but are filtered out before printing.  ndm_start is
    # never disable-able.
    node_enabled[nid] = bool(n.get('enabled', True))
    indeg.setdefault(nid, 0)
    adj.setdefault(nid, [])
for e in edges:
    if not isinstance(e, dict): continue
    a, b = e.get('from'), e.get('to')
    if a in node_by_id and b in node_by_id:
        adj[a].append(b)
        indeg[b] = indeg.get(b, 0) + 1
# Kahn's: queue of indeg-0 nodes, in YAML insertion order.
queue = [nid for nid in node_by_id if indeg.get(nid, 0) == 0]
emitted = []
while queue:
    nid = queue.pop(0)
    typ = node_by_id[nid]
    if node_enabled.get(nid, True) or typ == 'ndm_start':
        emitted.append(typ)
    for nxt in adj.get(nid, []):
        indeg[nxt] -= 1
        if indeg[nxt] == 0:
            queue.append(nxt)
# Drop ndm_start (orchestrator entry — never dispatched by itself).
for t in emitted:
    if t and t != 'ndm_start':
        print(t)
PYEOF
}

# read_program_list — extract the names of plugins from the YAML's
# programs: list, in order, skipping ndm_start itself (the orchestrator
# entry doesn't dispatch itself).  Returns one plugin name per line on
# stdout.  Empty output if no programs: list or only ndm_start present.
read_program_list()
{
	local file="$1.$param_ext"
	if [ "$param_ext" = "xml" ]
	then
		# XML schema: <programs><program><name>X</name>...
		python3 - "$file" << 'PYEOF' 2>/dev/null
import sys, xml.etree.ElementTree as ET
try:
    tree = ET.parse(sys.argv[1])
except Exception:
    sys.exit(0)
root = tree.getroot()
for prog in root.iter('program'):
    nm = prog.find('name')
    if nm is None:
        nm = prog.find('n')
    if nm is None or nm.text is None:
        continue
    name = nm.text.strip()
    if name and name != 'ndm_start':
        print(name)
PYEOF
	else
		python3 - "$file" << 'PYEOF' 2>/dev/null
import sys, yaml
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f)
except Exception:
    sys.exit(0)
programs = (doc or {}).get('programs', []) or []
for p in programs:
    if not isinstance(p, dict):
        continue
    name = p.get('name', '')
    if not isinstance(name, str):
        continue
    name = name.strip()
    if name and name != 'ndm_start':
        print(name)
PYEOF
	fi
}

# Test whether the program list begins with ndm_start.  When false, the
# YAML pre-dates the graph design and we fall through to the legacy path.
graph_has_root()
{
	local file="$1.$param_ext"
	if [ "$param_ext" = "xml" ]
	then
		python3 - "$file" << 'PYEOF' 2>/dev/null
import sys, xml.etree.ElementTree as ET
try:
    tree = ET.parse(sys.argv[1])
except Exception:
    sys.exit(1)
root = tree.getroot()
for prog in root.iter('program'):
    nm = prog.find('name')
    if nm is None:
        nm = prog.find('n')
    if nm is not None and nm.text and nm.text.strip() == 'ndm_start':
        sys.exit(0)
sys.exit(1)
PYEOF
	else
		python3 - "$file" << 'PYEOF' 2>/dev/null
import sys, yaml
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f)
except Exception:
    sys.exit(1)
programs = (doc or {}).get('programs', []) or []
if not programs:
    sys.exit(1)
first = programs[0]
if isinstance(first, dict) and str(first.get('name', '')).strip() == 'ndm_start':
    sys.exit(0)
sys.exit(1)
PYEOF
	fi
	return $?
}

# /////////////////////////////////////////////////////////////////////////////////////////////////
# // Legacy do_* helpers (used by the fallback path AND by graph dispatch
# // when the corresponding flag-named plugin isn't on the graph but the
# // user wants the wide-band shortcut)
# /////////////////////////////////////////////////////////////////////////////////////////////////

do_wideband()
{
	$wideband || return
	local i
	for ((i=0; i<${#suffixes[@]}; i++))
	do
		local suffix=$(get_suffix $i ${suffixes[*]})
		local session=$(basename `pwd`)-$suffix
		[ ! -f "$session.dat" ] && continue
		ndm_resample $session
		step_completed ndm_resample || return
	done
	ndm_mergedat $(basename `pwd`)
	step_completed ndm_mergedat || return
	ndm_extractchannels $(basename `pwd`)
	step_completed ndm_extractchannels || return
}

do_events()
{
	$events || return
	local i
	for ((i=0; i<${#suffixes[@]}; i++))
	do
		local suffix=$(get_suffix $i ${suffixes[*]})
		local session=$(basename `pwd`)-$suffix
		[ ! -f "$session.smr" ] && [ ! -f "$session.nev" ] && continue
		if [ -f "$session.smr" ]; then
			ndm_smr2evt $session
			step_completed ndm_smr2evt || return
		fi
		if [ -f "$session.nev" ]; then
			ndm_nev2evt $session
			step_completed ndm_nev2evt || return
		fi
	done
}

do_video()
{
	$video || return
	ndm_transcodevideo $(basename `pwd`)
	step_completed ndm_transcodevideo || return
	ndm_extractleds $(basename `pwd`)
	step_completed ndm_extractleds || return
}

do_sessions()
{
	# Process each set of session files (legacy per-session phase)
	for session in $(list_sessions $directory ${suffixes[*]})
	do
		# Copy parameter template to session file
		local session_file="$session.$param_ext"
		local dir_file="$directory.$param_ext"
		if [ -f "$session_file" ]
		then
			if ! diff -q "$dir_file" "$session_file" >/dev/null
			then
				echo_warning "'$session_file' was modified since last batch processing"
				cp -i "$dir_file" "$session_file"
			fi
		else
			cp "$dir_file" "$session_file"
		fi
		do_wideband
		do_events
		do_video
	done
}

do_concatenation()
{
	$concatenation || return
	n_wideband_files=$(ls *dat 2>/dev/null | grep -v $directory.dat | wc -l)
	[ $n_wideband_files -lt 1 ] && return
	print_header "$directory - Concatenating data files"
	ndm_concatenate $directory
	step_completed ndm_concatenate || return
}

do_spikes()
{
	$spikes || return
	ndm_hipass $directory
	step_completed ndm_hipass || return
	ndm_detectspikes $directory
	step_completed ndm_detectspikes || return
	ndm_extractspikes $directory
	step_completed ndm_extractspikes || return
	ndm_pca $directory
	step_completed ndm_pca || return
}

do_lfp()
{
	$lfp || return
	ndm_lfp $directory
	step_completed ndm_lfp || return
}

do_clean()
{
	$clean || return
	ndm_clean $directory
	step_completed ndm_clean || return
}

# /////////////////////////////////////////////////////////////////////////////////////////////////
# // Graph-driven dispatcher
# /////////////////////////////////////////////////////////////////////////////////////////////////

# dispatch_graph_per_session — runs all per-session plugins in graph order
# against the current $session inside the directory loop.
dispatch_graph_per_session()
{
	local plugin
	for plugin in "${GRAPH_PLUGINS[@]}"
	do
		is_per_session_plugin "$plugin" || continue
		# Skip plugins whose inputs aren't present rather than failing the
		# whole pipeline; individual plugins also self-report via
		# inputs_missing.
		"$plugin" $session
		step_completed "$plugin" || {
			echo_warning "'$plugin' failed for session '$session'; continuing"
		}
	done
}

# dispatch_graph_per_directory — runs all per-directory plugins in graph
# order against the current $directory.
dispatch_graph_per_directory()
{
	local plugin
	for plugin in "${GRAPH_PLUGINS[@]}"
	do
		is_per_session_plugin "$plugin" && continue
		# Resolve plugin via PATH; if not found, warn and continue rather
		# than fail-out.  Common case: a stale graph references a renamed
		# or external plugin.
		if ! command -v "$plugin" >/dev/null 2>&1
		then
			echo_warning "plugin '$plugin' not found on PATH; skipping"
			continue
		fi
		"$plugin" $directory
		step_completed "$plugin" || {
			echo_warning "'$plugin' failed for '$directory'; continuing"
		}
	done
}

# /////////////////////////////////////////////////////////////////////////////////////////////////
# // Start
# /////////////////////////////////////////////////////////////////////////////////////////////////

# List of directories
suffix=$(get_suffix 0 ${suffixes[*]})
explicit_list=false
if [ $# -eq 0 ]
then
	if [ -z "$suffix" ]
	then
		echo_error "no suffix defined in parameter file — cannot auto-discover session directories"
		exit $GENERAL_ERROR
	fi
	directories=$(ls -d *-$suffix 2>/dev/null | sed 's/-'$suffix'$//' | sort | uniq)
	if [ -z "$directories" ]
	then
		echo_error "no session directories found matching '*-$suffix' in $(pwd)"
		echo_info "  template: $template_file"
		echo_info "  suffix:   $suffix"
		echo_info "  Tip: run $program from the parent directory that contains the session dirs,"
		echo_info "       or pass directory names explicitly: $program $template_file dir1 dir2 ..."
		exit $GENERAL_ERROR
	fi
else
	directories=$*
	explicit_list=true
fi

# Decide once at top which dispatch source to use.  Priority:
#   1. `<template>.ndm.<NDM_PIPELINE>.pipeline`  if env var is set
#      (lets a CI runner choose between named variants without
#      touching files)
#   2. `<template>.ndm.default.pipeline`         the standard
#      auto-loaded pipeline file produced by ndmanager
#   3. YAML `programs:` block with ndm_start at position 0
#      (legacy in-YAML pipeline form, kept for backward compat)
#   4. Fall through to flag-driven legacy mode (no graph at all)
USE_GRAPH=false
GRAPH_SOURCE=""
GRAPH_PLUGINS=()

# Resolve a candidate pipeline file path.
pipeline_default="$template.ndm.${NDM_PIPELINE:-default}.pipeline"

if [ -f "$pipeline_default" ]
then
	# Named-pipeline mode.  Plugin order comes from the topological
	# sort of the .pipeline file's nodes/edges, not from the YAML.
	while IFS= read -r line
	do
		[ -n "$line" ] && GRAPH_PLUGINS+=("$line")
	done < <(read_pipeline_file "$pipeline_default")
	if [ ${#GRAPH_PLUGINS[@]} -gt 0 ]
	then
		USE_GRAPH=true
		GRAPH_SOURCE="$pipeline_default"
		echo_info "ndm_start: pipeline file '$pipeline_default' (${#GRAPH_PLUGINS[@]} plugin(s))"
	else
		echo_warning "pipeline file '$pipeline_default' parsed empty; falling back to YAML"
	fi
fi

if ! $USE_GRAPH && graph_has_root "$template"
then
	USE_GRAPH=true
	GRAPH_SOURCE="programs: block"
	while IFS= read -r line
	do
		[ -n "$line" ] && GRAPH_PLUGINS+=("$line")
	done < <(read_program_list "$template")
	echo_info "ndm_start: in-YAML graph mode (${#GRAPH_PLUGINS[@]} plugin(s) in programs:)"
fi

if ! $USE_GRAPH
then
	echo_info "ndm_start: legacy flag mode (no ndm_start node in programs:)"
fi

# Loop over directories
for directory in $directories
do
	if $log
	then
		# Redirect outputs to log file
		NDM_LOG=$directory-$(date +%Y-%m-%d-%H:%M:%S).log
		exec 1> >(tee -a $NDM_LOG) 2>&1
	fi
	print_header "$directory" "*" "$BOLD_BLACK"
	if [ -f $directory ]
	then
		# Skip files
		echo_warning "'$directory' is a file: skipping..."
	else
		# Create target directory, copy template and cd there
		[ ! -d $directory ] && mkdir $directory
		cp "$template_file" "$directory/$template_file"
		cd $directory
		# Update date field (syntax depends on file format)
		d=$(format_date $(dirname_part date $directory))
		if [ -z "$d" ]
		then
			echo_warning "directory name '$directory' does not seem to contain a date"
		else
			if [ "$param_ext" = "xml" ]; then
				sed -i 's/<date>.*<\/date>/<date>'$d'<\/date>/' "$template_file"
			else
				# YAML: replace "  date: <value>" under generalInfo
				sed -i 's/^\(  date: \).*/\1'$d'/' "$template_file"
			fi
		fi
		dir_file="$directory.$param_ext"
		if [ -f "$dir_file" ]; then
			if [ "$param_ext" = "xml" ]; then
				diff_flag='-I <date>'
			else
				diff_flag='-I "  date: "'
			fi
			if ! diff $diff_flag -q "$template_file" "$dir_file" >/dev/null; then
				echo_warning "'$dir_file' was modified since last batch processing"
				mv -i "$template_file" "$dir_file"
			else
				mv "$template_file" "$dir_file"
			fi
		else
			mv "$template_file" "$dir_file"
		fi
		# Process — graph mode dispatches the YAML's program list; legacy
		# mode dispatches the hard-coded do_* sequence using the orchestration
		# flags above.
		if $USE_GRAPH
		then
			# Per-session phase (dispatch graph plugins classified as per-session)
			for session in $(list_sessions $directory ${suffixes[*]})
			do
				local_session_file="$session.$param_ext"
				dir_file="$directory.$param_ext"
				if [ -f "$local_session_file" ]
				then
					if ! diff -q "$dir_file" "$local_session_file" >/dev/null
					then
						echo_warning "'$local_session_file' was modified since last batch processing"
						cp -i "$dir_file" "$local_session_file"
					fi
				else
					cp "$dir_file" "$local_session_file"
				fi
				dispatch_graph_per_session
			done
			# Per-directory phase
			dispatch_graph_per_directory
		else
			# Legacy fallback
			do_sessions
			do_concatenation
			do_spikes
			do_lfp
			do_clean
		fi
		cd ..
	fi
done
