#!/bin/bash

#////////////////////////////////////////////////////////////////////////////
#//
#//   Align spike waveform snippets to their true energy peak before PCA.
#//
#//   PURPOSE
#//   ───────
#//   The spike detector fires a threshold crossing at sample T.  The
#//   extracted snippet is centred at T, but the true waveform peak may
#//   sit at T±δ samples (δ ≤ maxShift) due to threshold noise and
#//   waveform variability.  When δ varies across spikes of the same
#//   neuron the PCA sees multiple shifted copies as distinct clouds,
#//   inflating feature-space bimodality and causing KlustaKwik to split
#//   one unit into 2-3 clusters.
#//
#//   This script re-extracts each spike snippet from the raw .fil at the
#//   true peak position (extTs = originalTs + δ), writes the updated .spk.N
#//   (or .spkD.N for stderiv pipelines), updates .res.N so .res[i] = extTs[i]
#//   (preserving the .res ↔ .spk peak invariant required by Klusters' nudge
#//   and by any tool that re-reads .fil at .res offsets), and deletes the
#//   stale .fet.N / .pca.N so the caller must re-run ndm_pca / ndm_pca_stderiv.
#//
#//   The pre-alignment .res.N is archived to .res.N.prealign so the
#//   original detection-threshold timestamps can be recovered if needed.
#//
#//   PIPELINE POSITION
#//   ─────────────────
#//   ndm_extractspikes  (or _stderiv)
#//           ↓
#//   ndm_alignspikes          ← this script
#//           ↓
#//   ndm_pca  (or _stderiv)   ← must re-run after alignment
#//           ↓
#//   ndm_klustakwik
#//
#//   PARAMETERS (set in session YAML under program: ndm_alignspikes)
#//   ──────────────────────────────────────────────────────────────────
#//   maxShift     Maximum shift in samples [default: 3]
#//                Corresponds to MaxTimeShift in KlustaKwikExp.  Values
#//                larger than 5 risk merging spikes from different neurons.
#//   minScore     Minimum relative energy score [0,1] to accept a shift.
#//                Spikes where the peak is diffuse (score < minScore) are
#//                left unshifted.  [default: 0.0]
#//   topChannels  Use only the N highest-amplitude channels per spike when
#//                computing the energy.  Excludes collision/residual
#//                activity on non-primary channels.  [default: 0 = all]
#//   alignSigma   Std (in samples) of a stationary Gaussian template
#//                circular-xcorr'd against the per-spike energy over the
#//                FULL nSamples window.  When > 0, replaces the legacy
#//                bounded-argmax discovery and operates on the existing
#//                .spk.N / .spkD.N snippets (no .fil read for discovery).
#//                σ ≳ 1.5 bridges the bimodal energy of .spkD waveforms.
#//                ≤ 0 falls back to the legacy bounded-argmax path.
#//                [default: 0.0]
#//
#//   copyright       (C) 2026  Gravios / NeuroSuite-3 contributors
#//   GNU GPL v3 or later.
#//
#////////////////////////////////////////////////////////////////////////////

source ndm_functions

program=$(basename $0)
ndm_parse_method "$@"; set -- "${NDM_ARGS[@]}"
if [ $# -gt 1 ]; then
    echo_error "usage: $program [parameter-file] [--method standard|sdiff|stderiv|stderiv_S<order>|stderiv_C<order>]"
    exit $GENERAL_ERROR
fi
ndm_resolve_session "$@"
[ "$NDM_SHIFTED" = 0 ] && set -- "$session" "$@"
param_ext=$(param_file_ext "$session")
method=${NDM_METHOD:-$(read_script_parameter $session method)}; method=${method:-standard}
# Vet the token so a typo is reported as such instead of surfacing later as a
# missing artifact for a method that was never valid.
ndm_check_method_token "$method" || { echo_error "$NDM_M_ERROR"; exit $GENERAL_ERROR; }

print_header "$session - Spike waveform alignment (pre-PCA)"

check_commands_installed process_alignspikes

inputs_missing "$session.$param_ext" "$session.fil" && exit $INPUTS_MISSING

# ── Session-level parameters ──────────────────────────────────────────────

nChannels=$(yaml_read $session "//acquisitionSystem/nChannels")
nElectrodeGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")

check_mandatory_variable $nChannels       "missing total channel count"
check_mandatory_variable $nElectrodeGroups "missing electrode groups"

# Script-specific parameters from YAML
maxShift=$(read_script_parameter $session maxShift)
minScore=$(read_script_parameter $session minScore)
topChannels=$(read_script_parameter $session topChannels)
alignSigma=$(read_script_parameter $session alignSigma)

maxShift=${maxShift:-3}
minScore=${minScore:-0.0}
topChannels=${topChannels:-0}
alignSigma=${alignSigma:-0.0}

echo_info "Alignment parameters:"
echo_info "  maxShift     = $maxShift samples"
echo_info "  minScore     = $minScore"
echo_info "  topChannels  = $topChannels  (0 = use all channels)"
echo_info "  alignSigma   = $alignSigma   (0 = legacy bounded-argmax; >0 = circular xcorr)"

# ── Per-group alignment ───────────────────────────────────────────────────

nAligned=0
nSkipped=0

for group in $(seq 1 $nElectrodeGroups); do

    # Read group geometry
    electrodes=$(yaml_read $session \
        "//spikeDetection/channelGroups/group[$group]/channels/channel")
    nSamples=$(yaml_read $session \
        "//spikeDetection/channelGroups/group[$group]/nSamples")
    peakIdx=$(yaml_read $session \
        "//spikeDetection/channelGroups/group[$group]/peakSampleIndex")

    check_mandatory_variable $electrodes "missing electrode list for group $group"
    check_mandatory_variable $nSamples   "missing nSamples for group $group"
    check_mandatory_variable $peakIdx    "missing peakSampleIndex for group $group"

    # Convert space-separated electrode list to comma-separated for -c
    chanList=$(echo $electrodes | sed 's/ /,/g')

    # Resolve the shared waveform / timestamp files (fall back to the existing
    # copy when no method-tagged one exists).
    spkFile=$(ndm_resolve_shared "$session" spk "$group" "$method")
    if [ ! -f "$spkFile" ]; then
        echo_warning "  group $group: no .spk for group $group (method $method) — skipping"
        nSkipped=$((nSkipped + 1))
        continue
    fi

    # Spike times are METHOD-INDEPENDENT: one physical .res serves every method, so
    # resolve it across all of them (ndm_resolve_any), exactly as ndm_extractspikes
    # does.  ndm_resolve_shared only tries method -> standard -> untagged, so a .res
    # written under a different token (detection at stderiv, alignment asked for
    # stderiv_C5) was reported missing when it was right there.
    resFile=$(ndm_resolve_any "$session" res "$group" "$method")
    if [ -z "$resFile" ] || [ ! -f "$resFile" ]; then
        echo_warning "  group $group: no .res for group $group (any method) — skipping"
        nSkipped=$((nSkipped + 1))
        continue
    fi

    # A custom-pattern method must re-extract with the SAME spatial operator the
    # .spk was built with, so hand the group's own sdiffPairs to the aligner.
    sdiffArg=
    if [ "$NDM_M_KIND" = C ]; then
        pat=$(yaml_read $session "//spikeDetection/channelGroups/group[$group]/sdiffPairs")
        if [ -z "$pat" ]; then
            echo_warning "  group $group: method $method needs sdiffPairs, none defined — skipping"
            nSkipped=$((nSkipped + 1))
            continue
        fi
        sdiffArg="-P $pat"
    fi

    echo_info "  aligning group $group  (${nSamples}s × $(echo $electrodes | wc -w)ch" \
        "peak=$peakIdx maxShift=$maxShift)"

    process_alignspikes \
        -n "$nChannels" \
        -c "$chanList" \
        -w "$nSamples" \
        -p "$peakIdx" \
        -m "$maxShift" \
        --min-score "$minScore" \
        --top-channels "$topChannels" \
        --align-sigma "$alignSigma" \
        --method "$method" \
        $sdiffArg \
        -v \
        "$session" "$group"

    pa_status=$?
    if [ $pa_status -ne 0 ]; then
        echo_error "  group $group: process_alignspikes failed (status $pa_status)"
        exit $GENERAL_ERROR
    fi

    # Archive stale feature and PCA basis files so ndm_pca re-computes from
    # scratch (chain-of-custody: .fet.<method>.N / .pca.<method>.N).
    for ext in fet pca; do
        f=$(ndm_method_path "$session" "$ext" "$group" "$method")
        if [ -f "$f" ]; then
            mv "$f" "${f}.prealign"
            echo_info "  group $group: moved $f → ${f}.prealign (re-run ndm_pca)"
        fi
    done

    nAligned=$((nAligned + 1))
done

# ── Summary ───────────────────────────────────────────────────────────────

echo_info ""
echo_info "Done — $nAligned group(s) aligned  ($nSkipped skipped)"
if [ $nAligned -gt 0 ]; then
    echo_info ""
    echo_info "IMPORTANT: re-run ndm_pca (or ndm_pca_stderiv) before sorting:"
    echo_info "  ndm_pca $session"
    echo_info ""
    echo_info "Stale .fet/.pca files renamed to .prealign for recovery."
fi
