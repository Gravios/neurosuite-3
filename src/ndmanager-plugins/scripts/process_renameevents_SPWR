# Source helper functions
source ndm_functions

# Parse command-line
program=$(basename $0)
if [ $# -ne 1 ]
then
	echo_error "usage: $program xml-file"
	exit $GENERAL_ERROR
fi
session=${1%.xml}

# Transform arcane codes into human-readable event messages
[ -z "$(ls $session*evt 2> /dev/null)" ] && exit $NO_ERROR
tab=$'\t'   # BSD sed reads \t in a replacement as 't'
for eventfile in $session*evt
do
	sed -i.ndmbak \
		-e 's/[[:space:]]0$/'"$tab"'Stimulation/' \
		-e 's/[[:space:]]1$/'"$tab"'Ripple Left/' \
		-e 's/[[:space:]]2$/'"$tab"'Ripple Right/' \
		-e 's/[[:space:]]3$/'"$tab"'Disable Stim/' \
		-e 's/[[:space:]]4$/'"$tab"'Enable Stim/' \
		-e 's/[[:space:]]66$/'"$tab"'Block Stim/' \
		-e 's/[[:space:]]82$/'"$tab"'Unblock Stim/' \
		$eventfile
	rm -f $eventfile.ndmbak
done

# Rename event files
# (Perl's "rename" is not on macOS, and is another program on some Linux
# distributions; the same substitutions with sed and mv.)
for eventfile in $session*evt
do
	renamed=$(echo "$eventfile" | sed 's/e30/bck/;s/e31/kil/;s/e35/stm/;s/-red//')
	if [ "$renamed" != "$eventfile" ]; then mv -f "$eventfile" "$renamed"; fi
done
