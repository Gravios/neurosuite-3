#//   email           lynn.hazan@myrealbox.com
#//                   michael.zugaro@college-de-france.fr
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////
#
#  Computes PCA features for spike sorting.  The detection `method` selects the
#  input waveform domain and the basis treatment, and is stamped onto the
#  outputs (chain-of-custody):
#
#    standard  PCA on raw .spk.standard.N        -> .fet.standard.N / .pca.standard.N
#    sdiff     PCA on raw .spk.sdiff.N           -> .fet.sdiff.N    / .pca.sdiff.N
#    stderiv   PCA on stderiv-domain .spk.stderiv.N (channel-reduced for
#              methodOrder 1/3) -> .fet.stderiv.N / .pca.stderiv.N
#
#  For stderiv the .spk already holds the transformed waveform (written by the
#  extractor), so process_pca_stderiv only performs the channel reduction
#  (drops the linearly-dependent channel for orders 1 and 3) before PCA.
#
#  PARAMETERS (YAML, under program node ndm_pca)
#    method       standard | sdiff | stderiv   (default standard)
#    methodOrder  spatial derivative order, 0-3 (default 3; stderiv only).
#                 Accepts the deprecated alias `sdiffOrder`.
#  plus the usual nFeatures / peakSampleIndex / before / after / extra /
#  excludeClusters / threadsPerGroup.
#
#  CLI: ndm_pca [parameter-file] [electrodeGroup] [--method M] [--methodOrder N]
#               [-- process_pca flags ...]
#       CLI --method/--methodOrder override YAML.
#
#////////////////////////////////////////////////////////////////////////////

# Source helper functions
source ndm_functions

# Parse command-line
program=$(basename $0)

# patch56 — accept process_pca flags after positional args.  Pattern:
#   ndm_pca session 8 --varimax
#   ndm_pca session 8 --varimax --varimax-max-iter 50
#   ndm_pca session 8 -- --varimax        # explicit separator
# --method / --methodOrder are intercepted here (not forwarded to process_pca).
positionals=()
extra_args=()
methodOverride=
methodOrderOverride=
collect_positional=true
while [ $# -gt 0 ]; do
	case "$1" in
		--method)         methodOverride="$2";          shift 2 ;;
		--method=*)       methodOverride="${1#*=}";      shift ;;
		--methodOrder)    methodOrderOverride="$2";      shift 2 ;;
		--methodOrder=*)  methodOrderOverride="${1#*=}"; shift ;;
		--)
			collect_positional=false
			shift
			;;
		-*)
			collect_positional=false
			extra_args+=("$1")
			shift
			;;
		*)
			if $collect_positional; then
				positionals+=("$1")
			else
				extra_args+=("$1")
			fi
			shift
			;;
	esac
done
if [ ${#positionals[@]} -gt 2 ]; then
	echo_error "usage: $program [parameter-file] [electrodeGroup] [--method M] [--methodOrder N] [-- process_pca flags ...]"
	exit $GENERAL_ERROR
fi
ndm_resolve_session "${positionals[@]}"
[ "$NDM_SHIFTED" = 0 ] && positionals=("$session" "${positionals[@]}")
param_ext=$(param_file_ext "$session")
electrodeGroup=${positionals[1]:-}

# ── Resolve method + methodOrder (CLI override > YAML > default) ──────────────
method=$methodOverride
[ -z "$method" ] && method=$(read_script_parameter $session method)
method=${method:-standard}
ndm_check_method_token "$method" || { echo_error "$NDM_M_ERROR"; exit $GENERAL_ERROR; }
methodFamily=$NDM_M_FAMILY
methodOrder=$methodOrderOverride
[ -z "$methodOrder" ] && methodOrder=$(read_script_parameter $session methodOrder sdiffOrder)
methodOrder=${methodOrder:-3}
# A suffixed token states the order outright (stderiv_C4 IS order 4) and wins over
# the node value, so the basis tag cannot disagree with the waveforms it was fit on.
[ -n "$NDM_M_ORDER" ] && methodOrder=$NDM_M_ORDER

# ── Flatten (method, methodOrder) into the neurosuite::core::Method enum int ──
# baked into the PCAE basis header by process_pca (--pca-method), so every
# downstream consumer reads the transform off the self-describing basis instead
# of re-reading methodOrder from the YAML.  Enum: 0=standard,
# 1-3=sdiff{first,laplacian,allpairs}, 4-6=stderiv{first,laplacian,allpairs}.
case "$methodFamily" in
	standard)
		pcaMethod=0 ;;
	sdiff)
		if [ "$methodOrder" -lt 1 ] || [ "$methodOrder" -gt 3 ]; then
			echo_error "methodOrder '$methodOrder' invalid for method '$method' (expected 1-3)"
			exit $GENERAL_ERROR
		fi
		pcaMethod=$methodOrder ;;                    # 1/2/3
	stderiv)
		# 1/2/3 -> StderivFirst/Laplacian/AllPairs (4/5/6).  The custom-pattern
		# orders get their own enum values so the PCAE header records which
		# transform trained the basis instead of it passing as all-pairs.
		case "$methodOrder" in
			1|2|3) pcaMethod=$((methodOrder + 3)) ;;     # 4/5/6
			4)     pcaMethod=7 ;;                        # StderivCustom
			5)     pcaMethod=8 ;;                        # StderivCustomCar
			*) echo_error "methodOrder '$methodOrder' invalid for method '$method' (expected 1-5)"
			   exit $GENERAL_ERROR ;;
		esac ;;
esac

# Print a header to indicate current processing step
print_header "$session - Computing PCA for spike sorting [method=$method]"

# Check required programs
check_commands_installed xpathReader process_pca process_mergefeatures
[ "$methodFamily" = stderiv ] && check_commands_installed process_pca_stderiv

once()
{
	local electrodeGroup=$1

	# Method-tagged artifact paths (chain-of-custody).
	local spkfile=$(ndm_method_path "$session" spk "$electrodeGroup" "$method")
	# .res holds method-independent spike times — a Shared artifact owned by the
	# first extraction run.  Resolve it across all methods (e.g. a standard PCA
	# run reuses the .res written by an earlier stderiv extraction) instead of
	# demanding .res.<method>.<group>, which need not exist.  Fall back to the
	# strict path name only so a missing input reports a meaningful name.
	local resfile=$(ndm_resolve_any "$session" res "$electrodeGroup" "$method")
	[ -z "$resfile" ] && resfile=$(ndm_method_path "$session" res "$electrodeGroup" "$method")
	local fetout=$(ndm_method_path "$session" fet "$electrodeGroup" "$method")

	# Check input files
	inputs_missing "$session.$param_ext" "$spkfile" "$resfile" && exit $INPUTS_MISSING

	# Check output file (process_pca derives .pca.<method>.N from this name)
	outputs_exist "$fetout" && exit $OUTPUTS_EXIST

	# ////////////////////////////////////////////////////////////////////////////////////////////////
	# // Read Parameters
	# ////////////////////////////////////////////////////////////////////////////////////////////////

	nElectrodeGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")
	check_mandatory_variable $nElectrodeGroups "missing electrode groups"
	if [ $electrodeGroup -gt $nElectrodeGroups ]
	then
		echo_error "the spike group $electrodeGroup is undefined."
		exit $GENERAL_ERROR
	fi

	electrodes=($(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/channels/channel"))
	nElectrodes=${#electrodes[*]}
	electrodeList=$(for ((i=0;i<$nElectrodes;i++)); do echo -n ${electrodes[${i}]}","; done)
	electrodeList=${electrodeList:0:${#electrodeList}-1}

	waveformLength=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/nSamples")
	nFeatures=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/nFeatures")

	check_mandatory_variable $waveformLength "missing number of samples per waveform"
	check_mandatory_variable $nFeatures "missing number of features"

	local options=""

	# PCA on partial waveform?
	peak=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/peakSampleIndex")
	check_optional_variable $peak && options="$options -p $peak"
	before=($(read_script_parameter $session before))
	[ ${#before[*]} -eq 1 ] && before=${before[0]} || before=${before[$electrodeGroup-1]}
	check_optional_variable $before && options="$options -b $before"
	after=($(read_script_parameter $session after))
	[ ${#after[*]} -eq 1 ] && after=${after[0]} || after=${after[$electrodeGroup-1]}
	check_optional_variable $after && options="$options -a $after"

	# Extra features?
	extra=$(read_script_parameter $session extra)
	check_optional_variable $extra || extra=false
	$extra && options="$options -x"

	# patch60 — Varimax rotation of the kept PCA basis, forwarded to process_pca.
	# process_pca bakes the rotation into the saved .pca.N basis, so every
	# downstream consumer (Klusters reprojection included) follows it with no
	# further change.  Applies to all methods; for stderiv the rotation acts on
	# the channel-reduced stderiv features that process_pca receives.
	varimax=$(read_script_parameter $session varimax)
	check_optional_variable $varimax || varimax=false
	if $varimax; then
		options="$options --varimax"
		varimaxMaxIter=$(read_script_parameter $session varimaxMaxIter)
		check_optional_variable $varimaxMaxIter && options="$options --varimax-max-iter $varimaxMaxIter"
		varimaxTol=$(read_script_parameter $session varimaxTol)
		check_optional_variable $varimaxTol && options="$options --varimax-tol $varimaxTol"
	fi

	# ── Subset PCA: drop high-rate clusters from the fit ────────────────────
	#
	# When an initial clustering pass has identified fast-spiking interneurons
	# (or any cluster whose row count would bias the PCA basis), pass their
	# cluster ids here to fit eigenvectors on the remaining spikes only.  All
	# spikes are still projected through the resulting basis, so the .fet has
	# one row per spike — only the basis direction changes.  Set in the
	# session config, e.g. YAML excludeClusters: "5,12".  The .clu is the
	# method-tagged file for this group.
	excludeClusters=$(read_script_parameter $session excludeClusters)
	if check_optional_variable $excludeClusters
	then
		cluFile=$(ndm_method_path "$session" clu "$electrodeGroup" "$method")
		if [ ! -f "$cluFile" ]
		then
			echo_error "excludeClusters=$excludeClusters but $cluFile is missing — run an initial PCA + clustering pass first, then re-run with excludeClusters set."
			exit $GENERAL_ERROR
		fi
		options="$options -l $cluFile -e $excludeClusters"
	fi

	# ////////////////////////////////////////////////////////////////////////////////////////////////
	# // Process
	# ////////////////////////////////////////////////////////////////////////////////////////////////
	#
	# standard / sdiff : PCA directly on the raw-amplitude .spk.<method>.N.
	# stderiv          : the .spk already holds the stderiv-transformed waveform,
	#                    so process_pca_stderiv (-d 4 = SDIFF_PASS) performs only
	#                    the channel reduction — for methodOrder 1 (last channel
	#                    = -penultimate) and 3 (channels sum to zero) one channel
	#                    is linearly dependent and dropped, so PCA sees
	#                    nElectrodes-1 channels.
	#
	# -g N labels the progress bar [PCA-N] for parallel-group runs.
	local pcaInput=$spkfile
	local nPca=$nElectrodes
	local tmpspk=
	if [ "$methodFamily" = stderiv ]; then
		if ndm_sdiff_drops_last "$methodOrder"; then
			nPca=$(( nElectrodes - 1 ))
		fi
		tmpspk=$(mktemp /tmp/spk_stderiv_${session##*/}_${electrodeGroup}_XXXXXX)
		process_pca_stderiv -n $nElectrodes -w $waveformLength -d 4 "$spkfile" > $tmpspk
		check_command_status process_pca_stderiv
		pcaInput=$tmpspk
	fi

	process_pca -g $electrodeGroup -f $fetout.tmp -n $nPca -w $waveformLength -d $nFeatures --pca-method $pcaMethod $options ${@:2} $pcaInput
	check_command_status process_pca
	[ -n "$tmpspk" ] && rm -f "$tmpspk"

	# Merge binary PCA features with binary .res timestamps into final binary .fet
	process_mergefeatures $fetout.tmp $resfile $fetout
	check_command_status process_mergefeatures
	rm $fetout.tmp
}

if [ -z "$electrodeGroup" ]
then
	nGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")
	if [ $nGroups -eq 0 ]
	then
		echo_error "missing spike groups"
		exit $GENERAL_ERROR
	fi

	# Run all electrode groups in parallel — each reads a different
	# .spk.<method>.N and writes a different .fet.<method>.N, so no shared state.
	#
	# Thread budget: process_pca uses OpenMP internally. Cap its thread count so
	# that nGroups * threadsPerGroup <= nAvailableCores, keeping total load sane.
	# threadsPerGroup can be set in the session config; if absent, defaults to
	# floor(nCores / nGroups), minimum 1.
	threadsPerGroup=$(yaml_read $session "//program/n[.='ndm_pca']/../parameters/parameter/n[.='threadsPerGroup']/../value")
	if [ -z "$threadsPerGroup" ]
	then
		nCores=$(nproc 2>/dev/null || echo 1)
		threadsPerGroup=$(( nCores / nGroups ))
		[ $threadsPerGroup -lt 1 ] && threadsPerGroup=1
	fi

	# Inject thread count into the options picked up by process_pca inside once().
	PCA_THREAD_OPT="-t $threadsPerGroup"

	pids=()
	for ((i=1;i<=$nGroups;i++))
	do
		(once $i $PCA_THREAD_OPT "${extra_args[@]}") > /tmp/ndm_pca_${session##*/}_$i.log 2>&1 &
		pids+=($!)
	done

	overallStatus=$NO_ERROR
	for ((i=0;i<${#pids[@]};i++))
	do
		wait ${pids[$i]}
		groupStatus=$?
		cat /tmp/ndm_pca_${session##*/}_$((i+1)).log
		rm -f /tmp/ndm_pca_${session##*/}_$((i+1)).log
		if [ $groupStatus -ne 0 ] && [ $groupStatus -ne $OUTPUTS_EXIST ] && [ $groupStatus -ne $INPUTS_MISSING ]
		then
			print_group_failed PCA $((i+1))
			overallStatus=$groupStatus
		fi
	done

	exit $overallStatus
else
	once $electrodeGroup "${extra_args[@]}"
	exit $NO_ERROR
fi
