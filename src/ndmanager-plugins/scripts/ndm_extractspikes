#!/bin/bash

#////////////////////////////////////////////////////////////////////////////
#//
#//   Extract spike waveforms at previously-detected spike times
#//
#//   copyright       (C) 2007-2010 by Michaël Zugaro
#//                   (C) 2025-2026 Gravios / NeuroSuite-3 contributors
#//   email           michael.zugaro@college-de-france.fr
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////
#
#  DESCRIPTION
#  -----------
#  Re-extracts waveforms (-R) for every spike in the shared .res (written by
#  ndm_detectspikes) and writes .spk.<method>.N.  It never detects: if no .res
#  exists yet it errors, pointing you to ndm_detectspikes.  Spike times are
#  method-independent, so the extraction engine (standard | sdiff | stderiv) may
#  differ from the one used for detection — one engine may detect better, another
#  may yield better waveform features — and it may be run several times with
#  different methods/orders, each reusing the same .res.
#
#  PARAMETERS (session file, ndm_extractspikes node)
#    method          standard | sdiff | stderiv        (default standard)
#    methodOrder     spatial-derivative order 0-3       (sdiff/stderiv; default 3)
#    inputExtension  input data extension               (default fil)
#  Extraction needs no threshold/window parameters; under -R the engines take
#  only channel geometry and, for sdiff/stderiv, the spatial-derivative transform.
#
#  USAGE
#    ndm_extractspikes [parameter-file] [--method M] [--methodOrder N]
#                      [--inputExtension EXT] [--force] [--check]
#    ndm_extractspikes [parameter-file] --allMethods [--check] [--inputExtension EXT]
#    CLI flags override the YAML fields; --force re-extracts even when a .spk
#    already exists (overwriting it).  Before running, the session file is
#    checked for everything the method needs (geometry, sdiffPairs matching the
#    token, a .res per group); --check stops after the check.  --allMethods
#    re-extracts (overwrites) every group for every waveform method the session
#    has .spk/.nst/.fet/.pca/.clu files for, skipping and reporting the ones the
#    session file does not cover, and lists the feature spaces to re-project.
#////////////////////////////////////////////////////////////////////////////

# Source helper functions
source ndm_functions

program=$(basename $0)
for _a in "$@"; do
	[ "$_a" = --allMethods ] && { ndm_extract_all_methods "$@"; exit $?; }
done
ndm_process_spikes extract "$@"
