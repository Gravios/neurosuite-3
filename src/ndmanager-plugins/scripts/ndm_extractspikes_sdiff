#!/bin/bash
#////////////////////////////////////////////////////////////////////////////
#//   DEPRECATED: folded into ndm_extractspikes.
#//   `ndm_extractspikes_sdiff [args]` == `ndm_extractspikes --method sdiff [args]`.
#//   Kept as a thin shim so existing pipelines / session-YAML program entries
#//   keep running.  Prefer setting `method: sdiff` under ndm_extractspikes.
#////////////////////////////////////////////////////////////////////////////
# Legacy sessions keep their parameters under the old program node; export
# alt_program so read_script_parameter falls back to it.
export alt_program=ndm_extractspikes_sdiff
echo "ndm_extractspikes_sdiff is deprecated; use 'ndm_extractspikes --method sdiff'." >&2
exec ndm_extractspikes --method sdiff "$@"
