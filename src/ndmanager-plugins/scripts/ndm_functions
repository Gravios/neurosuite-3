# Guidelines for NDManager plugins (ndm_ scripts):
#
# Given that these scripts are designed to run in batches, each individual
# script must follow a certain number of rules:
#
# 1) If the output files are already present in the target directory (they
#    have already been produced by a previous run), exit $OUTPUTS_EXIST
#     => batch jobs can decide to ignore the 'error' and proceed
#
# 2) If the output files are not present and the input files are missing,
#    there is no way the output files can be produced, exit $INPUTS_MISSING
#     => some further steps of the batch may have to be skipped, or
#        the batch may even have to be interrupted altogether
#
# 3) If the output files cannot be produced because of a processing error,
#    return that error
#     => some further steps of the batch may have to be skipped, or
#        the batch may even have to be interrupted altogether
#
# This can be ensured by performing the following steps:
#
# 1) check number of parameters on command-line
# 2) source ndm_functions (this file)
# 3) print header to indicate current processing step
# 4) check for existing output files (exist => exit $OUTPUTS_EXIST)
# 5) check for missing input files (missing => exit $INPUTS_MISSING)
# 6) read XML parameter file
# 7) process
# 8) check for processing errors and return error code

NO_ERROR=0
GENERAL_ERROR=1
OUTPUTS_EXIST=10
INPUTS_MISSING=11
VAR_MISSING=20

BLACK="\e[1;30m"
DARK_GREY="\e[1;30m"
BLUE="\e[1;34m"
LIGHT_BLUE="\e[1;34m"
GREEN="\e[1;32m"
LIGHT_GREEN="\e[1;32m"
CYAN="\e[1;36m"
LIGHT_CYAN="\e[1;36m"
RED="\e[1;31m"
LIGHT_RED="\e[1;31m"
PURPLE="\e[1;35m"
LIGHT_PURPLE="\e[1;35m"
BROWN="\e[0;33m"
YELLOW="\e[1;33m"
LIGHT_GREY="\e[1;37m"
WHITE="\e[1;37m"
BOLD_BLACK="\e[1m"
PLAIN="\e[0m"

#////////////////////////////////////////////////////////////////////////////
#//  Messages (erros, warnings, headers)
#////////////////////////////////////////////////////////////////////////////

# Print error message
echo_error()
{
	indent=$(echo "$1"|sed -r 's/^([ ]*).*/\1/')
	message=$(echo "$1"|sed 's/^ *//g')

	echo -en "$RED" >&2
	echo "$indent$program - error: $message" >&2
	echo -en "$PLAIN" >&2
}

# Print warning message
echo_warning()
{
	indent=$(echo "$1"|sed -r 's/^([ ]*).*/\1/')
	message=$(echo "$1"|sed 's/^ *//g')

	echo -en "$BLUE" >&2
	echo "$indent$program - warning: $message" >&2
	echo -en "$PLAIN" >&2
}

# Print information message
echo_info()
{
# 	local options
# 	while [ $# -gt 0 ]
# 	do
# 		if [ ${1:0:1} == '-' ]
# 		then
# 			options="$options $1"
# 			shift
# 		else
# 			break
# 		fi
# 	done
# 	indent=$(echo "$1"|sed -r 's/^([ ]*).*/\1/')
# 	message=$(echo "$1"|sed 's/^ *//g')
#
	echo $*
}

# Print informational message — synonym for echo_info, kept so newer plugins
# (ndm_decomposecollisions, ndm_setupgroups, ndm_applydrift, ndm_stripdat,
# ndm_estimatedrift) that adopted the more readable name don't fail with
# "echo_message: command not found" when sourced against this file.
echo_message()
{
	echo $*
}

# Print a header to indicate current processing step
#  usage: print_header message [character [style]]
print_header()
{
	local title N n l char style i

	title=$1
	N=80
	n=${#title}
	l=$((($N-$n)/2+1))

	char="="
	if [ $# -gt 1 ]
	then
		char=${2:0:1}
	fi
	if [ $# -gt 2 ]
	then
		style=$3
	else
		style="$PLAIN"
	fi

	echo -e "$style"
	for (( i=1;i<$N;i++ ));do echo -n "$char";done;echo ""
	for (( i=1;i<$l;i++ ));do echo -n " ";done;echo $title
	for (( i=1;i<$N;i++ ));do echo -n "$char";done;
	echo -e "$PLAIN"
}

# Print a single-line failure marker for a group, mimicking the look of
# the modern ProgressBar's ✗ failure marker.  Used by wrapper scripts
# to flag groups whose plugin invocation exited non-zero, since the
# plugin's bar may not have had a chance to emit a marker itself
# (early exit, signal, etc.).
#
# Output format (UTF-8 capable terminals):
#   [<step>-<group>] ──────────────────────────────────────────────────── ✗
#
# Falls back to ASCII '-' fill + '[FAIL]' tag on legacy 8-bit terminals.
#
#  usage: print_group_failed step group
print_group_failed()
{
	local step=$1
	local group=$2
	local label="[${step}-${group}]"
	# Bar-width budget mirrors ProgressBar's 80-col layout: chrome
	# ([+]+space+space+marker = 5 chars after the label).
	local barWidth=$((80 - ${#label} - 5))
	local fill=""
	local i

	# Detect UTF-8.  Same heuristic as ProgressBar::localeIsUtf8: any
	# of LC_ALL / LC_CTYPE / LANG containing "UTF-8" or "utf8".
	local locale="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
	case "$locale" in
		*UTF-8*|*utf-8*|*UTF8*|*utf8*)
			# Unicode: thin horizontal line (U+2500) + bold red ✗ (U+2717).
			for ((i=0;i<barWidth;i++)); do fill+="$(printf '\xe2\x94\x80')"; done
			printf '%s %s \033[1;31m\xe2\x9c\x97\033[0m\n' "$label" "$fill"
			;;
		*)
			# ASCII fallback.
			for ((i=0;i<barWidth;i++)); do fill+="-"; done
			printf '%s %s [FAIL]\n' "$label" "$fill"
			;;
	esac
}

#////////////////////////////////////////////////////////////////////////////
#//  Check environment (commands, inputs, outputs)
#////////////////////////////////////////////////////////////////////////////

# Check that certain required commands are installed (command missing => exit with error)
#  usage: check_commands_installed command1 [command2...]
check_commands_installed()
{
	local command=$1

	for command in $*
	do
		if [ -z "$(which $command)" ]
		then
			echo_error "command '$command' is missing (check installation)."
			exit $GENERAL_ERROR
		fi
	done
}

# *** This function should not be used to evaluate the status of an ndm_ script (use step_completed instead) ***
# Make sure that the previous command succeeded; if not, exit
#  usage: check_command_status command_name
#  usage: check_command_status command_name error
#  The first usage tests $?
check_command_status()
{
	local error=$?
	local command=$1

	if [ $# -eq 2 ]
	then
		error=$2
	fi

	# Just in case this function is used to evaluate the status of an ndm_ script (although it shouldn't),
	# ignore missing input files and existing output files (these should be dealt with elsewhere)
	if [ $error -eq $OUTPUTS_EXIST ] || [ $error -eq $INPUTS_MISSING ]
	then
		return
	fi

	if [ $error -eq 127 ]
	then
		echo_error "the program '$command' was not found."
		exit $GENERAL_ERROR
	fi

	if [ $error -eq 126 ]
	then
		echo_error "the program '$command' is not executable."
		exit $GENERAL_ERROR
	fi

	# One of the processes in the command could be receiving a term signal of 13 (128 + 13 =
	# 141) SIGPIPE. Apparrently this could happen if the process after the pipe
	# closes its STDIN before the original process is finished.
	# This seems to be the case of spower | sbaselin, and this is not an error

	if [ $error -ne 141 ] && [ $error -ne 0 ]
	then
		echo_error "the program '$command' exited with the error code $error."
		exit $GENERAL_ERROR
	fi
}

# Make sure that the previous batch step (ndm_ script) succeeded
# No warning/error reporting is required at this point, because this should have already been performed
# during the previous step (ndm_ script)
#  usage: step_completed script_name
#  usage: step_completed script_name error
#  typical usage 1: step_completed script_name || exit 1 (exit with error if step failed)
#  typical usage 2: step_completed script_name && { ... } (execute instructions if step succeeded)
#  The first usage tests $?
step_completed()
{
	local error=$?
	local script=$1

	if [ $# -eq 2 ]
	then
		error=$2
	fi

	if [ $error -eq $NO_ERROR ] || [ $error -eq $OUTPUTS_EXIST ] || [ $error -eq $INPUTS_MISSING ]
	then
		return $NO_ERROR
	else
		return $GENERAL_ERROR
	fi
}

# Check for the presence of input files (missing => return 0)
#  usage: inputs_missing file1 [file2...]
#  typical usage 1: inputs_missing file1 file2 && exit 1 (exit with error if input files are missing)
#  typical usage 2: inputs_missing file1 file2 || { ... } (execute instructions if input files are present)
inputs_missing()
{
	local missing=false file

	for file in $*
	do
		if [ ! -f "$file" ]
		then
			echo_warning "input file '$file' not found, skipping this step."
			missing=true
		fi
	done
	$missing && return $NO_ERROR || return $GENERAL_ERROR
}

# Check if output files already exist (found => return 1)
#  usage: outputs_exist file1 [file2...]
#  typical usage 1: outputs_exist file1 file2 && exit 1 (exit with error if output files are already present)
#  typical usage 2: outputs_exist file1 file2 || { ... } (execute instructions if output files are absent)
outputs_exist()
{
	local found=false file
	for file in $*
	do
		if [ -f "$file" ]
		then
			echo_warning "output file '$file' exists, skipping this step."
			found=true
		fi
	done
	$found && return $NO_ERROR || return $GENERAL_ERROR
}

#////////////////////////////////////////////////////////////////////////////
#//  Read parameter file (read, count and test variables)
#////////////////////////////////////////////////////////////////////////////

# Read data from the parameter file for current session (low level)
#  usage: xml_read file xpath
#  Transparent YAML fallback: if a .yaml parameter file exists alongside
#  (or instead of) the .xml file, yaml_read handles the query and
#  xpathReader is never called.  All existing scripts work unchanged.
xml_read()
{
	local file=$1
	local xpath=$2

	local session=${file%.xml}
	session=${session%.yaml}
	local yamlfile
	yamlfile=$(find_yaml_file "$session")
	if [ -n "$yamlfile" ]; then
		yaml_read "$session" "$xpath"
		return
	fi
	xpathReader "${session}.xml" "$xpath"
}

# Count items in a given list in the parameter file for current session
#  usage: xml_count file xpath
#  YAML fallback: counts list length via yaml_read on YAML sessions.
xml_count()
{
	local file=$1
	local xpath=$2

	local session=${file%.xml}
	session=${session%.yaml}
	local yamlfile
	yamlfile=$(find_yaml_file "$session")
	if [ -n "$yamlfile" ]; then
		# Use Python to count list elements directly — do not use yaml_read
		# here because yaml_read collects all leaf values, not list items.
		python3 - "$yamlfile" "$xpath" << 'PYEOF'
import sys, yaml, re
def resolve(doc, xpath):
    parts = re.split(r'/(?![^\[]*\])', re.sub(r'^/+', '', xpath))
    node = doc
    for p in parts:
        if node is None: return None
        m = re.match(r'^(.+)\[(\d+)\]$', p)
        if m:
            key, idx = m.group(1), int(m.group(2))
            node = node.get(key) if isinstance(node, dict) else None
            node = node[idx-1] if isinstance(node, list) and 0<idx<=len(node) else None
        else:
            node = node.get(p) if isinstance(node, dict) else None
    return node

# Surface YAML parse / I/O errors; swallow only traversal-time errors.
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f)
except yaml.YAMLError as e:
    print(f"xml_count: {sys.argv[1]}: YAML parse error: {e}", file=sys.stderr)
    sys.exit(1)
except OSError as e:
    print(f"xml_count: {sys.argv[1]}: {e}", file=sys.stderr)
    sys.exit(1)

try:
    node = resolve(doc, sys.argv[2])
    print(len(node) if isinstance(node, list) else (0 if node is None else 1))
except Exception: print(0)
PYEOF
		return
	fi
	xpathReader --count "${session}.xml" "$xpath"
}

# Make sure a variable was assigned after reading the parameter file
#  usage: xml_read_failed variable
#  example: xml_read_failed $ok && echo "Unknown parameter 'ok'."
xml_read_failed()
{
	[ -z "$1" ] || [ "$1" == "(null)" ]
}

# Read script parameter from the parameter file for current session (high level)
# A single parameter can have different names in different versions of the script, which can all be tested
#  usage: read_script_parameter [-s script_name] [-a alternative_script_name] file name1 [name2...]
# By default, read parameter for currently running script. Alternatively, parameters for a different script
# can be read using -s and -a options if necessary.
read_script_parameter()
{
	local xpath
	local name
	local value
	local script=$program
	local alt_script=$alt_program

	# Process options
	while true
	do
		case "$1" in
			-s)
				script=$2
				shift 2
				;;
			-a)
				alt_script=$2
				shift 2
				;;
			*)
				break
				;;
		esac
	done

	local file=$1
	file=${file%.xml}.xml
	shift

	# Try using name of current script
	for name in $*
	do
		xpath="//program/name[.='$script']/../parameters/parameter/name[.='$name']/../value"
		value=$(xml_read $file $xpath)
		xml_read_failed $value || break
	done
	# Failed? try using former (legacy) name of current script
	if xml_read_failed $value && [ ! -z "$alt_script" ]
	then
		for name in $*
		do
			xpath="//program/name[.='$alt_script']/../parameters/parameter/name[.='$name']/../value"
			value=$(xml_read $file $xpath)
			xml_read_failed $value || break
		done
	fi
	# Failed? try reading from 'general' parameters
	if xml_read_failed $value
	then
		for name in $*
		do
			xpath="//program/name[.='general']/../parameters/parameter/name[.='$name']/../value"
			value=$(xml_read $file $xpath)
			xml_read_failed $value || break
		done
	fi
	echo $value
}

# Make sure a variable was assigned after reading the parameter file
#  usage: check_mandatory_variable variable description
#  note: if the variable is unassigned, this EXITS the script!
check_mandatory_variable()
{
	local n=$#
	local description=${!n}

	# if the variable is unassigned, we receive only one parameter (the description of the variable)
	if [ $n -eq 1 ] || xml_read_failed $1
	then
		echo_error "$description (check parameter file)."
		exit $GENERAL_ERROR
	fi
}

# Make sure a variable was assigned after reading the parameter file
#  usage: check_optional_variable variable
#  example: check_optional_variable $ok || echo "Unknown variable 'ok'."
check_optional_variable()
{
	! xml_read_failed $1
}

# Make sure all variables are empty after reading the parameter file
#  usage: check_empty_variables variable1 variable2...
#  example: check_empty_variables $var1 $var2 && echo "No action requested, skipping." && return
check_empty_variables()
{
	for var in $*
	do
		xml_read_failed $var || return 1
	done
	return 0
}

#////////////////////////////////////////////////////////////////////////////
#//  Session resolution
#//
#//  ndm_resolve_session: resolve the session name without forcing the user
#//  to pass it on the command line.  Eliminates the historic
#//  `ndm_xxx SESSION arg1 arg2 ...` ambiguity that bit `ndm_applydrift 6`
#//  (the 6 was silently consumed as SESSION because there was no parameter
#//  file with that name, then the script fell back through YAML defaults).
#//
#//  Resolution order:
#//    1. If $1 looks like a session — i.e. a parameter file with that base
#//       name exists in the current directory (.yaml, .yml, or .xml) — use it.
#//    2. Otherwise, derive the session from the current directory's basename.
#//
#//  Side effects (globals set):
#//    $session       resolved session name (no extension)
#//    $directory     basename of cwd (preserved for the small number of
#//                   ndm_* scripts that still reference this name —
#//                   ndm_extractleds, ndm_ncs2dat, ndm_smr2dat, etc.)
#//    $NDM_SHIFTED   1 if $1 was consumed as a session, 0 otherwise.
#//
#//  Recommended caller pattern (replaces the old 3-line block):
#//
#//      ndm_resolve_session "$@"
#//      [ "$NDM_SHIFTED" = 0 ] && set -- "$session" "$@"
#//
#//  The `set --` line padds the positional args so the rest of the script
#//  body — which was written assuming $1 = session and $2+ = real args —
#//  needs no further changes.  Whether the caller invokes
#//      ndm_xxx                  (new: bare, session from cwd)
#//      ndm_xxx session_name     (new: explicit session)
#//      ndm_xxx 6                (new: 6 is first real arg, session from cwd)
#//      ndm_xxx session_name 6   (old: explicit session, 6 is first real arg)
#//  the script body sees the same $1=session, $2=6 layout.
#//
#//  For scripts that flag-parse into a `positionals` array (variant B),
#//  the pad step uses the array instead:
#//      ndm_resolve_session "${positionals[@]}"
#//      [ "$NDM_SHIFTED" = 0 ] && positionals=("$session" "${positionals[@]}")
#////////////////////////////////////////////////////////////////////////////

ndm_resolve_session()
{
	NDM_SHIFTED=0
	directory=$(basename "$(pwd)")
	session=${directory%.xml}
	session=${session%.yaml}
	session=${session%.yml}
	if [ -n "${1:-}" ]; then
		local cand=${1%.xml}
		cand=${cand%.yaml}
		cand=${cand%.yml}
		if [ -f "${cand}.yaml" ] || [ -f "${cand}.yml" ] || [ -f "${cand}.xml" ]; then
			session=$cand
			NDM_SHIFTED=1
		fi
	fi
}

#////////////////////////////////////////////////////////////////////////////
#//  KlustaKwik three- or four-tier parameter reader (shared)
#//
#//  Resolves a KlustaKwik parameter for a given electrode group using
#//  three (or four, when a caller block is specified) tiers, in order of
#//  decreasing priority:
#//
#//    1. spikeDetection.channelGroups[g].klustakwik.<n>
#//       Per-group probe-calibrated value (highest priority).
#//    2. programs[<caller_block>].parameters.<n>
#//       ONLY consulted when -b <caller_block> is passed AND caller_block
#//       differs from "ndm_klustakwik".  Lets wrapper scripts (e.g.
#//       ndm_subcluster_unmatched) override KK defaults for their own
#//       run without touching the main-sort block — or without
#//       duplicating every knob when only a handful differ.
#//    3. programs[ndm_klustakwik].parameters.<n>
#//       Global session default.  Always consulted so wrapper blocks can
#//       override selectively (set only the parameters that matter; the
#//       rest fall through to the user's main KK config).
#//    4. Caller-supplied default (safety net).
#//
#//  Lives here (rather than in ndm_klustakwik) so wrapper scripts that
#//  invoke KlustaKwik against sandbox sessions — ndm_subcluster_unmatched,
#//  future ndm_resort_bin, etc. — can reuse the identical resolution
#//  order and parameter set as the main sorter.
#//
#//  Usage: read_kk_param [-b <caller_block>] <group> <paramName> <default>
#//  Requires $session to be set in the caller's scope (the session stem
#//  used by yaml_read, matching the xml_read / read_script_parameter
#//  convention elsewhere in ndm_functions).
#////////////////////////////////////////////////////////////////////////////

read_kk_param()
{
	local caller_block=""
	if [ "$1" == "-b" ]
	then
		caller_block=$2
		shift 2
	fi

	local group=$1
	local name=$2
	local default=$3

	# Tier 1: per-group spikeDetection.channelGroups[group].klustakwik.<n>
	local value
	value=$(yaml_read "$session" "//spikeDetection/channelGroups/group[$group]/klustakwik/$name")
	if ! xml_read_failed "$value"
	then
		echo "$value"
		return
	fi

	# Tier 2: caller-specific programs[<caller_block>].parameters.<n>.
	# Skipped if no -b was given or the caller IS ndm_klustakwik (tier 3
	# would be identical, so skip to avoid a redundant XPath hit).
	if [ -n "$caller_block" ] && [ "$caller_block" != "ndm_klustakwik" ]
	then
		value=$(read_script_parameter -s "$caller_block" "$session" "$name")
		if ! xml_read_failed "$value"
		then
			echo "$value"
			return
		fi
	fi

	# Tier 3: global programs[ndm_klustakwik] block.  Pass -s explicitly so
	# this works when called from any script, not just ndm_klustakwik —
	# without -s, read_script_parameter would resolve $program to the
	# caller's name (e.g. ndm_subcluster_unmatched) and miss the user's
	# ndm_klustakwik configuration block.
	value=$(read_script_parameter -s ndm_klustakwik "$session" "$name")
	if ! xml_read_failed "$value"
	then
		echo "$value"
		return
	fi

	# Tier 4: built-in default
	echo "$default"
}

#////////////////////////////////////////////////////////////////////////////
#//  Read YAML parameter file (parallel to xml_read / read_script_parameter)
#//
#//  These functions mirror the XML reading API exactly so that ndm_ scripts
#//  can support both .xml and .yaml parameter files with minimal changes.
#//
#//  Requires: python3 with the pyyaml package (pip install pyyaml, or
#//            apt install python3-yaml on Debian/Ubuntu).
#//
#//  Auto-detection
#//  --------------
#//  The wrapper functions yaml_read / read_yaml_script_parameter accept a
#//  session basename (no extension) and look for <session>.yaml first,
#//  then fall back to <session>.yml.
#//
#//  Transparent dispatch
#//  --------------------
#//  The existing xml_read and read_script_parameter functions are overridden
#//  below to auto-detect the file format.  Scripts that currently call
#//  xml_read / read_script_parameter will transparently use the YAML reader
#//  when a .yaml file is present, with no changes to the calling script.
#////////////////////////////////////////////////////////////////////////////

# ---- Low-level YAML reader ------------------------------------------------

# Read a single scalar value from a YAML file using a dot-separated key path.
# The key path mirrors the YAML hierarchy, e.g.:
#   acquisitionSystem.nChannels
#   spikeDetection.channelGroups.0.nSamples
# Returns the value as a plain string, or empty string on failure.
#
#  usage: yaml_read_key file keypath
yaml_read_key()
{
	local file=$1
	local keypath=$2

	python3 - "$file" "$keypath" << 'PYEOF'
import sys, yaml

def get_nested(node, parts):
    for p in parts:
        if node is None:
            return None
        if isinstance(node, list):
            try:
                node = node[int(p)]
            except (ValueError, IndexError):
                return None
        elif isinstance(node, dict):
            node = node.get(p)
        else:
            return None
    return node

# Surface YAML parse / I/O errors loudly; only swallow lookup-time errors.
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f)
except yaml.YAMLError as e:
    print(f"yaml_read_key: {sys.argv[1]}: YAML parse error: {e}", file=sys.stderr)
    sys.exit(1)
except OSError as e:
    print(f"yaml_read_key: {sys.argv[1]}: {e}", file=sys.stderr)
    sys.exit(1)

try:
    parts = sys.argv[2].split('.')
    val = get_nested(doc, parts)
    if val is None:
        sys.exit(0)
    out = str(val).strip()
    if out in ('True', 'False'):
        out = out.lower()
    print(out, end='')
except Exception:
    sys.exit(0)
PYEOF
}

# Resolve a session basename to its YAML file path.
# Returns the path, or empty string if neither .yaml nor .yml exists.
#  usage: find_yaml_file session
find_yaml_file()
{
	local session=${1%.xml}
	session=${session%.yaml}
	session=${session%.yml}
	if [ -f "${session}.yaml" ]; then echo "${session}.yaml"
	elif [ -f "${session}.yml" ]; then echo "${session}.yml"
	else echo ""
	fi
}

# Read an arbitrary XPath-style query from a YAML file.
# Supports the two XPath patterns used by ndm scripts:
#   //acquisitionSystem/nChannels          → acquisitionSystem.nChannels
#   //program/name[.='ndm_hipass']/../parameters/parameter/name[.='windowHalfLength']/../value
#     → searches programs[] list by name, then parameter by name
#
#  usage: yaml_read file xpath
yaml_read()
{
	local file=$1
	local xpath=$2

	# Normalise: strip the basename extension so we can re-add .yaml
	local session=${file%.xml}
	local yamlfile
	yamlfile=$(find_yaml_file "$session")
	[ -z "$yamlfile" ] && return

	python3 - "$yamlfile" "$xpath" << 'PYEOF'
import sys, yaml, re

def xpath_simple(doc, xpath):
    # Strip leading //
    xpath = re.sub(r'^/+', '', xpath)
    # Split on / but keep [N] predicates attached to their segment
    # e.g. spikeDetection/channelGroups/group[2]/channels/channel
    parts = re.split(r'/(?![^\[]*\])', xpath)
    node = doc
    for p in parts:
        if node is None:
            return None
        # Check for [N] 1-based index predicate  e.g. group[2]
        m = re.match(r'^(.+)\[(\d+)\]$', p)
        if m:
            key, idx = m.group(1), int(m.group(2))
            if isinstance(node, dict):
                node = node.get(key)
            if isinstance(node, list):
                if idx < 1 or idx > len(node):
                    return None
                node = node[idx - 1]
            else:
                return None
        elif isinstance(node, list):
            # Terminal traversal over a list: collect scalar values from each item.
            # Handles: channelGroups/group[N]/channels/channel where channels is a list of ints.
            results = []
            for item in node:
                if isinstance(item, dict):
                    v = item.get(p)
                    if v is not None:
                        if isinstance(v, list):
                            results.extend(str(x) for x in v)
                        else:
                            results.append(str(v).strip())
                else:
                    # scalar list item — the XML element name is implicit
                    results.append(str(item).strip())
            return ' '.join(results) if results else None
        elif isinstance(node, dict):
            node = node.get(p)
        else:
            return None

    if node is None:
        return None
    # List of scalars: return space-separated
    if isinstance(node, list):
        return ' '.join(str(x) for x in node)
    return str(node).strip()

def xpath_program_param(doc, xpath):
    # Handles both name and legacy n element variants:
    #   //program/name[.='SCRIPT']/../parameters/parameter/name[.='PARAM']/../value
    #   //program/n[.='SCRIPT']/../parameters/parameter/n[.='PARAM']/../value
    m = re.search(r"(?:name|n)\[\.\='([^']+)'\].*(?:name|n)\[\.\='([^']+)'\].*value", xpath)
    if not m:
        return None
    script_name, param_name = m.group(1), m.group(2)
    programs = doc.get('programs', [])
    for prog in programs:
        if str(prog.get('name', '')) == script_name:
            for param in prog.get('parameters', []):
                if str(param.get('name', '')) == param_name:
                    v = param.get('value')
                    return str(v).strip() if v is not None else None
    return None

# Load + parse YAML.  These errors MUST surface — silently swallowing them
# (as the previous catch-all did) makes downstream "missing variable" errors
# misleading.  Tab characters in YAML are the canonical example: they raise
# yaml.YAMLError, which previously vanished and produced an empty result.
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f)
except yaml.YAMLError as e:
    print(f"yaml_read: {sys.argv[1]}: YAML parse error: {e}", file=sys.stderr)
    sys.exit(1)
except OSError as e:
    print(f"yaml_read: {sys.argv[1]}: {e}", file=sys.stderr)
    sys.exit(1)

# XPath traversal — internal logic errors stay silent (preserves the "key
# not found" semantics that callers rely on via xml_read_failed).
try:
    xpath = sys.argv[2]
    # Detect program-parameter pattern (has predicate on name/n element)
    if re.search(r"(?:name|n)\[\.\=", xpath):
        result = xpath_program_param(doc, xpath)
    else:
        result = xpath_simple(doc, xpath)

    if result is not None:
        # Normalise Python booleans to bash-compatible lowercase
        if result in ('True', 'False'):
            result = result.lower()
        print(result, end='')
except Exception:
    pass
PYEOF
}

# Read a script parameter from a YAML file.
# Mirrors read_script_parameter exactly (same flags, same fallback chain).
#
#  usage: read_yaml_script_parameter [-s script_name] [-a alt_script_name] file name1 [name2...]
read_yaml_script_parameter()
{
	local script=$program
	local alt_script=$alt_program

	while true; do
		case "$1" in
			-s) script=$2;     shift 2 ;;
			-a) alt_script=$2; shift 2 ;;
			*)  break ;;
		esac
	done

	local file=$1
	shift
	local yamlfile
	yamlfile=$(find_yaml_file "${file%.xml}")
	[ -z "$yamlfile" ] && return

	local value name

	# Try current script name
	for name in "$@"; do
		value=$(yaml_read "$file" "//program/name[.='${script}']/../parameters/parameter/name[.='${name}']/../value")
		xml_read_failed "$value" || break
	done

	# Try legacy / alternative script name
	if xml_read_failed "$value" && [ -n "$alt_script" ]; then
		for name in "$@"; do
			value=$(yaml_read "$file" "//program/name[.='${alt_script}']/../parameters/parameter/name[.='${name}']/../value")
			xml_read_failed "$value" || break
		done
	fi

	# Try 'general' parameters
	if xml_read_failed "$value"; then
		for name in "$@"; do
			value=$(yaml_read "$file" "//program/name[.='general']/../parameters/parameter/name[.='${name}']/../value")
			xml_read_failed "$value" || break
		done
	fi

	echo "$value"
}

# Count items in a YAML file matching an XPath-style list selector.
# Supports the same XPath patterns used by xml_count:
#   //spikeDetection/channelGroups/group  → counts items in the channelGroups list
#
# The last path segment is treated as the XML element name that wraps each list
# item.  In YAML the wrapper element is gone — the list items are direct children
# of channelGroups.  So we navigate to the parent of the last segment and count
# list items there.  If the parent itself is a list we count its length.
#
#  usage: yaml_count file xpath
yaml_count()
{
	local file=$1
	local xpath=$2

	local yamlfile
	yamlfile=$(find_yaml_file "${file%.xml}")
	[ -z "$yamlfile" ] && echo 0 && return

	python3 - "$yamlfile" "$xpath" << 'PYEOF'
import sys, yaml, re

def get_nested(node, parts):
    for p in parts:
        if node is None:
            return None
        if isinstance(node, list):
            try:
                node = node[int(p)]
            except (ValueError, IndexError):
                return None
        elif isinstance(node, dict):
            node = node.get(p)
        else:
            return None
    return node

# Load + parse YAML.  Surface parse errors (e.g. tab indentation) loudly
# rather than silently returning 0.
try:
    with open(sys.argv[1]) as f:
        doc = yaml.safe_load(f)
except yaml.YAMLError as e:
    print(f"yaml_count: {sys.argv[1]}: YAML parse error: {e}", file=sys.stderr)
    sys.exit(1)
except OSError as e:
    print(f"yaml_count: {sys.argv[1]}: {e}", file=sys.stderr)
    sys.exit(1)

# Lookup logic — silent fallback to 0 on internal traversal errors.
try:
    xpath = sys.argv[2]
    # Strip leading //
    xpath = re.sub(r'^/+', '', xpath)
    parts = xpath.split('/')

    # Strategy: try parent of last segment first (the XML wrapper element is
    # absent in YAML; groups are direct list items under channelGroups).
    # e.g. //spikeDetection/channelGroups/group
    #   -> navigate to spikeDetection/channelGroups, count list items there.
    parent = get_nested(doc, parts[:-1])
    if isinstance(parent, list):
        print(len(parent), end='')
    elif isinstance(parent, dict):
        last_key = parts[-1]
        val = parent.get(last_key)
        if isinstance(val, list):
            print(len(val), end='')
        elif val is not None:
            print(1, end='')
        else:
            # last key not found as a dict key — the list items ARE the parent
            # (shouldn't normally happen, but fall back to 0)
            print(0, end='')
    else:
        print(0, end='')
except Exception:
    print(0, end='')
PYEOF
}

# Return the parameter file extension for a given session basename.
# Checks for .yaml/.yml first, falls back to .xml.
# This is used by ndm_start to determine which file to copy and pass around.
#  usage: param_file_ext session
param_file_ext()
{
	local session=${1%.xml}
	session=${session%.yaml}
	session=${session%.yml}
	if [ -f "${session}.yaml" ]; then echo "yaml"
	elif [ -f "${session}.yml" ]; then echo "yml"
	else echo "xml"
	fi
}

# ---- Transparent dispatch overrides ---------------------------------------
# Override xml_read, xml_count, and read_script_parameter to auto-detect format.
# If a .yaml/.yml file exists alongside the .xml file, it takes precedence.
# This allows all existing ndm_ scripts to work with YAML files unchanged.

_orig_xml_count()
{
	local file=$1
	local xpath=$2
	file=${file%.xml}.xml
	xpathReader --count "$file" "$xpath"
}

xml_count()
{
	local file=$1
	local yamlfile
	yamlfile=$(find_yaml_file "${file%.xml}")
	if [ -n "$yamlfile" ]; then
		yaml_count "$file" "$2"
	else
		_orig_xml_count "$file" "$2"
	fi
}

_orig_xml_read()
{
	local file=$1
	local xpath=$2
	file=${file%.xml}.xml
	xpathReader "$file" "$xpath"
}

xml_read()
{
	local file=$1
	local yamlfile
	yamlfile=$(find_yaml_file "${file%.xml}")
	if [ -n "$yamlfile" ]; then
		yaml_read "$file" "$2"
	else
		_orig_xml_read "$file" "$2"
	fi
}

_orig_read_script_parameter()
{
	local xpath name value
	local script=$program
	local alt_script=$alt_program

	while true; do
		case "$1" in
			-s) script=$2;     shift 2 ;;
			-a) alt_script=$2; shift 2 ;;
			*)  break ;;
		esac
	done

	local file=$1
	file=${file%.xml}.xml
	shift

	for name in "$@"; do
		xpath="//program/name[.='$script']/../parameters/parameter/name[.='$name']/../value"
		value=$(xpathReader "$file" "$xpath")
		xml_read_failed "$value" || break
	done
	if xml_read_failed "$value" && [ -n "$alt_script" ]; then
		for name in "$@"; do
			xpath="//program/name[.='$alt_script']/../parameters/parameter/name[.='$name']/../value"
			value=$(xpathReader "$file" "$xpath")
			xml_read_failed "$value" || break
		done
	fi
	if xml_read_failed "$value"; then
		for name in "$@"; do
			xpath="//program/name[.='general']/../parameters/parameter/name[.='$name']/../value"
			value=$(xpathReader "$file" "$xpath")
			xml_read_failed "$value" || break
		done
	fi
	echo "$value"
}

read_script_parameter()
{
	# Peek at the file argument (after any -s/-a options)
	local args=("$@")
	local i=0
	while [ $i -lt ${#args[@]} ]; do
		case "${args[$i]}" in
			-s|-a) i=$((i+2)) ;;
			*) break ;;
		esac
	done
	local file="${args[$i]}"
	local yamlfile
	yamlfile=$(find_yaml_file "${file%.xml}")
	if [ -n "$yamlfile" ]; then
		read_yaml_script_parameter "$@"
	else
		_orig_read_script_parameter "$@"
	fi
}

#////////////////////////////////////////////////////////////////////////////
#//  General data file processing helpers
#////////////////////////////////////////////////////////////////////////////

# Round to integer
#  usage: round number
round()
{
	echo $1 | awk '{printf "%d",$1}'
}

# Test absolute time difference (between two streams)
#  usage: test_time_delta time max_time
#  example: test_time_delta $delta 3 && echo "delta is more than 3 seconds"
test_time_delta()
{
	local dt=$1
	local max=$2

	echo ""|awk "{if ($dt<$max&&$dt>-$max) exit $GENERAL_ERROR}"
}

# Split directory name into meaningful parts: prefix-date[-description]-suffix
# Possible parts include: prefix, date, description, suffix. See manpage for ndm_start for file naming
# conventions.
#  usage: dirname_part -s suffix part filename
#  usage: dirname_part -n part filename
#  usage: dirname_part part filename
# Because the limit between description and suffix is arbitrary, and in addition the suffix is optional,
# in general it cannot be guessed from the filename. There are three ways to deal with this:
#  1) explicitly supply the suffix using option -s
#  2) indicate that there is no suffix, using option -n
#  3) use the last '-' as a separator between description and suffix (no option)
dirname_part()
{
	local suffix
	local no_suffix=false

	if [ "$1" == "-s" ]
	then
		suffix=$2
		shift 2
	elif [ "$1" == "-n" ]
	then
		no_suffix=true
		shift
	fi

	local part=$1
	local dirname=$2

	[ -z "$part" ] || [ -z "$dirname" ] && return

	local date prefix end description

	# Start with the 'easy' ones
	date=$(filename_date $dirname)
	[ -z "$date" ] && return
	prefix=$(echo $dirname|sed -r '/(.*)-'$date'.*/!d;s//\1/')

	# Deal with the 'hard' end of the filename
	description=${dirname#$prefix-$date}
	if [ -z "$suffix" ] && ! $no_suffix
	then
		suffix=$(echo $description|sed -r '/.*-(.*)/!d;s//\1/')
	fi
	description=${description%$suffix}
	description=${description%-}
	description=${description#-}

	if [ $part == 'all' ]
	then
		# For debugging purposes only!
		echo -e "prefix =\t$prefix"
		echo -e "date =\t$date"
		echo -e "description =\t$description"
		echo -e "suffix =\t$suffix"
	elif [ $part == 'base' ]
	then
		echo $prefix-$date
	else
		echo ${!1}
	fi
}

# Split file name into meaningful parts: prefix-date-nn-description-suffix[-NNN][.evt].extension
# Possible parts include: prefix, date, nn (session number), description, suffix, NNN (Neuralynx channel
# or video subsession), event type, extension. See manpage for ndm_start for file naming conventions.
#  usage: filename_part -s suffix part filename
#  usage: filename_part -n part filename
#  usage: filename_part part filename
# Because the limit between description and suffix is arbitrary, and in addition the suffix is optional,
# in general it cannot be guessed from the filename. There are three ways to deal with this:
#  1) explicitly supply the suffix using option -s
#  2) indicate that there is no suffix, using option -n
#  3) use the last '-' as a separator between description and suffix (no option)
filename_part()
{
	local suffix
	local no_suffix=false

	if [ "$1" == "-s" ]
	then
		suffix=$2
		shift 2
	elif [ "$1" == "-n" ]
	then
		no_suffix=true
		shift
	fi

	local part=$1
	local filename=$2

	[ -z "$part" ] || [ -z "$filename" ] && return

	local date prefix nn extension p_extension evt p_evt end NNN description

	# Extract parts from filename:
	# 1) prefix-date-nn-description[-suffix][-NNN].extension

	# Start with the 'easy' ones
	date=$(filename_date $filename)
	[ -z "$date" ] && return
	prefix=$(echo $filename|sed -r '/(.*)-'$date'.*/!d;s//\1/')
	nn=$(echo $filename|sed -r '/'$prefix'-'$date'-([0-9]{2})-.*/!d;s//\1/')
	extension=$(echo $filename|sed -r '/.*[.](.*)/!d;s//\1/')
	[ ! -z "$extension" ] && p_extension=.$extension

	# Special case: evt files end in .ccc.evt where 'c' is any character
	if [ "$extension" == "evt" ]
	then
		evt=$(echo $filename|sed -r '/.*[.](.{3})[.]'$extension'/!d;s//\1/')
		[ ! -z "$evt" ] && p_evt=.$evt
	fi

	# Deal with the 'hard' end of the filename
	end=$(echo $filename|sed -r '/'$prefix'-'$date'-'$nn'-(.*)'$p_evt$p_extension'/!d;s//\1/')
	NNN=$(echo $end|sed -r '/.*-([0-9]+).*/!d;s//\1/')
	description=${end%-$NNN}
	description=${description%$p_evt}
	if [ -z "$suffix" ] && ! $no_suffix
	then
		suffix=$(echo $description|sed -r '/.*-(.*)/!d;s//\1/')
	fi
	description=${description%-$suffix}

	if [ $part == 'all' ]
	then
		# For debugging purposes only!
		echo -e "prefix =\t$prefix"
		echo -e "date =\t$date"
		echo -e "nn =\t$nn"
		echo -e "description =\t$description"
		echo -e "suffix =\t$suffix"
		echo -e "NNN =\t$NNN"
		echo -e "evt =\t$evt"
		echo -e "extension =\t$extension"
	elif [ $part == 'base' ]
	then
		echo $prefix-$date-$nn-$description
	else
		echo ${!1}
	fi
}

# Get date from file name
#  usage: filename_date filename
filename_date()
{
	local d
	local filename=$1

	# Case 1: date is specified as YYYYMMDD in the file name
	d=$(echo $filename | sed -r '/.*([0-9]{8}).*/!d;s//\1/')
	# Case 2: date is specified as YYYY-MM-DD in the file name
	[ -z "$d" ] && d=$(echo $filename | sed -r '/.*([0-9]{4}-[0-9]{2}-[0-9]{2}).*/!d; s//\1/')

	echo $d
}

# Format date for XML <date> tag
#  usage: format_date YYYYMMDD
#  usage: format_date YYYY-MM-DD
#  outputs: YYYY-MM-DD
format_date()
{
	local d

	# Case 1: date is specified as YYYYMMDD in the file name
	d=$(echo $1 | sed -r '/.*([0-9]{4})([0-9]{2})([0-9]{2}).*/!d;s//\1-\2-\3/')
	# Case 2: date is specified as YYYY-MM-DD in the file name
	[ -z "$d" ] && d=$(echo $1 | sed -r '/.*([0-9]{4}-[0-9]{2}-[0-9]{2}).*/!d; s//\1/')

	echo $d
}

# Test if current session includes files with a given extension (= format)
#  usage: extension_exists extension directory session suffixes
extension_exists()
{
	local extension=$1
	local directory=$2
	local session=$3
	shift 3
	local suffixes=("$@")
	local files n suffix

	n=$(get_n_suffixes ${suffixes[*]})
	for (( i=0;i<$n;i++ ))
	do
		suffix=$(get_suffix $i ${suffixes[*]})
		files=$(ls ../$directory-$suffix/$session*.$extension 2>/dev/null)
		[ ! -z "$files" ] && return 0
	done
	return 1
}

# Determine the common prefix for a list of files/directories
# common_prefix dir1 dir2...
common_prefix()
{
	local common=$1
	local this
	shift

	for this in $*
	do
		for ((i=1;i<${#common}&&i<${#this};i++))
		do
			[ "${this:0:$i}" != "${common:0:$i}" ] && break
		done
		common=${common:0:$i-1}
	done
	echo $common
}

# Does the file prefix contain a date?
# prefix_has_date prefix
prefix_has_date()
{
	local date

	date=$(dirname_part date $1)
	[ ! -z "$date" ]
}

# List suffixes (useful when not explicitly provided)
# list_suffixes dir1 dir2...
list_suffixes()
{
	local common=$(common_prefix $*)
	echo $* | sed -s 's/^'$common'-//;s/ '$common'-/ /g'
}

# Get number of suffixes
#  usage: get_n_suffixes suffixes
get_n_suffixes()
{
	local suffixes=("$@")

	echo ${#suffixes[*]}
}

# Get nth suffix (counted from zero)
#  usage: get_suffix n suffixes
get_suffix()
{
	local i=$1
	shift
	local suffixes=("$@")
	local suffix n

	suffix=${suffixes[$i]}
	n=${#suffix}
	[ "${suffix:0:1}" == "-" ] && suffix=${suffix:1:n-1}
	echo $suffix
}

# Get list of sessions for a group
#  usage: list_sessions directory suffixes
list_sessions()
{
	local directory=$1
	shift
	local suffixes=("$@")

	local suffix n file_list

	# Generate a list of all files starting with prefix-date
	n=$(get_n_suffixes ${suffixes[*]})
	for (( i=0;i<$n;i++ ))
	do
		suffix=$(get_suffix $i ${suffixes[*]})
		file_list="$file_list $(ls ../$directory-$suffix|cut -d/ -f 3|sed -r 's/(.*)-'$suffix'.*/\1/g')"
	done

	# List all sessions

	echo -e $(echo $file_list | sed 's/ /\\n/g') | sort | uniq
}


#//  ─────────────────────────────────────────────────────────────────────────
#//  ndm_resolve_input: resolve a per-group typed input file across the
#//  canonical (.fet.N), dotted-variant (.fet.stderiv.N) and legacy-glued
#//  (.fetD.N) forms — the bash mirror of neurosuite-core
#//  neurofileio::resolveInput.  The group is always the trailing token.
#//
#//      ndm_resolve_input <base> <type> <group> [variant ...]
#//
#//  Walks the variant preference order (default "stderiv D", i.e. derived
#//  first), probing the dotted form <base>.<type>.<variant>.<group> then the
#//  legacy glued <base>.<type><variant>.<group>; the canonical form (no
#//  variant) is tried last.  Prints the first existing path, or — if none
#//  exists — the canonical path (so callers can still report it missing) and
#//  returns non-zero.
#//  ─────────────────────────────────────────────────────────────────────────
ndm_resolve_input()
{
    local base="$1" type="$2" group="$3"; shift 3
    local variants=("$@")
    [ ${#variants[@]} -eq 0 ] && variants=(stderiv D)
    local canonical="${base}.${type}.${group}"
    local v dotted glued
    for v in "${variants[@]}"; do
        if [ -z "$v" ]; then
            [ -f "$canonical" ] && { echo "$canonical"; return 0; }
            continue
        fi
        dotted="${base}.${type}.${v}.${group}"
        [ -f "$dotted" ] && { echo "$dotted"; return 0; }
        glued="${base}.${type}${v}.${group}"
        [ -f "$glued" ] && { echo "$glued"; return 0; }
    done
    [ -f "$canonical" ] && { echo "$canonical"; return 0; }
    echo "$canonical"
    return 1
}

# Extract a --method / --method=M flag from an argument list (chain-of-custody).
# Sets NDM_METHOD to the flag value (empty if absent) and NDM_ARGS to the
# remaining positional args.  Typical use in a consumer:
#     ndm_parse_method "$@"; set -- "${NDM_ARGS[@]}"
#     ndm_resolve_session "$@"
#     method=${NDM_METHOD:-$(read_script_parameter $session method)}; method=${method:-standard}
ndm_parse_method()
{
    NDM_METHOD=""
    NDM_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --method)    NDM_METHOD="$2";     shift 2 ;;
            --method=*)  NDM_METHOD="${1#*=}"; shift ;;
            *)           NDM_ARGS+=("$1");     shift ;;
        esac
    done
}

# ── Mandatory-method resolution (chain-of-custody naming) ───────────────────
# ── Chain-of-custody file relationships ─────────────────────────────────────
# The policy (classify / method_path / method_of / parse_anchor / resolve and
# the ndm_resolve_method / ndm_resolve_shared / ndm_method_from_path shims) lives
# in ndm_custody — the single bash home, mirroring custody.hpp (C++) and
# ndm_resolve_io.py (Python), kept honest by custody_vectors.tsv.
source ndm_custody

# ─────────────────────────────────────────────────────────────────────────────
# ndm_process_spikes <mode> [parameter-file] [--method M] [--methodOrder N]
#                          [--inputExtension EXT] [--force]
#
# Shared spike-processing driver for ndm_detectspikes (mode=detect) and
# ndm_extractspikes (mode=extract).  Spike times (.res) are method-independent:
#
#   detect  — run the selected engine (standard|sdiff|stderiv) in detection mode,
#             writing the shared spike times .res.<method>.N.  The engines have no
#             detect-only mode, so the .spk they also emit is discarded here;
#             detection contributes only the .res.
#   extract — re-extract waveforms (-R) at an existing shared .res, writing
#             .spk.<method>.N.  Requires a .res (from ndm_detectspikes); it never
#             detects.  Only geometry (-n/-c/-w/-p) and, for sdiff/stderiv, the
#             transform (-d/-P) are needed — the engines make the threshold/window
#             args optional under -R, so extraction carries no detection params.
#
# method / methodOrder / inputExtension are read from the CALLING program's node
# (via $program = basename $0), so detection and extraction are configured
# independently in the session file.  CLI flags override the YAML; --force
# reprocesses groups whose output already exists (overwriting it).
# ─────────────────────────────────────────────────────────────────────────────
ndm_process_spikes()
{
	local mode=$1; shift
	case "$mode" in
		detect|extract) : ;;
		*) echo_error "ndm_process_spikes: bad mode '$mode'"; exit $GENERAL_ERROR ;;
	esac

	# ── Parse command-line: <=1 positional (parameter file) + override flags ──
	local methodOverride= methodOrderOverride= inputExtensionOverride= force=
	local -a positionals=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--method)           methodOverride="$2";            shift 2 ;;
			--method=*)         methodOverride="${1#*=}";        shift ;;
			--methodOrder)      methodOrderOverride="$2";        shift 2 ;;
			--methodOrder=*)    methodOrderOverride="${1#*=}";    shift ;;
			--inputExtension)   inputExtensionOverride="$2";     shift 2 ;;
			--inputExtension=*) inputExtensionOverride="${1#*=}"; shift ;;
			--force)            force=1;                         shift ;;
			--)                 shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
			-*)                 echo_error "unknown option: $1"; exit $GENERAL_ERROR ;;
			*)                  positionals+=("$1");             shift ;;
		esac
	done
	if [ ${#positionals[@]} -gt 1 ]; then
		echo_error "usage: $program [parameter-file] [--method standard|sdiff|stderiv] [--methodOrder 0-3] [--inputExtension EXT] [--force]"
		exit $GENERAL_ERROR
	fi
	ndm_resolve_session "${positionals[@]}"
	[ "$NDM_SHIFTED" = 0 ] && positionals=("$session" "${positionals[@]}")
	param_ext=$(param_file_ext "$session")

	# ── Resolve method + methodOrder (from THIS program's node) ──────────────
	# Precedence: CLI override > YAML methodOrder/method > deprecated sdiffOrder
	# alias > built-in default.  read_script_parameter keys on $program, so
	# ndm_detectspikes and ndm_extractspikes read independent configuration.
	method=$methodOverride
	[ -z "$method" ] && method=$(read_script_parameter $session method)
	method=${method:-standard}
	# A method token is <family>[_<kind><order>] (stderiv_C4): the family picks the
	# engine, the kind says whether the session's custom sdiffPairs pattern is applied
	# (C) or deliberately not (S), and the order is the derivative order actually run.
	# Recording all three in the name means a consumer never has to infer how a file
	# was produced from parameters that may have changed since.
	ndm_check_method_token "$method" || { echo_error "$NDM_M_ERROR"; exit $GENERAL_ERROR; }
	methodFamily=$NDM_M_FAMILY
	methodKind=$NDM_M_KIND
	methodTokenOrder=$NDM_M_ORDER
	methodOrder=$methodOrderOverride
	[ -z "$methodOrder" ] && methodOrder=$(read_script_parameter $session methodOrder sdiffOrder)
	methodOrder=${methodOrder:-3}
	# A suffixed token states the order outright, so it wins over the node value:
	# stderiv_S3 IS order 3, and the filename can never disagree with the run.
	[ -n "$methodTokenOrder" ] && methodOrder=$methodTokenOrder
	case "$methodFamily" in
		standard) binary=process_extractspikes ;;
		sdiff)    binary=process_extractspikes_sdiff ;;
		stderiv)  binary=process_extractspikes_stderiv ;;
	esac

	if [ "$mode" = detect ]; then
		print_header "$session - Detecting spikes [method=$method]"
		check_commands_installed xpathReader process_medianthreshold $binary
	else
		print_header "$session - Extracting waveforms [method=$method]"
		check_commands_installed xpathReader $binary
	fi

	# Input data extension (default fil): lets a step run on an alternative,
	# externally-processed source without renaming it to .fil.  CLI > YAML > default.
	inputExtension=$inputExtensionOverride
	[ -z "$inputExtension" ] && inputExtension=$(read_script_parameter $session inputExtension)
	inputExtension=${inputExtension:-fil}
	inputs_missing "$session.$param_ext" "$session.$inputExtension" && exit $INPUTS_MISSING

	secondsToBytes() { unset LANG && echo $1 $samplingRate $nChannels $resolution | awk '{printf "%f",int($1*$2)/8*$3*$4}' | sed 's/[.].*//'; }

	# ── Read acquisition + group geometry (shared by both modes) ─────────────
	nChannels=$(yaml_read $session "//acquisitionSystem/nChannels")
	resolution=$(yaml_read $session "//acquisitionSystem/nBits")
	samplingRate=$(yaml_read $session "//acquisitionSystem/samplingRate")
	nElectrodeGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")
	check_mandatory_variable $nChannels "missing number of channels"
	check_mandatory_variable $resolution "missing resolution (in bits)"
	check_mandatory_variable $samplingRate "missing sampling rate"
	if [ $nElectrodeGroups -eq 0 ]; then echo_error "missing spike groups"; exit $GENERAL_ERROR; fi

	# Process only groups whose output is missing.  detect owns .res.<method>,
	# extract owns .spk.<method>; --force reprocesses regardless.
	local outType=res
	[ "$mode" = extract ] && outType=spk
	electrodeGroups=
	for group in $(seq 1 $nElectrodeGroups); do
		if [ -n "$force" ] || ! outputs_exist "$(ndm_method_path "$session" $outType "$group" "$method")"; then
			electrodeGroups="$electrodeGroups $group"
		fi
	done
	if [ -z "$electrodeGroups" ]; then
		echo_info "All output files already exist, nothing to do."
		exit $NO_ERROR
	fi

	# Per-group waveform geometry (uniform -w/-p) + optional custom diff pattern.
	electrodeList= ; sdiffPairsList= ; samplesInWaveform= ; peakSample=
	for electrodeGroup in $electrodeGroups; do
		electrodes=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/channels/channel")
		check_mandatory_variable $electrodes "missing electrode list for group $electrodeGroup"
		electrodes=$(echo $electrodes | sed 's/ /,/g')
		electrodeList="$electrodeList:$electrodes"
		_pairs=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/sdiffPairs")
		sdiffPairsList="$sdiffPairsList:$_pairs"
		_ns=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/nSamples")
		_ps=$(yaml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/peakSampleIndex")
		check_mandatory_variable $_ns "missing number of samples in waveform for electrode group $electrodeGroup"
		check_mandatory_variable $_ps "missing peak sample for electrode group $electrodeGroup"
		if [ -z "$samplesInWaveform" ]; then
			samplesInWaveform=$_ns
			peakSample=$_ps
		elif [ "$_ns" != "$samplesInWaveform" ] || [ "$_ps" != "$peakSample" ]; then
			echo_warning "Group $electrodeGroup has nSamples=$_ns peakSampleIndex=$_ps"
			echo_warning "  which differs from first group ($samplesInWaveform/$peakSample)."
			echo_warning "  $binary uses uniform params; using first group values."
		fi
	done
	n=$((${#electrodeList}-1)); electrodeList=${electrodeList:1:$n}
	sdiffPairsList=${sdiffPairsList#:}
	sdiffPairsArg=
	if [ "$methodFamily" = stderiv ]; then
		havePairs=0
		case "$sdiffPairsList" in *[!:]*) havePairs=1 ;; esac
		case "$methodKind" in
			C)
				if [ "$havePairs" = 0 ]; then
					echo_error "method '$method' asks for the custom difference pattern, but no spike group defines sdiffPairs."
					exit $GENERAL_ERROR
				fi
				sdiffPairsArg="-P $sdiffPairsList"
				# The engine takes the order from the pattern syntax: a reference-set spec
				# (a-b+c+d) is order 5, a single-partner spec order 4.  Refuse a token whose
				# digit disagrees rather than let the name lie.
				case "$sdiffPairsList" in
					*+*) impliedOrder=5 ;;
					*)   impliedOrder=4 ;;
				esac
				if [ -n "$methodTokenOrder" ] && [ "$methodTokenOrder" != "$impliedOrder" ]; then
					echo_error "method '$method' states order $methodTokenOrder but the session's sdiffPairs imply order $impliedOrder"
					echo_error "  (single-partner pattern = order 4; reference-set pattern using '+' = order 5)"
					exit $GENERAL_ERROR
				fi
				methodOrder=$impliedOrder
			;;
			S)
				# Explicit: run the plain derivative and leave any sdiffPairs unused.
			;;
			*)
				# Bare legacy token: historical behaviour, apply the pattern when present.
				if [ "$havePairs" = 1 ]; then
					sdiffPairsArg="-P $sdiffPairsList"
					# The pattern decides the order, so a methodOrder asking for something
					# else is not honoured.  Say so rather than quietly running a different
					# transform than the node requests.
					case "$sdiffPairsList" in
						*+*) impliedOrder=5 ;;
						*)   impliedOrder=4 ;;
					esac
					if [ "$methodOrder" != "$impliedOrder" ]; then
						echo_warning "methodOrder=$methodOrder ignored: the sdiffPairs pattern determines the order (=$impliedOrder)"
						echo_warning "  use method stderiv_C$impliedOrder to state it, or stderiv_S<order> to skip the pattern"
					fi
					methodOrder=$impliedOrder
				fi
			;;
		esac
	fi

	# ── Spatial-derivative order argument ───────────────────────────────────
	# The engines' -d accepts 0-3 ONLY; orders 4 and 5 are not selectable by number,
	# they are derived from the sdiffPairs pattern handed to -P.  So when -P is in
	# play, -d must be omitted entirely: -d is parsed (and range-checked) first, so
	# passing -d 4 alongside -P exits with "-d must be 0, 1, 2, or 3" before -P is
	# ever seen.
	sdiffOrderArg="-d $methodOrder"
	if [ -n "$sdiffPairsArg" ]; then
		sdiffOrderArg=
	elif [ "$methodFamily" != standard ]; then
		case "$methodOrder" in
			0|1|2|3) : ;;
			*) echo_error "methodOrder '$methodOrder' cannot be requested by number for method '$method' (-d accepts 0-3)"
			   echo_error "  orders 4 and 5 ARE the custom-pattern forms and come from the pattern itself:"
			   echo_error "  define sdiffPairs on the spike groups, then use method stderiv_C4 (single-partner)"
			   echo_error "  or stderiv_C5 (reference-set, written with '+')"
			   exit $GENERAL_ERROR ;;
		esac
	fi

	# ── Detection-only parameters: threshold factor + noise window ───────────
	# Not read in extract mode — under -R the engines make -f/-B/-Z/-r optional.
	if [ "$mode" = detect ]; then
		thresholdFactor=$(read_script_parameter $session thresholdFactor)
		refractoryPeriod=$(read_script_parameter $session refractoryPeriod)
		peakSearchLength=$(read_script_parameter $session peakSearchLength)
		start=$(read_script_parameter $session start)
		duration=$(read_script_parameter $session duration)
		check_mandatory_variable $thresholdFactor "missing threshold factor"
		check_mandatory_variable $refractoryPeriod "missing refractory period"
		check_mandatory_variable $peakSearchLength "missing peak search window length"
		check_mandatory_variable $start "missing starting point for threshold computation"
		check_mandatory_variable $duration "missing duration for threshold computation"
		startInBytes=$(secondsToBytes $start)
		durationInBytes=$(secondsToBytes $duration)
	fi
	memCapGB=$(read_script_parameter $session memCapGB)

	echo_info "Processing channels $electrodeList"
	[ "$methodFamily" != standard ] && echo_info " Spatial derivative order   : $methodOrder"
	[ -n "$sdiffPairsArg" ] && echo_info " Custom difference patterns : $sdiffPairsList"
	if [ "$methodKind" = S ] && [ "$havePairs" = 1 ]; then
		echo_info " Custom difference patterns : not applied (method $method)"
	fi

	# Temporary symlink so partial-run outputs cannot clobber good files.
	tmp=$session-$mode-tmp
	ln -s "$session.$inputExtension" $tmp.fil
	export PROCESS_EXTRACTSPIKES_MEM_CAP_GB=${memCapGB:-2}

	# ── extract: require an existing shared .res (never detect) ──────────────
	# ndm_resolve_any locates a group's shared .res (this method first, then any
	# other method, then untagged).  Copied into the temp slot and left untouched.
	if [ "$mode" = extract ]; then
		declare -i i=0
		for group in $electrodeGroups; do
			r=$(ndm_resolve_any "$session" res "$group" "$method")
			if [ -z "$r" ] || [ $(( $(wc -c < "$r") % 8 )) -ne 0 ]; then
				rm -f $tmp.fil
				echo_error "no valid shared .res for group $group — run ndm_detectspikes first"
				exit $INPUTS_MISSING
			fi
			i=$i+1
			cp "$r" $tmp.res.$i
		done
		echo_info " Re-extracting waveforms at existing spike times (-R)"
	fi

	# ── Dispatch to the engine.  standard computes the threshold externally
	# (process_medianthreshold -> -t); sdiff/stderiv compute it internally from
	# the noise window (-f/-B/-Z) and take the derivative order -d.  In extract
	# mode only geometry (+ transform) is passed and -R selects re-extraction.
	case "$methodFamily" in
		standard)
			if [ "$mode" = detect ]; then
				echo_info " Threshold factor           : $thresholdFactor"
				echo_info " 1. Computing thresholds (process_medianthreshold)"
				baseline=$(tail -c +$(($startInBytes+1)) "$session.$inputExtension" | head -c $durationInBytes | process_medianthreshold -s $durationInBytes -n $nChannels -c $electrodeList)
				check_command_status process_medianthreshold
				baseline=$(unset LANG && echo $baseline | awk 'BEGIN{RS=":";FS=","};{for (i=1;i<=NF;i++){printf "%f,",$i*'$thresholdFactor'};printf ":"}' | sed 's/,:/:/g;s/:$//')
				echo_info "    threshold $baseline"
				echo_info " 2. Detecting + extracting spike waveforms"
				process_extractspikes \
					-n $nChannels -c $electrodeList \
					-w $samplesInWaveform -p $peakSample \
					-t $baseline -l $peakSearchLength -r $refractoryPeriod \
					$tmp
			else
				process_extractspikes \
					-n $nChannels -c $electrodeList \
					-w $samplesInWaveform -p $peakSample \
					-R $tmp
			fi
			;;
		sdiff|stderiv)
			if [ "$mode" = detect ]; then
				echo_info " Threshold factor           : $thresholdFactor"
				echo_info " Detecting + extracting spike waveforms"
				$binary \
					-n $nChannels -c $electrodeList \
					-w $samplesInWaveform -p $peakSample \
					-r $refractoryPeriod -l $peakSearchLength \
					-f $thresholdFactor -B $startInBytes -Z $durationInBytes \
					$sdiffOrderArg $sdiffPairsArg \
					$tmp
			else
				$binary \
					-n $nChannels -c $electrodeList \
					-w $samplesInWaveform -p $peakSample \
					$sdiffOrderArg $sdiffPairsArg \
					-R $tmp
			fi
			;;
	esac
	check_command_status $binary

	# ── Write back temp (untagged) outputs to final method-tagged names ──────
	rm $tmp.fil
	declare -i i=0
	for group in $electrodeGroups; do
		i=$i+1
		if [ "$mode" = detect ]; then
			# Detection writes the session's shared spike times; discard the .spk
			# it also produced (no detect-only engine mode) so detection
			# contributes only the .res.
			mv $tmp.res.$i "$(ndm_method_path "$session" res "$group" "$method")"
			rm -f $tmp.spk.$i
		else
			# Reused the shared .res unchanged; produce only the waveform file.
			rm -f $tmp.res.$i
			mv $tmp.spk.$i "$(ndm_method_path "$session" spk "$group" "$method")"
		fi
	done
}
