#!/usr/bin/env python3

#////////////////////////////////////////////////////////////////////////////
#//
#//   Subtract spike waveforms from a raw .dat recording.
#//
#//   Subtraction pipeline — four modes:
#//
#//   raw (Layer 0) — raw waveform subtraction  (--subtraction-mode raw)
#//     Each spike's raw .spk snippet is subtracted directly.  Near-exact
#//     cancellation at spike windows; produces a "hole" in the noise
#//     baseline.  Optimal for the strip-good → re-detect workflow since
#//     residuals fall far below detection threshold.  Skips all modelling.
#//
#//   model — Layer 1 / Layer 2  (--subtraction-mode model)
#//
#//     Layer 1 — projection-based per-cluster template  (few spikes)
#//       Per-cluster mean template, scaled by optimal L2 projection onto
#//       the observed waveform.  ISI-based dual templates (L1b) handle
#//       burst shape change when enough spikes exist to split.
#//
#//     Layer 2 — asymmetric-exponential PC1 model  (sufficient spikes)
#//       PC1 of the cluster's spike population directly captures the
#//       dominant axis of waveform shape variation.  Both the mean
#//       waveform and the PC1 direction are represented as sums of
#//       asymmetric exponential terms (one term per component per
#//       channel) fitted by nonlinear least squares.  The per-spike
#//       subtraction template is the continuous family
#//
#//         T(t; obs_wf) = T_mean(t)  +  pc1_score(obs_wf) * T_pc1(t)
#//
#//       where pc1_score is measured directly from the observed waveform.
#//     Preserves noise baseline — good for LFP extraction.
#//
#//   botm — Bayes-Optimal Template Matching  (--subtraction-mode botm)
#//     Proepper 2015, §3.4.  Generative model x = Σ_i Σ_τ s^i_{t-τ}·ξ^i_τ
#//     + η with η ~ N(0, C).  Noise covariance C is estimated from
#//     between-spike periods using per-period weighted average (Proepper's
#//     stitching-pitfall avoidance).  Per-cluster matched filter
#//     f^i := C^(-1)·ξ^i.  Bayes-optimal residual-minimising amplitude
#//     for spike i at observation x is
#//
#//       a(i) = (x^T · f^i) / (ξ^i^T · f^i)
#//
#//     with no clamp (the denominator normalises template energy under
#//     the whitened metric).  Closes the "implicit white noise" gap in
#//     model mode; preserves baseline.  Slower than model mode because
#//     of one-time C estimation + inversion per group.  SIC overlap
#//     handling not included in this version.
#//
#//   Contamination robustness
#//   ────────────────────────
#//   Concomitant spikes from other neurons whose waveform windows overlap
#//   spike i's window corrupt both template estimation and per-spike
#//   projection.  Two complementary measures are applied:
#//
#//   (a) Template building — exclusion of contaminated spikes
#//       A spike is labelled contaminated if any other spike (any cluster)
#//       falls within ±nSamples samples of it.  Only uncontaminated spikes
#//       are used to compute the cluster mean template and PCA decomposition.
#//       If fewer than min_clean_spikes uncontaminated spikes remain, the
#//       cluster falls back to all spikes with a trimmed-mean estimator
#//       (drops the 10% most outlying waveforms by L2 distance to the mean).
#//
#//   (b) Per-spike observation cleaning — neighbour template subtraction
#//       Before projecting spike i onto its template, the mean template of
#//       every overlapping spike j from a *different* cluster is subtracted
#//       from the observed waveform at the overlap region.  This reduces
#//       the per-spike PC1 score error by ~40× (see validation tests).
#//       The PC1 score is then clamped to the [0.5th, 99.5th] percentile
#//       range observed during template building to guard against residuals
#//       from imperfect neighbour subtraction.
#//
#//   I/O model (V-Cache-aware chunk processing)
#//   -------------------------------------------
#//   Single sequential pass; one contiguous read + one contiguous write
#//   per CHUNK_LEN-frame chunk.  Chunks with no spike overlap are skipped.
#//
#//   copyright       (C) 2025 neurosuite-3 contributors
#//
#//   GNU GPL v3 or later.
#//
#////////////////////////////////////////////////////////////////////////////
#//
#//  Usage
#//  -----
#//  process_subtractspikes -n nChannels [-b nBits] [-s samplingRate]
#//      [--no-burst-correction] [--min-template-spikes N]
#//      [--burst-isi-threshold-ms T] [--min-exp-spikes N]
#//      [--exp-terms K] [--min-clean-frac F] [--chunk-frames N]
#//      input.dat output.dat spec1 [spec2 ...]
#//
#//  Spec format (5, 6, 7, or 8 colon-separated fields):
#//    resfile:spkfile[:clufile]:ch0,ch1,...:nSamples:peakSample
#//                                           [:driftfile[:strip_spec]]
#//
#//  clufile   = '-' disables cluster-based modelling for that group
#//              (Layer 0: raw waveform subtraction only).
#//  driftfile = '-' or missing disables drift compensation for that group.
#//  strip_spec controls which clusters get subtracted:
#//    '-' or missing   strip every cluster except 0 (artefact) and 1 (MUA)
#//                     — the neurosuite convention default.
#//    'all'            strip every cluster including noise/MUA.
#//    '2,3,5'          strip only the listed cluster ids.
#//    '@file'          read one integer cluster id per line from file.
#//
#//  Cluster models are still built for EVERY cluster that appears in
#//  .clu (not just the ones being stripped), because the neighbour-
#//  template observation cleaner needs them to subtract overlapping
#//  contributions from adjacent non-stripped clusters' spikes before
#//  projecting each stripped spike onto its own template.
#//
#////////////////////////////////////////////////////////////////////////////

import sys
import os
import math
import argparse
import shutil
import warnings
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

import numpy as np

try:
    from scipy.optimize import curve_fit as _scipy_curve_fit
    HAS_SCIPY = True
except ImportError:
    HAS_SCIPY = False

# ──────────────────────────────────────────────────────────────────────────────
# Constants
# ──────────────────────────────────────────────────────────────────────────────

DEFAULT_SR               = 20_000
DEFAULT_MIN_TPL_SPIKES   = 5
DEFAULT_MIN_EXP_SPIKES   = 30
DEFAULT_BURST_ISI_MS     = 50.0
DEFAULT_EXP_TERMS        = 2
DEFAULT_MIN_CLEAN_FRAC   = 0.30   # fall back to trimmed-mean below this
TRIMMED_MEAN_FRAC        = 0.10   # drop top 10% outliers in trimmed mean
MIN_SPIKES_BURST_FIT     = 30
SCALE_MIN                = 0.0
SCALE_MAX                = 3.0
EXP_FIT_MAX_RMS_FRAC     = 0.15   # quality gate for exponential fits
PC1_SCORE_CLIP_PERCENTILE = 0.5   # clip to [0.5th, 99.5th] of training scores
VCACHE_BYTES             = 96 * 1024 * 1024
VCACHE_TARGET_FRAC       = 0.70


# ──────────────────────────────────────────────────────────────────────────────
# CLI
# ──────────────────────────────────────────────────────────────────────────────

def build_parser():
    p = argparse.ArgumentParser(formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('-n', type=int, required=True, metavar='nChannels')
    p.add_argument('-b', type=int, default=16, metavar='nBits', choices=[8, 16, 32])
    p.add_argument('-s', type=float, default=None, metavar='samplingRate')
    p.add_argument('--subtraction-mode', choices=['model', 'raw', 'botm'],
                   default='model',
                   help='"model" (default): cluster-aware Layer 1/2 template '
                        'subtraction — preserves noise baseline at spike windows, '
                        'suitable for LFP extraction.  "raw": subtract the raw '
                        '.spk.N waveform directly (Layer 0) — near-exact '
                        'cancellation, optimal for the strip-good-re-detect '
                        'workflow.  "botm": Bayes-Optimal Template Matching '
                        'amplitude subtraction (Proepper 2015) — per-cluster '
                        'mean template subtracted with a matched-filter amplitude '
                        '`(obs^T · C^(-1) · ξ) / (ξ^T · C^(-1) · ξ)` computed '
                        'from the noise covariance.  Closes the "implicit white-noise" '
                        'gap in model mode at the cost of estimating C once per '
                        'group.  Cluster-id filtering applies in all modes.')
    p.add_argument('--botm-ridge', type=float, default=1e-3,
                   help='Ridge regularization applied to the noise covariance '
                        'before inversion in BOTM mode (fraction of trace(C)/dim '
                        'added to the diagonal).  Default 1e-3.')
    p.add_argument('--no-burst-correction', action='store_true')
    p.add_argument('--min-template-spikes', type=int, default=DEFAULT_MIN_TPL_SPIKES)
    p.add_argument('--burst-isi-threshold-ms', type=float, default=DEFAULT_BURST_ISI_MS)
    p.add_argument('--min-exp-spikes', type=int, default=DEFAULT_MIN_EXP_SPIKES)
    p.add_argument('--exp-terms', type=int, default=DEFAULT_EXP_TERMS)
    p.add_argument('--min-clean-frac', type=float, default=DEFAULT_MIN_CLEAN_FRAC,
                   help='Minimum fraction of uncontaminated spikes required to use '
                        'exclusion-based template estimation; fall back to trimmed-mean '
                        f'below this (default: {DEFAULT_MIN_CLEAN_FRAC})')
    p.add_argument('--chunk-frames', type=int, default=None)
    p.add_argument('input_dat',  metavar='input.dat')
    p.add_argument('output_dat', metavar='output.dat')
    p.add_argument('specs', nargs='+', metavar='spec')
    return p


def _parse_strip_spec(spec_str, clufile):
    """
    Parse the strip-cluster specification for one group.

    Accepts:
      None, '', '-'      → default: strip every cluster except 0 and 1
      'all' / 'ALL'      → strip every cluster (including noise/MUA)
      '2,3,5'            → strip only the listed cluster ids
      '@path/to/file'    → read one integer cluster id per line from file

    Returns: (strip_set, mode)
      strip_set : frozenset[int] of cluster ids to strip, or None meaning
                  "strip every cluster that appears in .clu"
      mode      : human-readable string for logging
    """
    if spec_str is None or spec_str in ('', '-'):
        return ('NON_NOISE', 'strip non-noise clusters (exclude 0, 1)')
    if spec_str.lower() == 'all':
        return (None, 'strip ALL clusters (including noise/MUA)')
    if spec_str.startswith('@'):
        path = spec_str[1:]
        if not os.path.isfile(path):
            raise ValueError(
                f'strip-cluster file {path!r} referenced by {clufile!r} '
                f'not found')
        ids = []
        with open(path) as fh:
            for ln in fh:
                ln = ln.strip()
                if not ln or ln.startswith('#'):
                    continue
                try:
                    ids.append(int(ln))
                except ValueError:
                    raise ValueError(
                        f'{path!r}: non-integer line {ln!r}')
        if not ids:
            raise ValueError(f'{path!r}: no cluster ids found')
        return (frozenset(ids), f'strip {len(ids)} ids from {os.path.basename(path)}')
    # Comma-separated integer list
    ids = []
    for tok in spec_str.split(','):
        tok = tok.strip()
        if not tok:
            continue
        try:
            ids.append(int(tok))
        except ValueError:
            raise ValueError(
                f'invalid cluster id {tok!r} in strip-cluster spec '
                f'{spec_str!r}')
    if not ids:
        raise ValueError(f'empty strip-cluster list {spec_str!r}')
    return (frozenset(ids), f'strip explicit ids: {sorted(ids)}')


def parse_group_spec(spec):
    """Parse a group spec.  Accepted formats:

      5 fields: resfile:spkfile:ch0,...:nSamples:peakSample
      6 fields: resfile:spkfile:clufile:ch0,...:nSamples:peakSample
      7 fields: resfile:spkfile:clufile:ch0,...:nSamples:peakSample:driftfile
      8 fields: resfile:spkfile:clufile:ch0,...:nSamples:peakSample:driftfile:strip_spec

    driftfile='-' disables drift correction for that group.
    strip_spec controls which clusters get subtracted; see _parse_strip_spec.
    When the 8th field is missing, the default is "strip all clusters except
    0 and 1" — the neurosuite convention for artefact/MUA.
    """
    parts = spec.split(':')
    drift_path = None
    strip_spec = None
    if   len(parts) == 5:
        resfile, spkfile, channels_str, nsamples_str, peaksample_str = parts
        clufile = '-'
    elif len(parts) == 6:
        resfile, spkfile, clufile, channels_str, nsamples_str, peaksample_str = parts
    elif len(parts) == 7:
        resfile, spkfile, clufile, channels_str, nsamples_str, peaksample_str, drift_path = parts
    elif len(parts) == 8:
        (resfile, spkfile, clufile, channels_str, nsamples_str,
         peaksample_str, drift_path, strip_spec) = parts
    else:
        raise ValueError(f'Expected 5, 6, 7, or 8 colon-separated fields: {spec!r}')
    if drift_path in ('-', '', None):
        drift_path = None
    strip_set, strip_mode = _parse_strip_spec(strip_spec, clufile)
    return (resfile, spkfile, clufile,
            list(map(int, channels_str.split(','))),
            int(nsamples_str), int(peaksample_str),
            drift_path, strip_set, strip_mode)


# ──────────────────────────────────────────────────────────────────────────────
# .clu reader
# ──────────────────────────────────────────────────────────────────────────────

def load_clu(clufile):
    """
    Read a .clu.N file, handling both formats:

      - Binary (written by KlustaKwik and Klusters since the neurosuite-3
        modernization): int32 nClusters header + nSpikes × int32 cluster ids.
      - Legacy text: first line = nClusters, subsequent lines = one id per
        line as decimal text.

    Auto-detects by peeking the first four bytes: a binary header will
    always be a small positive integer with high bytes zero, while a text
    file's first bytes will be ASCII digits.
    """
    with open(clufile, 'rb') as fh:
        first4 = fh.read(4)
    if len(first4) < 4:
        raise RuntimeError(f'{clufile!r}: file too short ({len(first4)} bytes)')

    # Heuristic: binary i32 header — high-order bytes are zero for any
    # plausible cluster-count value (< 2^24 ≈ 16M clusters).  Text files
    # start with ASCII digits 0x30–0x39, newlines, or whitespace.
    looks_binary = (first4[1] == 0 and first4[2] == 0 and first4[3] == 0)
    if not looks_binary:
        looks_binary = not all(b in b'0123456789 \t\n\r' for b in first4)

    if looks_binary:
        raw = np.fromfile(clufile, dtype='<i4')
        if raw.size < 1:
            raise RuntimeError(f'{clufile!r}: empty file')
        return raw[1:].copy()            # skip nClusters header

    # Text fallback
    with open(clufile, 'r') as fh:
        lines = [l.strip() for l in fh if l.strip()]
    if not lines:
        raise RuntimeError(f'{clufile!r}: empty file')
    return np.array([int(x) for x in lines[1:]], dtype=np.int32)


# ──────────────────────────────────────────────────────────────────────────────
# Drift interpolation and spatial template correction
# ──────────────────────────────────────────────────────────────────────────────

def load_drift_signal(drift_path: str,
                      n_total_samples: int) -> Optional[np.ndarray]:
    """
    Load a binary int16 drift signal file (session.dat.drift.N).

    The file contains one int16 value per sample of the recording, in µm,
    relative to the reference window (0 µm at the reference time).
    Positive values indicate the probe drifted deeper into tissue.

    Returns a (n_total_samples,) int16 array, or None on error.
    """
    if not os.path.exists(drift_path):
        print(f'process_subtractspikes: drift file not found: {drift_path!r} '
              '— drift correction disabled for this group', file=sys.stderr)
        return None
    arr = np.fromfile(drift_path, dtype='<i2')
    if len(arr) == 0:
        print(f'process_subtractspikes: drift file empty: {drift_path!r}',
              file=sys.stderr)
        return None
    if len(arr) != n_total_samples:
        print(f'process_subtractspikes: drift file {drift_path!r} has '
              f'{len(arr)} samples, expected {n_total_samples} — '
              f'truncating/padding', file=sys.stderr)
        if len(arr) > n_total_samples:
            arr = arr[:n_total_samples]
        else:
            arr = np.pad(arr, (0, n_total_samples - len(arr)),
                         constant_values=arr[-1])
    lo, hi = int(arr.min()), int(arr.max())
    print(f'process_subtractspikes: drift loaded from {os.path.basename(drift_path)}: '
          f'range [{lo}, {hi}] µm  ({len(arr)} samples)',
          file=sys.stderr)
    return arr


def shift_template_fast(tmpl: np.ndarray,
                        delta_um: float,
                        site_depths: np.ndarray) -> np.ndarray:
    """
    Shift a waveform template along the depth (channel) axis by delta_um µm.

    This corrects for the spatial displacement of the probe relative to the
    neurons since the template reference window.  Positive delta_um means the
    probe drifted deeper into tissue (neurons appear on shallower channels).

    For each output channel ci at depth d_ci, the template value is
    interpolated from the depth (d_ci + delta_um) in the original template's
    coordinate frame.  Channels that map outside the array are zeroed.

    Parameters
    ----------
    tmpl        : (nSamples, nChanGrp) float32 template
    delta_um    : spatial shift in µm  (drift(t_spike) − drift(t_ref))
    site_depths : (nChanGrp,) electrode site depths in µm (sorted ascending)

    Returns
    -------
    shifted : (nSamples, nChanGrp) float32
    """
    if abs(delta_um) < 0.1 or len(site_depths) < 2:
        return tmpl   # sub-0.1 µm shift not worth the compute

    nS, nC = tmpl.shape
    spacing = float(np.median(np.diff(np.sort(site_depths))))
    if spacing < 1e-6:
        return tmpl

    d0    = float(site_depths[0])
    idx_f = (site_depths + delta_um - d0) / spacing   # (nC,) fractional source index
    lo    = np.floor(idx_f).astype(int)
    hi    = lo + 1
    frac  = (idx_f - lo).astype(np.float32)
    valid = (lo >= 0) & (hi < nC)
    lo_c  = np.clip(lo, 0, nC - 1)
    hi_c  = np.clip(hi, 0, nC - 1)

    # tmpl: (nS, nC); index columns by lo_c and hi_c
    shifted = tmpl[:, lo_c] * (1.0 - frac) + tmpl[:, hi_c] * frac
    shifted[:, ~valid] = 0.0
    return shifted.astype(np.float32)


# ──────────────────────────────────────────────────────────────────────────────
# Contamination detection
# ──────────────────────────────────────────────────────────────────────────────

def find_clean_mask(spike_times: np.ndarray, nSamples: int) -> np.ndarray:
    """
    Return a boolean array (nSpikes,) where True means the spike's waveform
    window does NOT overlap with any other spike's window.

    Two spikes i and j overlap when |t_i - t_j| < nSamples.  A spike is
    flagged regardless of whether the neighbour belongs to the same cluster
    or a different one — any overlap corrupts the recorded waveform snippet.

    Vectorized O(n log n) implementation — sort once, then do two
    searchsorted calls on the entire sorted array at once.  Roughly
    100-500× faster than the previous per-spike Python loop on typical
    200k-spike sessions.
    """
    n = len(spike_times)
    if n == 0:
        return np.zeros(0, dtype=bool)

    sort_idx = np.argsort(spike_times)
    st       = spike_times[sort_idx]               # sorted times
    lo       = np.searchsorted(st, st - nSamples + 1, 'left')
    hi       = np.searchsorted(st, st + nSamples,     'right')
    contaminated_sorted = (hi - lo) > 1             # at least one neighbour

    clean = np.ones(n, dtype=bool)
    clean[sort_idx] = ~contaminated_sorted
    return clean


def trimmed_mean_waveforms(spk_f: np.ndarray, frac: float = TRIMMED_MEAN_FRAC
                           ) -> np.ndarray:
    """
    Per-spike-array robust mean: compute the initial mean, then drop the
    `frac` fraction of spikes furthest from it (by L2 distance) and
    recompute.  Returns (nSamples, nChanGrp) float32.
    """
    n = len(spk_f)
    if n <= 2:
        return spk_f.mean(axis=0)
    mean0 = spk_f.mean(axis=0)
    dists = np.sum((spk_f.reshape(n, -1) - mean0.ravel()) ** 2, axis=1)
    n_drop = max(1, int(n * frac))
    keep   = np.argsort(dists)[:n - n_drop]
    return spk_f[keep].mean(axis=0)


def robust_spk_subset(spk_c: np.ndarray, clean_mask: np.ndarray,
                      min_clean_frac: float, cid: int
                      ) -> Tuple[np.ndarray, str]:
    """
    Return (subset_for_template, method_tag).

    Priority:
      1. uncontaminated spikes  (clean_mask True) — if >= min_clean_frac
      2. trimmed mean on all spikes               — otherwise
    """
    n_clean = int(clean_mask.sum())
    n_total = len(clean_mask)
    clean_frac = n_clean / max(n_total, 1)

    if clean_frac >= min_clean_frac:
        subset = spk_c[clean_mask]
        tag    = f'excl-contam ({n_clean}/{n_total} clean spikes)'
    else:
        subset = spk_c           # trimmed mean is applied later
        tag    = (f'trimmed-mean fallback '
                  f'(only {n_clean}/{n_total} clean = '
                  f'{clean_frac:.0%} < {min_clean_frac:.0%})')
    return subset, tag


# ──────────────────────────────────────────────────────────────────────────────
# Neighbour-template observation cleaning
# ──────────────────────────────────────────────────────────────────────────────

def clean_obs_waveform(obs_wf_full: np.ndarray,
                       spike_idx:   int,
                       grp) -> np.ndarray:
    """
    Remove expected contributions of overlapping spikes from OTHER clusters
    from the observed waveform snippet before projection.

    obs_wf_full : (nSamples, nChanGrp) float32 — raw .spk snippet for spike i
    spike_idx   : index into grp.spike_times / grp.clu_ids
    grp         : GroupData — must have sorted_times, sorted_clu, sorted_sort_idx

    For each spike j (j ≠ spike_idx, different cluster) whose window overlaps
    spike i's window, the cluster-j mean template is subtracted from the
    overlap region of obs_wf_full.

    Returns a (nSamples, nChanGrp) float32 cleaned copy.
    """
    if not grp.use_clusters:
        return obs_wf_full

    nSamples   = grp.nSamples
    peakSample = grp.peakSample
    t_i        = int(grp.spike_times[spike_idx])
    cid_i      = int(grp.clu_ids[spike_idx])
    t_i_start  = t_i - peakSample
    t_i_end    = t_i_start + nSamples

    # Binary search for overlapping spikes: |t_j - t_i| < nSamples
    st  = grp.sorted_times
    lo  = int(np.searchsorted(st, t_i - nSamples + 1, 'left'))
    hi  = int(np.searchsorted(st, t_i + nSamples,     'right'))

    if hi - lo <= 1:
        return obs_wf_full          # no neighbours — nothing to clean

    cleaned = obs_wf_full.copy()

    for jj in range(lo, hi):
        j    = int(grp.sorted_sort_idx[jj])
        if j == spike_idx:
            continue
        cid_j = int(grp.sorted_clu[jj])
        if cid_j == cid_i:
            continue                # same cluster — skip

        model_j = grp.cluster_models.get(cid_j)
        if model_j is None:
            continue

        t_j       = int(st[jj])
        t_j_start = t_j - peakSample
        t_j_end   = t_j_start + nSamples

        # Overlap in absolute sample coordinates
        ov_start  = max(t_i_start, t_j_start)
        ov_end    = min(t_i_end,   t_j_end)
        if ov_end <= ov_start:
            continue

        # Local indices in obs_wf_full and in model_j's template
        i_lo   = ov_start - t_i_start
        i_hi   = ov_end   - t_i_start
        j_lo   = ov_start - t_j_start
        j_hi   = ov_end   - t_j_start

        # Use the cluster-j mean template (T_mean is always defined)
        tmpl_j = model_j.template   # (nSamples, nChanGrp) float32

        cleaned[i_lo:i_hi, :] -= tmpl_j[j_lo:j_hi, :]

    return cleaned


# ──────────────────────────────────────────────────────────────────────────────
# Layer 2 — asymmetric-exponential PC1 waveform model
# ──────────────────────────────────────────────────────────────────────────────

def _asym_exp_component(t_ms: np.ndarray, A: float, mu_ms: float,
                        tau_rise: float, tau_fall: float) -> np.ndarray:
    tau_r = abs(tau_rise) + 1e-6
    tau_f = abs(tau_fall) + 1e-6
    w     = np.empty_like(t_ms)
    left  = t_ms < mu_ms
    w[ left] = A * np.exp( (t_ms[ left] - mu_ms) / tau_r)
    w[~left] = A * np.exp(-(t_ms[~left] - mu_ms) / tau_f)
    return w


def _multi_asym_exp(t_ms: np.ndarray, *params) -> np.ndarray:
    K   = len(params) // 4
    out = np.zeros_like(t_ms)
    for k in range(K):
        out += _asym_exp_component(t_ms, *params[4*k:4*k+4])
    return out


def _auto_init_params(t_ms: np.ndarray, wf: np.ndarray, K: int) -> List:
    extrema = np.where(np.diff(np.sign(np.diff(wf))))[0] + 1
    if len(extrema) == 0:
        extrema = np.array([np.argmax(np.abs(wf))])
    extrema = extrema[np.argsort(-np.abs(wf[extrema]))][:K]
    if len(extrema) < K:
        extra   = np.linspace(0, len(t_ms)-1, K - len(extrema), dtype=int)
        extrema = np.concatenate([extrema, extra])
    dt = float(t_ms[1] - t_ms[0]) if len(t_ms) > 1 else 1.0
    p0 = []
    for idx in extrema[:K]:
        p0.extend([float(wf[idx]), float(t_ms[idx]),
                   max(2.0*dt, 0.2), max(2.0*dt, 0.5)])
    return p0


def _fit_exp_1ch(t_ms: np.ndarray, wf: np.ndarray, K: int
                 ) -> Tuple[Optional[np.ndarray], np.ndarray]:
    """Fit K asymmetric exponential terms to one channel.  Returns (params|None, fitted)."""
    peak_amp = float(np.abs(wf).max())
    if peak_amp < 1e-6 or not HAS_SCIPY:
        return None, wf.copy()
    t_range = float(t_ms[-1] - t_ms[0])
    p0      = _auto_init_params(t_ms, wf, K)
    lo = [-1e5, t_ms[0]-t_range, 1e-6, 1e-6] * K
    hi = [ 1e5, t_ms[-1]+t_range, t_range*2, t_range*2] * K
    with warnings.catch_warnings():
        warnings.simplefilter('ignore')
        try:
            popt, _ = _scipy_curve_fit(_multi_asym_exp, t_ms, wf,
                                       p0=p0, bounds=(lo, hi),
                                       maxfev=8000, ftol=1e-6, xtol=1e-6)
        except Exception:
            return None, wf.copy()
    fitted = _multi_asym_exp(t_ms, *popt)
    if np.sqrt(np.mean((fitted - wf)**2)) > EXP_FIT_MAX_RMS_FRAC * peak_amp:
        return None, wf.copy()    # quality gate — raw fallback
    return popt, fitted


class ExponentialWaveformModel:
    """
    Layer 2 spike shape model: sum-of-asymmetric-exponentials parameterized
    by PC1, estimated from contamination-free spikes only.

    Model
    ─────
      T(t; obs_wf) = T_mean(t)  +  clip(pc1_score(obs_wf)) * T_pc1(t)

    pc1_score is measured from the (previously neighbour-cleaned) observed
    waveform and clamped to the [0.5th, 99.5th] percentile of training
    scores to guard against residual contamination.
    """

    def __init__(self, cid: int,
                 spk_c:     np.ndarray,   # (n_c, nSamples, nChanGrp) float32 — ALL spikes
                 clean_mask: np.ndarray,  # (n_c,) bool — uncontaminated subset
                 peakSample: int,
                 samplingRate: float,
                 K: int = 2,
                 min_clean_frac: float = DEFAULT_MIN_CLEAN_FRAC):
        self.cid      = cid
        self.valid    = False
        self.K        = K

        n_c, nSamples, nChanGrp = spk_c.shape
        self.nSamples  = nSamples
        self.nChanGrp  = nChanGrp

        dt_ms     = 1000.0 / samplingRate
        self.t_ms = (np.arange(nSamples) - peakSample) * dt_ms

        # ── Select clean subset for PCA & template fitting ────────────────
        clean_subset, self.clean_tag = robust_spk_subset(
            spk_c, clean_mask, min_clean_frac, cid)
        n_clean = len(clean_subset)
        self.n_clean = n_clean

        # For trimmed-mean fallback: apply trimming during mean computation
        using_trimmed = (n_clean == n_c)   # True when we couldn't exclude
        if using_trimmed:
            mean_wf_2d = trimmed_mean_waveforms(clean_subset)
        else:
            mean_wf_2d = clean_subset.mean(axis=0)

        # ── PCA on clean subset ───────────────────────────────────────────
        D  = nSamples * nChanGrp
        W  = clean_subset.reshape(n_clean, D).astype(np.float64)
        Wc = W - mean_wf_2d.ravel()

        try:
            U, s, Vt = np.linalg.svd(Wc, full_matrices=False)
        except np.linalg.LinAlgError:
            return

        pc1_vec    = Vt[0]
        pc1_scores = U[:, 0] * s[0]

        # Canonicalize sign: PC1 aligns with the leading channel
        mean_flat   = mean_wf_2d.reshape(nSamples, nChanGrp)
        pc1_shaped  = pc1_vec.reshape(nSamples, nChanGrp)
        lead_ch     = int(np.argmax(np.abs(mean_flat).max(axis=0)))
        if np.dot(pc1_shaped[:, lead_ch], mean_flat[:, lead_ch]) < 0:
            pc1_vec    = -pc1_vec
            pc1_scores = -pc1_scores

        # ── Score range for clamping (contamination guard) ────────────────
        self._score_lo = float(np.percentile(pc1_scores, PC1_SCORE_CLIP_PERCENTILE))
        self._score_hi = float(np.percentile(pc1_scores, 100 - PC1_SCORE_CLIP_PERCENTILE))

        # ── Fit exponential model per channel ─────────────────────────────
        mean_ch = mean_wf_2d                     # (nSamples, nChanGrp) float32
        pc1_ch  = pc1_vec.reshape(nSamples, nChanGrp)  # (nSamples, nChanGrp) float64

        self._mean_eval = np.zeros((nSamples, nChanGrp), np.float32)
        self._pc1_eval  = np.zeros((nSamples, nChanGrp), np.float32)
        n_fitted        = 0
        for ch in range(nChanGrp):
            popt_mean, ev_mean = _fit_exp_1ch(
                self.t_ms, mean_ch[:, ch].astype(np.float64), K)
            popt_pc1,  ev_pc1  = _fit_exp_1ch(
                self.t_ms, pc1_ch[:, ch],                     K)
            self._mean_eval[:, ch] = ev_mean.astype(np.float32)
            self._pc1_eval [:, ch] = ev_pc1 .astype(np.float32)
            if popt_mean is not None:
                n_fitted += 1

        self._mean_wf_flat = mean_wf_2d.ravel().astype(np.float64)
        self._pc1_vec      = pc1_vec.astype(np.float64)
        self.n_fitted_ch   = n_fitted
        self.valid         = True

    def pc1_score(self, obs_wf: np.ndarray) -> float:
        """
        Project obs_wf onto PC1 and clamp to the training score range.
        obs_wf : (nSamples, nChanGrp) float32/int16
        """
        raw = float(np.dot(obs_wf.ravel().astype(np.float64) - self._mean_wf_flat,
                           self._pc1_vec))
        return float(np.clip(raw, self._score_lo, self._score_hi))

    def get_template(self, obs_wf: np.ndarray) -> np.ndarray:
        """Return the PC1-conditioned subtraction template: (nSamples, nChanGrp) f32."""
        score = self.pc1_score(obs_wf)
        return (self._mean_eval + score * self._pc1_eval).astype(np.float32)

    def project_and_template(self, obs_wf: np.ndarray) -> Tuple[float, np.ndarray]:
        T     = self.get_template(obs_wf)
        tf    = T.ravel().astype(np.float64)
        denom = float(np.dot(tf, tf))
        if denom < 1e-6:
            return 1.0, T
        k = float(np.clip(
            np.dot(obs_wf.ravel().astype(np.float64), tf) / denom,
            SCALE_MIN, SCALE_MAX))
        return k, T

    def fit_summary(self) -> str:
        spread = self._score_hi - self._score_lo
        return (f'L2-exp({self.K}): {self.n_clean} clean spikes  '
                f'{self.n_fitted_ch}/{self.nChanGrp} ch fitted  '
                f'PC1 range={spread:.1f}  [{self.clean_tag}]')


# ──────────────────────────────────────────────────────────────────────────────
# Layer 1 — ISI-based dual-template model
# ──────────────────────────────────────────────────────────────────────────────

def _recovery_fn(isi_ms, s_inf, f, tau_ms):
    return s_inf * (1.0 - f * np.exp(-isi_ms / tau_ms))


def fit_recovery_model(isi_ms, weights):
    if not HAS_SCIPY or len(isi_ms) < MIN_SPIKES_BURST_FIT:
        return None
    if np.std(isi_ms) < 0.5 or np.std(weights) < 1e-4:
        return None
    try:
        popt, _ = _scipy_curve_fit(
            _recovery_fn, isi_ms, weights,
            p0=[1.0, 0.5, 50.0],
            bounds=([0.1, 0.0, 1.0], [2.0, 0.99, 5000.0]), maxfev=3000)
        s_inf, f, tau_ms = popt
        if tau_ms < 2.0 or f < 0.01:
            return None
        return tuple(popt)
    except Exception:
        return None


class ClusterModel:
    """Layer 1: single or ISI-interpolated dual template, built from clean spikes."""

    def __init__(self, cid, spk_c, times_c, samplingRate,
                 use_burst_correction, min_spikes, burst_isi_ms_thresh,
                 clean_mask, min_clean_frac=DEFAULT_MIN_CLEAN_FRAC):
        self.cid             = cid
        self.has_burst_model = False
        self.burst_params    = None
        self.tmpl_burst      = None
        self.tmpl_full       = None

        # Select clean subset (or trimmed mean fallback)
        clean_subset, _ = robust_spk_subset(
            spk_c.astype(np.float32), clean_mask, min_clean_frac, cid)
        n_clean = len(clean_subset)

        using_trimmed = (n_clean == len(spk_c))
        if using_trimmed:
            self.template = trimmed_mean_waveforms(clean_subset)
        else:
            self.template = clean_subset.mean(axis=0)

        if not use_burst_correction or n_clean < 4 * min_spikes:
            return

        # Use clean subset for burst model too
        times_clean = times_c[clean_mask] if len(clean_mask) == len(times_c) \
                      else times_c
        spk_clean   = clean_subset

        isi_ms    = np.empty(n_clean, dtype=np.float64)
        isi_ms[0] = np.inf
        if n_clean > 1:
            isi_ms[1:] = np.diff(times_clean.astype(np.float64)) / samplingRate * 1000.0

        burst_mask = isi_ms < burst_isi_ms_thresh
        full_mask  = ~burst_mask

        if burst_mask.sum() < min_spikes or full_mask.sum() < min_spikes:
            return

        self.tmpl_burst = spk_clean[burst_mask].mean(axis=0)
        self.tmpl_full  = spk_clean[full_mask ].mean(axis=0)

        peak_amps = np.abs(spk_clean).max(axis=(1, 2))
        ref_amp   = np.median(peak_amps[full_mask])
        if ref_amp < 1e-6:
            return

        finite = np.isfinite(isi_ms) & (isi_ms > 0.0)
        if finite.sum() < MIN_SPIKES_BURST_FIT:
            return

        params = fit_recovery_model(isi_ms[finite], peak_amps[finite] / ref_amp)
        if params is None:
            return

        self.burst_params    = params
        self.has_burst_model = True

    def get_template(self, isi_ms: float) -> np.ndarray:
        if not self.has_burst_model or not np.isfinite(isi_ms):
            return self.template
        s_inf, f, tau_ms = self.burst_params
        w = float(np.clip(_recovery_fn(isi_ms, s_inf, f, tau_ms), 0.0, 1.0))
        return ((1.0 - w) * self.tmpl_burst + w * self.tmpl_full).astype(np.float32)

    def project(self, wf_flat: np.ndarray, isi_ms: float) -> float:
        tmpl  = self.get_template(isi_ms)
        tf    = tmpl.ravel()
        denom = float(np.dot(tf, tf))
        if denom < 1e-6:
            return 1.0
        return float(np.clip(np.dot(wf_flat, tf) / denom, SCALE_MIN, SCALE_MAX))


# ──────────────────────────────────────────────────────────────────────────────
# Layer 3 — Bayes-Optimal Template Matching (BOTM)
#
# Reference: Proepper, R. (2015).  "New tools for electrophysiological data
# analysis and their application to a working memory study."  PhD
# dissertation, TU Berlin.  §3.4.  Generative model:
#
#     x_t = Σ_i Σ_τ s^i_{t-τ} · ξ^i_τ  +  η_t,   η ~ N(0, C)
#
# where C is the (Tf·NC)×(Tf·NC) noise covariance.  The Bayes-optimal
# residual-minimising amplitude of spike i at time t is
#
#     a_i(t) = (x(t)^T · C^(-1) · ξ^i) / (ξ^i^T · C^(-1) · ξ^i)
#
# which reduces to the raw projection a = x·ξ / ξ·ξ when C = σ²I (white
# noise).  Real extracellular noise in the spike band is coloured
# (residual LFP, common-mode, 50/60 Hz); using C from the data closes
# this gap.  Pre-whitening by C^(-1/2) is implicit in the matched filter
# f = C^(-1) · ξ used to compute the numerator.
# ──────────────────────────────────────────────────────────────────────────────

def estimate_noise_covariance(input_dat_path: str,
                               channels: List[int],
                               spike_times: np.ndarray,
                               nSamples: int,
                               peakSample: int,
                               nBits: int,
                               nChannels: int,
                               ridge: float = 1e-3
                               ) -> Optional[np.ndarray]:
    """
    Estimate the Tf·NC × Tf·NC noise covariance matrix for one electrode
    group, from between-spike periods of the input .dat file.

    Uses Proepper's per-period weighted average to avoid the "stitching"
    pitfall: samples at the edges of two different noise periods were
    originally far apart in time and have expected covariance zero.
    Simply concatenating noise periods and computing a single covariance
    over the result under-estimates the true covariance.  Instead, compute
    C separately per noise period and weight-average by period length.

    Parameters
    ----------
    input_dat_path : path to the .dat being stripped
    channels       : list of channel indices for this electrode group
    spike_times    : all spike times for this group (any cluster)
    nSamples, peakSample : waveform geometry
    nBits, nChannels     : dat format
    ridge          : fraction of trace(C)/dim to add to the diagonal for
                     numerical stability before inversion

    Returns
    -------
    C : (nSamples*nChanGrp, nSamples*nChanGrp) float64 covariance, or
        None if no usable noise periods are found.
    """
    nChanGrp = len(channels)
    dim      = nSamples * nChanGrp
    dtype    = np.dtype(f'<i{nBits // 8}')

    in_size       = os.path.getsize(input_dat_path)
    bytes_per_word = nBits // 8
    nTotalSamples = in_size // (bytes_per_word * nChannels)

    dat_mm = np.memmap(input_dat_path, dtype=dtype, mode='r',
                       shape=(nTotalSamples, nChannels))

    sorted_ts = np.sort(spike_times)
    # Each spike occupies [t - peakSample, t - peakSample + nSamples)
    # A noise period between spike i and i+1 is
    #   [ts[i] - peakSample + nSamples, ts[i+1] - peakSample)
    if len(sorted_ts) < 2:
        print('    BOTM: too few spikes to find noise periods — aborting',
              file=sys.stderr)
        return None

    C_weighted    = np.zeros((dim, dim), dtype=np.float64)
    total_weight  = 0.0
    n_periods     = 0
    n_windows_tot = 0

    # Also consider the period before the first spike and after the last
    noise_boundaries = np.concatenate([
        np.array([0 - peakSample + nSamples], dtype=np.int64),  # virtual
        sorted_ts - peakSample + nSamples,                      # ends of spikes
    ])
    next_starts = np.concatenate([
        sorted_ts - peakSample,                                 # starts of spikes
        np.array([nTotalSamples], dtype=np.int64),              # virtual end
    ])

    # Sliding-window stride: non-overlapping windows within each noise period
    # gives independent samples for covariance; overlapping would correlate
    # the observations.  We use stride = nSamples (no overlap).
    for noise_start, noise_end in zip(noise_boundaries, next_starts):
        noise_start = max(int(noise_start), 0)
        noise_end   = min(int(noise_end),   nTotalSamples)
        noise_len   = noise_end - noise_start
        if noise_len < 2 * nSamples:
            continue   # not enough for even 2 windows → unreliable

        noise_data = dat_mm[noise_start:noise_end, channels].astype(np.float64)
        # shape: (noise_len, nChanGrp)

        n_windows = noise_len // nSamples
        if n_windows < 2:
            continue

        # Non-overlapping windows: (n_windows, nSamples, nChanGrp)
        windows = noise_data[:n_windows * nSamples].reshape(
            n_windows, nSamples, nChanGrp)
        # Flatten each window to a dim-vector (same ordering as spk[i].ravel())
        wf = windows.reshape(n_windows, dim)
        # Centre each period (remove period-local mean)
        wf = wf - wf.mean(axis=0, keepdims=True)

        # Per-period covariance (unbiased)
        C_i = (wf.T @ wf) / max(n_windows - 1, 1)

        # Weight by period length in samples (Proepper's convention)
        C_weighted    += noise_len * C_i
        total_weight  += noise_len
        n_periods     += 1
        n_windows_tot += n_windows

    del dat_mm

    if total_weight <= 0 or n_periods == 0:
        print('    BOTM: no usable noise periods — aborting', file=sys.stderr)
        return None

    C = C_weighted / total_weight

    # Ridge regularisation for numerical stability.  Without this, C can be
    # singular or near-singular when noise periods are short or few.
    tr = float(np.trace(C)) / dim
    C += ridge * tr * np.eye(dim)

    print(f'    BOTM: estimated noise covariance from {n_periods} periods '
          f'({n_windows_tot} windows, {int(total_weight):,} samples total), '
          f'dim={dim}, ridge={ridge}', file=sys.stderr)
    return C


class BOTMClusterModel:
    """
    Per-cluster BOTM subtraction model.

    Holds the matched filter f = C^(-1) · ξ and the denominator
    ξ^T · C^(-1) · ξ.  The Bayes-optimal amplitude for an observed spike
    waveform x is then a = (x^T · f) / (ξ^T · f).  Subtraction is
    a · ξ, byte-for-byte the cluster mean template scaled.

    No amplitude clamp: under the Gaussian model the formula is
    well-conditioned.  The ξ^T · f normaliser in the denominator already
    accounts for template energy under the whitened metric.
    """

    def __init__(self, cid: int,
                 template: np.ndarray,      # (nSamples, nChanGrp) float32
                 C_inv: np.ndarray,          # (dim, dim) float64
                 n_clean: int):
        self.cid       = int(cid)
        self.template  = template.astype(np.float32)
        self.nSamples  = int(template.shape[0])
        self.nChanGrp  = int(template.shape[1])
        self.n_clean   = int(n_clean)

        dim = self.nSamples * self.nChanGrp
        tmpl_flat = template.ravel().astype(np.float64)
        # Matched filter f = C^(-1) · ξ
        self.f         = C_inv @ tmpl_flat
        # Denominator ξ^T · C^(-1) · ξ  (scalar, > 0 under proper ridge)
        self.denom     = float(tmpl_flat @ self.f)
        # Template SNR indicator (ratio of energy in the whitened metric
        # to ordinary L2 — >> 1 means noise covariance mattered a lot)
        l2_energy      = float(tmpl_flat @ tmpl_flat)
        self.whitening_gain = (self.denom / max(l2_energy, 1e-12))

    def amplitude(self, obs_flat: np.ndarray) -> float:
        """Bayes-optimal residual-minimising amplitude for observation."""
        if self.denom < 1e-12:
            return 0.0
        return float((obs_flat @ self.f) / self.denom)

    def fit_summary(self) -> str:
        return (f'BOTM: {self.n_clean} clean-template spikes  '
                f'denom={self.denom:.2e}  '
                f'whitening-gain={self.whitening_gain:.2f}')


# ──────────────────────────────────────────────────────────────────────────────
# Per-group data container
# ──────────────────────────────────────────────────────────────────────────────

@dataclass
class GroupData:
    spike_times     : np.ndarray
    spk             : np.ndarray
    clu_ids         : Optional[np.ndarray]
    channels        : List[int]
    nSamples        : int
    peakSample      : int
    use_clusters    : bool
    cluster_models  : Dict                 # cid → ClusterModel (Layer 1)
    exp_models      : Dict                 # cid → ExponentialWaveformModel|None
    botm_models     : Dict                 # cid → BOTMClusterModel|None
    isi_per_spike   : np.ndarray
    sort_idx        : np.ndarray
    sorted_wstart   : np.ndarray
    sorted_wend     : np.ndarray
    # ── For neighbour-template cleaning ──────────────────────────────────
    sorted_times    : np.ndarray           # spike_times[sort_idx]
    sorted_clu      : np.ndarray           # clu_ids[sort_idx]  or None
    sorted_sort_idx : np.ndarray           # == sort_idx  (alias, for clarity)
    # ── Drift correction ─────────────────────────────────────────────────
    drift_signal    : Optional[np.ndarray] # (nTotalSamples,) int16 µm, or None
    site_depths     : np.ndarray           # (nChanGrp,) electrode depths µm
    # ── Cluster-id filter ────────────────────────────────────────────────
    # strip_set : frozenset[int] of cluster ids whose spikes get subtracted,
    #             sentinel 'NON_NOISE' = strip everything except 0 and 1,
    #             or None = strip every cluster present.
    strip_set       : object = None
    strip_mode      : str = ''


# ──────────────────────────────────────────────────────────────────────────────
# Group loading
# ──────────────────────────────────────────────────────────────────────────────

def load_group(resfile, spkfile, clufile, channels, nSamples, peakSample,
               samplingRate, use_burst_correction, min_template_spikes,
               min_exp_spikes, exp_terms, burst_isi_ms_thresh, min_clean_frac,
               drift_path=None, site_depths=None, n_total_samples=0,
               strip_set=None, strip_mode='',
               subtraction_mode='model',
               input_dat_path=None, nChannels=0, nBits=16,
               botm_ridge=1e-3):
    nChanGrp = len(channels)

    spike_times = np.fromfile(resfile, dtype='<i8')
    nSpikes     = len(spike_times)

    expected = nSpikes * nSamples * nChanGrp
    spk_raw  = np.fromfile(spkfile, dtype=np.dtype('<i2'))
    if len(spk_raw) != expected:
        raise RuntimeError(
            f'{spkfile!r}: expected {expected} samples '
            f'({nSpikes}×{nSamples}×{nChanGrp}) but found {len(spk_raw)}')
    spk = spk_raw.reshape(nSpikes, nSamples, nChanGrp)

    # ── cluster IDs ──────────────────────────────────────────────────────
    use_clusters = False
    clu_ids      = None
    if clufile != '-' and os.path.exists(clufile):
        try:
            ids = load_clu(clufile)
            if len(ids) != nSpikes:
                print(f'    WARNING: {os.path.basename(clufile)} has {len(ids)} '
                      f'entries vs {nSpikes} spikes — raw waveform fallback',
                      file=sys.stderr)
            else:
                clu_ids      = ids
                use_clusters = True
        except Exception as exc:
            print(f'    WARNING: {clufile!r}: {exc} — raw waveform fallback',
                  file=sys.stderr)

    # ── sort for binary search ────────────────────────────────────────────
    sort_idx      = np.argsort(spike_times)
    sorted_times  = spike_times[sort_idx]
    sorted_wstart = sorted_times - peakSample
    sorted_wend   = sorted_wstart + nSamples
    sorted_clu    = clu_ids[sort_idx] if use_clusters else np.zeros(nSpikes, np.int32)

    # ── contamination mask (used for ALL clusters) ────────────────────────
    # Skipped entirely in raw-subtraction mode — no template modelling,
    # no neighbour cleaning, no projection: all the diagnostics about
    # "which spike windows overlap" are irrelevant because the raw
    # .spk.N waveform byte-matches the .dat at that window regardless.
    cluster_models : Dict = {}
    exp_models     : Dict = {}
    botm_models    : Dict = {}
    isi_per_spike  = np.full(nSpikes, np.inf, dtype=np.float64)

    if subtraction_mode == 'raw':
        print(f'    raw-subtraction mode: skipping contamination check, '
              f'ISI computation, and cluster model building',
              file=sys.stderr)

    elif subtraction_mode == 'botm':
        # ── BOTM build path ───────────────────────────────────────────────
        # 1. estimate noise covariance C from between-spike periods
        # 2. for each cluster, build a BOTMClusterModel holding the
        #    matched filter C^(-1)·ξ and the denominator ξ^T·C^(-1)·ξ
        # 3. per-spike subtraction uses Bayes-optimal amplitude
        #
        # Contamination mask is still computed so template estimation
        # excludes overlap-contaminated spikes (same as Layer 1/2).  ISI
        # computation is skipped — BOTM doesn't use burst correction.
        if not use_clusters:
            print('    BOTM: no .clu file — falling back to raw mode for '
                  'this group (BOTM requires cluster labels)',
                  file=sys.stderr)
            subtraction_mode_effective = 'raw'
        elif input_dat_path is None or nChannels <= 0:
            raise RuntimeError('BOTM requires input_dat_path and nChannels')
        else:
            subtraction_mode_effective = 'botm'

        if subtraction_mode_effective == 'botm':
            contam_mask = find_clean_mask(spike_times, nSamples)
            n_clean_tot = int(contam_mask.sum())
            print(f'    contamination check: {n_clean_tot}/{nSpikes} spikes '
                  f'uncontaminated ({100*n_clean_tot/max(nSpikes,1):.0f}%)',
                  file=sys.stderr)

            C = estimate_noise_covariance(
                input_dat_path, channels, spike_times, nSamples, peakSample,
                nBits, nChannels, ridge=botm_ridge)
            if C is None:
                raise RuntimeError(
                    'BOTM noise covariance estimation failed; increase '
                    '--botm-ridge, reduce nSamples, or fall back to '
                    '--subtraction-mode raw')

            # Invert C once via Cholesky.  np.linalg.inv is fine here —
            # matmul C·M is much cheaper than repeated solves and we need
            # C_inv only once per group for building per-cluster filters.
            try:
                C_inv = np.linalg.inv(C)
            except np.linalg.LinAlgError as exc:
                raise RuntimeError(
                    f'BOTM: covariance inversion failed: {exc}; '
                    f'try larger --botm-ridge')

            for cid in np.unique(clu_ids):
                mask   = np.where(clu_ids == cid)[0]
                n_c    = len(mask)
                t_ord  = np.argsort(spike_times[mask])
                spk_c  = spk[mask[t_ord]].astype(np.float32)
                cm     = contam_mask[mask[t_ord]]   # clean mask

                # Robust template build: exclude contaminated spikes when
                # enough clean spikes remain, else fall back to trimmed mean
                if n_c < min_template_spikes:
                    # Too few spikes — use global fallback (rarely stripped)
                    tmpl = spk.astype(np.float32).mean(axis=0)
                    print(f'    cluster {cid:4d}: {n_c:5d} spikes '
                          f'(< {min_template_spikes}) → global template',
                          file=sys.stderr)
                else:
                    subset, _ = robust_spk_subset(
                        spk_c, cm, min_clean_frac, cid)
                    if len(subset) == n_c:  # trimmed-mean fallback
                        tmpl = trimmed_mean_waveforms(subset)
                    else:
                        tmpl = subset.mean(axis=0)

                n_clean_c = int(cm.sum())
                botm_m = BOTMClusterModel(cid, tmpl, C_inv, n_clean_c)
                botm_models[cid] = botm_m
                print(f'    cluster {cid:4d}: {n_c:5d} spikes  '
                      f'{botm_m.fit_summary()}',
                      file=sys.stderr)

    else:
        contam_mask = find_clean_mask(spike_times, nSamples)
        n_clean_tot = int(contam_mask.sum())
        print(f'    contamination check: {n_clean_tot}/{nSpikes} spikes '
              f'uncontaminated ({100*n_clean_tot/max(nSpikes,1):.0f}%)',
              file=sys.stderr)

        # ── per-cluster ISI ───────────────────────────────────────────────
        prev_t = {}
        for i in sort_idx:
            cid = int(clu_ids[i]) if use_clusters else 0
            t   = int(spike_times[i])
            if cid in prev_t:
                isi_per_spike[i] = (t - prev_t[cid]) / samplingRate * 1000.0
            prev_t[cid] = t

        # ── build cluster models ──────────────────────────────────────────
        if use_clusters:
            global_fallback = spk.astype(np.float32).mean(axis=0)

            for cid in np.unique(clu_ids):
                mask   = np.where(clu_ids == cid)[0]
                n_c    = len(mask)
                t_ord  = np.argsort(spike_times[mask])
                spk_c  = spk[mask[t_ord]].astype(np.float32)
                t_c    = spike_times[mask[t_ord]]
                cm     = contam_mask[mask[t_ord]]   # clean mask in time order

                if n_c < min_template_spikes:
                    m             = ClusterModel.__new__(ClusterModel)
                    m.cid             = cid
                    m.has_burst_model = False
                    m.burst_params    = None
                    m.tmpl_burst      = None
                    m.tmpl_full       = None
                    m.template        = global_fallback
                    cluster_models[cid] = m
                    exp_models[cid]     = None
                    print(f'    cluster {cid:4d}: {n_c:5d} spikes '
                          f'(< {min_template_spikes}) → global template',
                          file=sys.stderr)
                    continue

                # Layer 1
                m = ClusterModel(
                    cid, spk_c, t_c, samplingRate,
                    use_burst_correction, min_template_spikes,
                    burst_isi_ms_thresh, cm, min_clean_frac)
                cluster_models[cid] = m

                # Layer 2
                exp_m: Optional[ExponentialWaveformModel] = None
                if n_c >= min_exp_spikes:
                    exp_m = ExponentialWaveformModel(
                        cid, spk_c, cm, peakSample, samplingRate,
                        K=exp_terms, min_clean_frac=min_clean_frac)
                    if not exp_m.valid:
                        exp_m = None
                exp_models[cid] = exp_m

                # ── logging ──────────────────────────────────────────────
                l2_tag = (exp_m.fit_summary() if exp_m is not None
                          else f'L2: skipped (< {min_exp_spikes} spikes)'
                          if n_c < min_exp_spikes
                          else 'L2: PCA/fit failed → L1')
                l1_tag = ('L1-ISI: ' + (
                    f's_inf={m.burst_params[0]:.3f} f={m.burst_params[1]:.3f} '
                    f'τ={m.burst_params[2]:.1f} ms' if m.has_burst_model
                    else 'burst model not fitted'
                    if use_burst_correction else 'single template'))
                print(f'    cluster {cid:4d}: {n_c:5d} spikes  {l2_tag}  |  {l1_tag}',
                      file=sys.stderr)

    # ── Site depths: uniform 25 µm spacing if not provided ──────────────
    if site_depths is None or len(site_depths) == 0:
        _nC = len(channels)
        site_depths_arr = np.arange(_nC, dtype=np.float32) * 25.0
    else:
        site_depths_arr = np.array(site_depths, dtype=np.float32)

    # ── Load drift signal ─────────────────────────────────────────────────
    drift_sig: Optional[np.ndarray] = None
    if drift_path and n_total_samples > 0:
        drift_sig = load_drift_signal(drift_path, n_total_samples)

    # ── Resolve strip_set for this group ──────────────────────────────────
    # The sentinel string 'NON_NOISE' (neurosuite convention: cluster 0 =
    # artefact, cluster 1 = MUA) gets resolved here to the concrete set of
    # cluster ids 2+ that appear in .clu.  None means "strip every cluster
    # present including noise/MUA".  A frozenset is used as-is.
    if use_clusters and isinstance(strip_set, str) and strip_set == 'NON_NOISE':
        uniq = set(int(c) for c in np.unique(clu_ids))
        resolved = frozenset(uniq - {0, 1})
        if not resolved:
            print(f'    WARNING: no non-noise clusters (2+) in {clufile!r}; '
                  f'no spikes will be subtracted for this group',
                  file=sys.stderr)
        strip_set = resolved
    elif not use_clusters:
        # Without .clu, every spike gets subtracted regardless of strip_set.
        strip_set = None

    if use_clusters:
        if strip_set is None:
            print(f'    strip-mode: {strip_mode} → all clusters',
                  file=sys.stderr)
        else:
            n_ids = len(strip_set)
            preview = ','.join(str(c) for c in sorted(strip_set)[:10])
            if n_ids > 10:
                preview += f',… (+{n_ids-10} more)'
            print(f'    strip-mode: {strip_mode} → '
                  f'{n_ids} cluster(s): [{preview}]',
                  file=sys.stderr)
    else:
        print(f'    strip-mode: no .clu → raw waveform subtraction '
              f'(all spikes)', file=sys.stderr)

    return GroupData(
        spike_times     = spike_times,
        spk             = spk,
        clu_ids         = clu_ids,
        channels        = channels,
        nSamples        = nSamples,
        peakSample      = peakSample,
        use_clusters    = use_clusters,
        cluster_models  = cluster_models,
        exp_models      = exp_models,
        botm_models     = botm_models,
        isi_per_spike   = isi_per_spike,
        sort_idx        = sort_idx,
        sorted_wstart   = sorted_wstart,
        sorted_wend     = sorted_wend,
        sorted_times    = sorted_times,
        sorted_clu      = sorted_clu,
        sorted_sort_idx = sort_idx,
        drift_signal    = drift_sig,
        site_depths     = site_depths_arr,
        strip_set       = strip_set,
        strip_mode      = strip_mode,
    )


# ──────────────────────────────────────────────────────────────────────────────
# V-Cache-aware chunk size
# ──────────────────────────────────────────────────────────────────────────────

def compute_chunk_len(nChannels: int, override: Optional[int] = None) -> int:
    if override is not None:
        return max(16384, override)
    target = int(VCACHE_BYTES * VCACHE_TARGET_FRAC)
    return max(65536, target // (nChannels * 6))


# ──────────────────────────────────────────────────────────────────────────────
# Single-pass chunk subtraction
# ──────────────────────────────────────────────────────────────────────────────

def subtract_all_groups_chunked(out_mm, groups, nChannels, dtype,
                                 chunk_len_override=None,
                                 subtraction_mode='model'):
    nTotalSamples = out_mm.shape[0]
    chunk_len     = compute_chunk_len(nChannels, chunk_len_override)
    n_chunks      = math.ceil(nTotalSamples / chunk_len)

    print(f'process_subtractspikes: chunk_len={chunk_len:,}  n_chunks={n_chunks:,}',
          file=sys.stderr)
    print(f'process_subtractspikes: subtraction_mode={subtraction_mode}',
          file=sys.stderr)

    n_clipped = 0

    for c_idx in range(n_chunks):
        chunk_start = c_idx * chunk_len
        chunk_end   = min(nTotalSamples, chunk_start + chunk_len)

        if n_chunks >= 10 and c_idx % max(1, n_chunks // 10) == 0:
            print(f'  {100*c_idx//n_chunks:3d}%  (chunk {c_idx+1}/{n_chunks})',
                  file=sys.stderr)

        buf            = out_mm[chunk_start:chunk_end, :].astype(np.float32)
        chunk_modified = False

        for grp in groups:
            lo = int(np.searchsorted(grp.sorted_wend,   chunk_start, 'right'))
            hi = int(np.searchsorted(grp.sorted_wstart, chunk_end,   'left'))
            if lo >= hi:
                continue
            chunk_modified = True

            channels   = grp.channels
            nChanGrp   = len(channels)
            nSamples   = grp.nSamples
            peakSample = grp.peakSample

            for si in range(lo, hi):
                i          = int(grp.sort_idx[si])
                t          = int(grp.spike_times[i])
                isi_ms     = float(grp.isi_per_spike[i])

                # ── Strip-cluster filter ─────────────────────────────────
                # When strip_set is populated, only spikes whose cluster id
                # is in the set actually get subtracted.  Other clusters'
                # models are still available to clean_obs_waveform for
                # overlap correction of the stripped spikes.
                if grp.use_clusters and grp.strip_set is not None:
                    cid_i = int(grp.clu_ids[i])
                    if cid_i not in grp.strip_set:
                        continue

                wf_abs_start = t - peakSample
                wf_abs_end   = wf_abs_start + nSamples
                dat_start    = max(wf_abs_start, chunk_start)
                dat_end      = min(wf_abs_end,   chunk_end)
                wf_s         = dat_start - wf_abs_start
                wf_e         = wf_s + (dat_end - dat_start)
                buf_s        = dat_start - chunk_start
                buf_e        = buf_s + (dat_end - dat_start)

                if buf_e <= buf_s:
                    continue

                obs_wf_full = grp.spk[i].astype(np.float32)   # (nSamples, nChanGrp)

                # ── Raw subtraction mode ─────────────────────────────────
                # Bypass all template modelling (Layer 1/2 + drift + contam
                # cleaning).  Subtract the raw .spk.N waveform directly —
                # near-exact cancellation at the spike window, optimal for
                # re-detection workflows where residual spike traces must
                # fall below the detection threshold.
                if subtraction_mode == 'raw':
                    to_sub = obs_wf_full[wf_s:wf_e, :]
                    for ci in range(nChanGrp):
                        buf[buf_s:buf_e, channels[ci]] -= to_sub[:, ci]
                    continue

                # ── BOTM mode ────────────────────────────────────────────
                # Bayes-optimal matched-filter amplitude subtraction.
                # No drift compensation in this version (templates have a
                # fixed reference frame; future work would whiten + shift).
                # No burst correction; BOTM uses a single cluster template.
                if subtraction_mode == 'botm' and grp.use_clusters:
                    cid    = int(grp.clu_ids[i])
                    botm_m = grp.botm_models.get(cid)
                    if botm_m is None:
                        # Fallback to raw for this spike if BOTM model is
                        # missing (e.g. cluster built with < min_template_spikes
                        # and for which BOTM didn't build a proper model).
                        to_sub = obs_wf_full[wf_s:wf_e, :]
                    else:
                        obs_flat = obs_wf_full.ravel().astype(np.float64)
                        a        = botm_m.amplitude(obs_flat)
                        to_sub   = (a * botm_m.template[wf_s:wf_e, :]
                                   ).astype(np.float32)
                    for ci in range(nChanGrp):
                        buf[buf_s:buf_e, channels[ci]] -= to_sub[:, ci]
                    continue

                # ── Drift: rigid-body spatial shift of the template ───────
                # drift_signal[t] is the probe displacement (µm) at this
                # spike's time relative to the template reference window.
                # A positive value means the probe drifted deeper; the
                # neuron therefore appears on shallower channels, so we
                # shift the template toward channel 0 by that amount.
                delta_um = (float(grp.drift_signal[t])
                            if grp.drift_signal is not None else 0.0)

                if grp.use_clusters:
                    cid   = int(grp.clu_ids[i])
                    exp_m = grp.exp_models.get(cid)

                    # ── (b) clean the observation before projecting ───────
                    obs_wf_clean = clean_obs_waveform(obs_wf_full, i, grp)

                    if exp_m is not None:
                        # Layer 2: exponential PC1 model
                        k, T  = exp_m.project_and_template(obs_wf_clean)
                        T_shifted = shift_template_fast(T, delta_um,
                                                        grp.site_depths)
                        to_sub = k * T_shifted[wf_s:wf_e, :]
                    else:
                        # Layer 1: ISI dual-template
                        model  = grp.cluster_models[cid]
                        tmpl   = model.get_template(isi_ms)
                        tmpl_s = shift_template_fast(tmpl, delta_um,
                                                     grp.site_depths)
                        wf_f   = obs_wf_clean[wf_s:wf_e, :].ravel()
                        scale  = model.project(wf_f, isi_ms)
                        to_sub = scale * tmpl_s[wf_s:wf_e, :]
                else:
                    # Layer 0: raw waveform (no template to shift)
                    to_sub = obs_wf_full[wf_s:wf_e, :]

                for ci in range(nChanGrp):
                    buf[buf_s:buf_e, channels[ci]] -= to_sub[:, ci]

        if chunk_modified:
            rounded = np.round(buf)
            clipped = np.clip(rounded, -32768, 32767)
            if not np.array_equal(clipped, rounded):
                n_clipped += 1
            out_mm[chunk_start:chunk_end, :] = clipped.astype(dtype)

    print(f'  100%  (done)', file=sys.stderr)
    if n_clipped:
        print(f'process_subtractspikes: {n_clipped} chunk(s) clipped to int16',
              file=sys.stderr)


# ──────────────────────────────────────────────────────────────────────────────
# Main
# ──────────────────────────────────────────────────────────────────────────────

def main():
    parser = build_parser()
    args   = parser.parse_args()

    # ── scipy presence check ─────────────────────────────────────────────
    # Layer 1 ISI burst fitting and Layer 2 exponential PC1 fitting both
    # require scipy.optimize.curve_fit.  Without scipy:
    #   - Layer 2 produces all-zero templates (was silent before this patch)
    #   - Layer 1 burst model fitting returns None → falls back to single
    #     per-cluster mean template (graceful)
    # Raw-subtraction mode needs no scipy regardless — skip the warning.
    wants_layer_2 = args.min_exp_spikes > 0
    wants_burst   = not args.no_burst_correction
    if (args.subtraction_mode == 'model'
            and not HAS_SCIPY
            and (wants_layer_2 or wants_burst)):
        degraded = []
        if wants_layer_2: degraded.append('Layer 2 exponential PC1')
        if wants_burst:   degraded.append('Layer 1 ISI burst correction')
        print('=' * 72,                                      file=sys.stderr)
        print('process_subtractspikes: WARNING — scipy is not installed.',
              file=sys.stderr)
        print(f'  Disabled: {", ".join(degraded)}',          file=sys.stderr)
        print('  Subtraction will fall back to per-cluster mean templates',
              file=sys.stderr)
        print('  (Layer 1 single-template) or raw waveform (Layer 0).',
              file=sys.stderr)
        print('  Install scipy to enable waveform shape modelling, or use',
              file=sys.stderr)
        print('  --subtraction-mode raw to bypass modelling entirely.',
              file=sys.stderr)
        print('=' * 72,                                      file=sys.stderr)

    dtype          = np.dtype(f'<i{args.b // 8}')
    nChannels      = args.n
    bytes_per_word = args.b // 8
    samplingRate   = args.s if args.s is not None else DEFAULT_SR

    if args.s is None and not args.no_burst_correction:
        print(f'process_subtractspikes: -s not supplied; assuming {DEFAULT_SR} Hz',
              file=sys.stderr)

    group_specs = []
    for spec in args.specs:
        try:
            group_specs.append(parse_group_spec(spec))
        except ValueError as exc:
            print(f'process_subtractspikes: {exc}', file=sys.stderr)
            sys.exit(1)

    in_size     = os.path.getsize(args.input_dat)
    total_words = in_size // bytes_per_word
    if total_words % nChannels != 0:
        print(f'process_subtractspikes: file size {in_size} not divisible by '
              f'{nChannels}×{bytes_per_word}', file=sys.stderr)
        sys.exit(1)
    nTotalSamples = total_words // nChannels

    for resfile, spkfile, clufile, channels, nSamples, peakSample, drift_path, strip_set, strip_mode in group_specs:
        for path in (resfile, spkfile):
            if not os.path.exists(path):
                print(f'process_subtractspikes: not found: {path!r}', file=sys.stderr)
                sys.exit(1)
        for ch in channels:
            if ch < 0 or ch >= nChannels:
                print(f'process_subtractspikes: channel {ch} out of range '
                      f'[0, {nChannels-1}]', file=sys.stderr)
                sys.exit(1)

    print(f'process_subtractspikes: copying '
          f'{os.path.basename(args.input_dat)} → '
          f'{os.path.basename(args.output_dat)} …', file=sys.stderr)
    shutil.copy2(args.input_dat, args.output_dat)

    out_mm = np.memmap(args.output_dat, dtype=dtype, mode='r+',
                       shape=(nTotalSamples, nChannels))

    groups = []
    for g_idx, (resfile, spkfile, clufile, channels, nSamples, peakSample,
                drift_path, strip_set, strip_mode) in \
            enumerate(group_specs):
        nSpikes_est = os.path.getsize(resfile) // 8
        has_clu     = (clufile != '-' and os.path.exists(clufile))
        has_drift   = drift_path is not None
        print(f'process_subtractspikes: loading group {g_idx+1}/{len(group_specs)}  '
              f'ch={channels}  ~{nSpikes_est} spikes  clu={"yes" if has_clu else "no"}'
              f'  drift={"yes" if has_drift else "no"}',
              file=sys.stderr)
        try:
            grp = load_group(
                resfile, spkfile, clufile, channels, nSamples, peakSample,
                samplingRate,
                not args.no_burst_correction,
                args.min_template_spikes,
                args.min_exp_spikes,
                args.exp_terms,
                args.burst_isi_threshold_ms,
                args.min_clean_frac,
                drift_path       = drift_path,
                n_total_samples  = nTotalSamples,
                strip_set        = strip_set,
                strip_mode       = strip_mode,
                subtraction_mode = args.subtraction_mode,
                input_dat_path   = args.input_dat,
                nChannels        = args.n,
                nBits            = args.b,
                botm_ridge       = args.botm_ridge)
            groups.append(grp)
        except RuntimeError as exc:
            print(f'process_subtractspikes: {exc}', file=sys.stderr)
            del out_mm
            os.remove(args.output_dat)
            sys.exit(1)

    try:
        subtract_all_groups_chunked(out_mm, groups, nChannels, dtype,
                                     args.chunk_frames,
                                     subtraction_mode=args.subtraction_mode)
    except Exception as exc:
        print(f'process_subtractspikes: {exc}', file=sys.stderr)
        out_mm.flush()
        del out_mm
        os.remove(args.output_dat)
        sys.exit(1)

    out_mm.flush()
    del out_mm
    print('process_subtractspikes: done.', file=sys.stderr)


if __name__ == '__main__':
    main()
