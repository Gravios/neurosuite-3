# ndm_custody — bash mirror of the chain-of-custody file-relationship policy.
#
# Single bash home for the rule, mirroring neurosuite::custody (custody.hpp,
# C++) and ndm_resolve_io (Python).  Kept in lock-step via the shared
# conformance vectors (libneurosuite-core/test/custody_vectors.tsv); the bash
# runner is ndmanager-plugins/test/test_custody_conformance.sh.
#
# Source this file (ndm_functions does).  No external dependencies.
#
#   classes:  MethodSpecific (clu/fet/pca/col/model/klg) — strict
#             Shared         (res, spk)                   — method->standard->untagged
#             SessionWide    (fil/dat/xml/yaml/par/...)   — <base>.<type>

NDM_DEFAULT_METHOD=standard
_NDM_PERGROUP=" res spk clu clc fet pca col model klg "
_NDM_SESSIONWIDE=" fil dat xml yaml nrs par eeg lfp "

ndm_is_per_group_type()    { case "$_NDM_PERGROUP"    in *" $1 "*) return 0;; esac; return 1; }
ndm_is_session_wide_type() { case "$_NDM_SESSIONWIDE" in *" $1 "*) return 0;; esac; return 1; }
ndm_is_known_type()        { ndm_is_per_group_type "$1" || ndm_is_session_wide_type "$1"; }

# classify TYPE -> MethodSpecific | Shared | SessionWide
ndm_classify()
{
    if ndm_is_session_wide_type "$1"; then echo SessionWide; return; fi
    case "$1" in res|spk) echo Shared; return ;; esac
    echo MethodSpecific
}

# path composition (bash arg order: base type group method).
ndm_method_path()   { echo "${1}.${2}.${4}.${3}"; }   # -> base.type.method.group
ndm_untagged_path() { echo "${1}.${2}.${3}"; }        # -> base.type.group
ndm_session_path()  { echo "${1}.${2}"; }             # -> base.type

# method_of PATH -> method token, or "" (robust against a dotted base: the slot
# before the group is the method only if it is NOT a known type token).
ndm_method_of()
{
    local name="${1##*/}" IFS='.'
    local -a p; read -r -a p <<< "$name"
    local n=${#p[@]}
    [ "$n" -lt 3 ] && { echo ""; return; }
    case "${p[n-1]}" in ''|*[!0-9]*) echo ""; return ;; esac   # last must be the group
    local cand="${p[n-2]}"
    if ndm_is_known_type "$cand"; then echo ""; return; fi
    echo "$cand"
}

# Stage-1 alias.
ndm_method_from_path() { ndm_method_of "$1"; }

# parse_anchor PATH -> sets NDM_A_{OK,BASE,TYPE,METHOD,GROUP,SUFFIX}
ndm_parse_anchor()
{
    local name="${1##*/}" IFS='.'
    local -a p; read -r -a p <<< "$name"
    local n=${#p[@]} i typeIdx=-1
    NDM_A_OK=0; NDM_A_BASE=""; NDM_A_TYPE=""; NDM_A_METHOD=""; NDM_A_GROUP=-1; NDM_A_SUFFIX=""
    for (( i=n-2; i>=1; i-- )); do
        if ndm_is_known_type "${p[i]}"; then typeIdx=$i; break; fi
    done
    [ "$typeIdx" -lt 0 ] && return
    NDM_A_TYPE="${p[typeIdx]}"
    NDM_A_BASE="${p[0]}"
    for (( i=1; i<typeIdx; i++ )); do NDM_A_BASE="${NDM_A_BASE}.${p[i]}"; done
    local idx=$((typeIdx+1))
    [ "$idx" -ge "$n" ] && return
    # method present iff p[idx] is not all-digits (matches C++ !isAllDigits)
    case "${p[idx]}" in
        ''|*[!0-9]*) NDM_A_METHOD="${p[idx]}"; idx=$((idx+1)) ;;
    esac
    [ "$idx" -ge "$n" ] && return
    case "${p[idx]}" in ''|*[!0-9]*) return ;; esac     # need an integer group
    NDM_A_GROUP="${p[idx]}"; idx=$((idx+1))
    local suf=""
    for (( i=idx; i<n; i++ )); do
        if [ -z "$suf" ]; then suf="${p[i]}"; else suf="${suf}.${p[i]}"; fi
    done
    NDM_A_SUFFIX="$suf"
    NDM_A_OK=1
}

# resolve BASE TYPE GROUP METHOD -> echoes resolved path; sets NDM_R_FOUND (0|1)
# and NDM_R_METHOD; returns 0 iff a file was found.
ndm_resolve()
{
    local base="$1" type="$2" group="$3" method="$4" p
    NDM_R_FOUND=0; NDM_R_METHOD=""
    case "$(ndm_classify "$type")" in
        SessionWide)
            p="$(ndm_session_path "$base" "$type")"
            echo "$p"; [ -f "$p" ] && NDM_R_FOUND=1
            [ "$NDM_R_FOUND" = 1 ]; return ;;
        MethodSpecific)
            p="$(ndm_method_path "$base" "$type" "$group" "$method")"
            NDM_R_METHOD="$method"; echo "$p"; [ -f "$p" ] && NDM_R_FOUND=1
            [ "$NDM_R_FOUND" = 1 ]; return ;;
        Shared)
            local variant seen_std=0
            for variant in "$method" "$NDM_DEFAULT_METHOD" ""; do
                if [ "$variant" = "$NDM_DEFAULT_METHOD" ]; then
                    [ "$seen_std" = 1 ] && continue
                    seen_std=1
                fi
                if [ -n "$variant" ]; then
                    p="${base}.${type}.${variant}.${group}"
                else
                    p="${base}.${type}.${group}"
                fi
                if [ -f "$p" ]; then
                    echo "$p"; NDM_R_FOUND=1; NDM_R_METHOD="$(ndm_method_of "$p")"
                    return 0
                fi
            done
            p="$(ndm_method_path "$base" "$type" "$group" "$method")"
            NDM_R_METHOD="$method"; echo "$p"; return 1 ;;
    esac
}

ndm_resolved_is_stderiv() { [ "$NDM_R_METHOD" = stderiv ]; }

# Resolve an existing SHARED artifact across ALL methods — the single physical
# copy that exists regardless of which method created it.  Unlike ndm_resolve
# (method -> standard -> untagged), this also finds another non-standard method's
# copy, e.g. a .res written by an stderiv run when resolving for a standard run.
# Spike times (.res) and the raw .spk are shared, so the first extraction owns
# them; later runs reuse the existing copy.
# Priority: preferred method (if given) -> standard -> stderiv -> sdiff ->
# untagged.  Echoes the path (empty if none); sets NDM_R_FOUND/NDM_R_METHOD;
# returns 0 iff a file was found.
#   args: base type group [preferred_method]
ndm_resolve_any() {
    local base="$1" type="$2" group="$3" pref="${4:-}" cand mm
    NDM_R_FOUND=0; NDM_R_METHOD=""
    for mm in "$pref" standard stderiv sdiff; do
        [ -z "$mm" ] && continue
        cand="$(ndm_method_path "$base" "$type" "$group" "$mm")"
        if [ -f "$cand" ]; then echo "$cand"; NDM_R_FOUND=1; NDM_R_METHOD="$mm"; return 0; fi
    done
    cand="$(ndm_untagged_path "$base" "$type" "$group")"
    if [ -f "$cand" ]; then echo "$cand"; NDM_R_FOUND=1; NDM_R_METHOD=""; return 0; fi
    return 1
}

# ── backward-compatible names ───────────────────────────────────────────────
# Strict method-pinned resolve (composes <base>.<type>.<method>.<group>, no
# fallback); echoes path, rc 0 if it exists.
ndm_resolve_method() { local p; p="$(ndm_method_path "$1" "$2" "$3" "$4")"; echo "$p"; [ -f "$p" ]; }
# Shared resolve (method->standard->untagged fallback); echoes path, rc 0 if a
# file was found.
ndm_resolve_shared() { ndm_resolve "$1" "$2" "$3" "$4"; }
