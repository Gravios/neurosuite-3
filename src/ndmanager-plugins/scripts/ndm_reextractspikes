#!/bin/bash

#////////////////////////////////////////////////////////////////////////////
#//
#//   Second-pass spike detection with mask exclusion and in-place shadow
#//   clustering (unified, method-dispatching)
#//
#//   PIPELINE
#//   --------
#//   1. The detection engine scans $session.fil with reduced thresholds and
#//      rejects any candidate peak within +/- reextractMaskHalfWidth samples of
#//      an existing spike time, so only spikes MISSED by the first pass survive.
#//      Output lands at $session-reextr-tmp.{res,spk}.N.
#//         standard / sdiff : process_reextractspikes        (external -t threshold)
#//         stderiv          : process_reextractspikes_stderiv (-f/-B/-Z/-d order)
#//
#//   2. Originals are copied to <dotted-name>.bak for crash recovery.
#//
#//   3. process_shadowcluster merges the new spikes directly into the primary
#//      .{res,spk,fet,clu}.<method>.N files, with shadow cluster IDs assigned to
#//      every new spike.  The merge is crash-safe: each output is written to a
#//      sandbox first and renamed atomically on completion.
#//
#//   FILE NAMES (chain-of-custody, like ndm_extractspikes / ndm_pca)
#//   ---------------------------------------------------------------
#//   The `method` (standard | sdiff | stderiv) selects the detection engine and
#//   the dotted artifact names: .spk.<method>.N / .fet.<method>.N / .clu.<method>.N
#//   / .pca.<method>.N.  Spike times (.res) are method-independent and resolved
#//   across methods.  process_reextractspikes / process_shadowcluster take a stem
#//   and hard-code the raw extensions, so the dotted files are marshaled through
#//   temporary raw-named links on the read side and renamed back on commit.
#//
#//   CLUSTER ID CONVENTION
#//   ---------------------
#//     shadow(k) = maxExistingId + 1 + k    (paired with existing cluster k)
#//     unmatched = maxExistingId + 1 + maxExistingId + 1
#//
#//   copyright       (C) 2026  Gravios / NeuroSuite-3 contributors
#//   GNU GPL v3 or later.
#//
#////////////////////////////////////////////////////////////////////////////

source ndm_functions

program=$(basename $0)

# ── Parse command-line: <=1 positional (parameter file) + method overrides ───
positionals=()
methodOverride=
methodOrderOverride=
while [ $# -gt 0 ]; do
    case "$1" in
        --method)         methodOverride="$2";          shift 2 ;;
        --method=*)       methodOverride="${1#*=}";      shift ;;
        --methodOrder)    methodOrderOverride="$2";      shift 2 ;;
        --methodOrder=*)  methodOrderOverride="${1#*=}"; shift ;;
        -*)               echo_error "unknown option: $1"; exit $GENERAL_ERROR ;;
        *)                positionals+=("$1");           shift ;;
    esac
done
if [ ${#positionals[@]} -gt 1 ]; then
    echo_error "usage: $program [parameter-file] [--method M] [--methodOrder N]"
    exit $GENERAL_ERROR
fi
ndm_resolve_session "${positionals[@]}"
[ "$NDM_SHIFTED" = 0 ] && positionals=("$session" "${positionals[@]}")
param_ext=$(param_file_ext "$session")

# ── Resolve method + methodOrder (CLI override > YAML > default) ──────────────
method=$methodOverride
[ -z "$method" ] && method=$(read_script_parameter $session method)
method=${method:-standard}
case "$method" in
    standard|sdiff|stderiv) : ;;
    *) echo_error "unknown method '$method' (expected standard, sdiff, or stderiv)"; exit $GENERAL_ERROR ;;
esac
methodOrder=$methodOrderOverride
[ -z "$methodOrder" ] && methodOrder=$(read_script_parameter $session methodOrder sdiffOrder)
methodOrder=${methodOrder:-3}
if [ "$method" != standard ]; then
    if [ "$methodOrder" -lt 1 ] || [ "$methodOrder" -gt 3 ]; then
        echo_error "methodOrder '$methodOrder' invalid for method '$method' (expected 1-3)"
        exit $GENERAL_ERROR
    fi
fi
# standard and sdiff share the raw engine (sdiff waveforms are raw, exactly as in
# ndm_pca); only stderiv has a derivative-space detection binary.
if [ "$method" = stderiv ]; then reBinary=process_reextractspikes_stderiv; else reBinary=process_reextractspikes; fi

print_header "$session - Second-pass spike re-extraction [method=$method] with in-place shadow clustering"

check_commands_installed $reBinary process_shadowcluster process_medianthreshold

inputs_missing "$session.$param_ext" "$session.fil" && exit $INPUTS_MISSING

# ////////////////////////////////////////////////////////////////////////////
# //  Session-level parameters
# ////////////////////////////////////////////////////////////////////////////

nChannels=$(yaml_read $session "//acquisitionSystem/nChannels")
resolution=$(yaml_read $session "//acquisitionSystem/nBits")
samplingRate=$(yaml_read $session "//acquisitionSystem/samplingRate")
nElectrodeGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")

check_mandatory_variable $nChannels    "missing number of channels"
check_mandatory_variable $resolution   "missing resolution (in bits)"
check_mandatory_variable $samplingRate "missing sampling rate"
if [ -z "$nElectrodeGroups" ] || [ "$nElectrodeGroups" -eq 0 ]; then
    echo_error "missing spike groups"
    exit $GENERAL_ERROR
fi

# Detection parameters — shared with the detection engine (ndm_detectspikes node).
thresholdFactor=$(read_script_parameter -a ndm_detectspikes $session thresholdFactor)
refractoryPeriod=$(read_script_parameter -a ndm_detectspikes $session refractoryPeriod)
peakSearchLength=$(read_script_parameter -a ndm_detectspikes $session peakSearchLength)
start=$(read_script_parameter -a ndm_detectspikes $session start)
duration=$(read_script_parameter -a ndm_detectspikes $session duration)

# Re-extraction-specific parameters (ndm_reextractspikes node).
reextractThresholdFactor=$(read_script_parameter $session reextractThresholdFactor)
reextractMaskHalfWidth=$(read_script_parameter   $session reextractMaskHalfWidth)
reextractMinClusterSize=$(read_script_parameter  $session reextractMinClusterSize)
reextractChi2=$(read_script_parameter            $session reextractChi2)
reextractExtraFeat=$(read_script_parameter       $session reextractExtraFeat)
reextractInflationRatio=$(read_script_parameter  $session reextractInflationRatio)
reextractInflationCap=$(read_script_parameter    $session reextractInflationCap)
reextractAutoSubcluster=$(read_script_parameter  $session reextractAutoSubcluster)

check_mandatory_variable $thresholdFactor  "missing thresholdFactor"
check_mandatory_variable $refractoryPeriod "missing refractoryPeriod"
check_mandatory_variable $peakSearchLength "missing peakSearchLength"
check_mandatory_variable $start            "missing start"
check_mandatory_variable $duration         "missing duration"

# Fallback defaults — normally supplied by the XML descriptor.
reextractThresholdFactor=${reextractThresholdFactor:-$(unset LANG && echo "$thresholdFactor 0.75" \
    | awk '{printf "%g", $1 * $2}')}
reextractMinClusterSize=${reextractMinClusterSize:-50}
reextractChi2=${reextractChi2:-0.999}
reextractExtraFeat=${reextractExtraFeat:-auto}
reextractInflationRatio=${reextractInflationRatio:-5.0}
reextractInflationCap=${reextractInflationCap:-500}
reextractAutoSubcluster=${reextractAutoSubcluster:-0}

echo_info "Re-extraction parameters:"
echo_info "  reextractThresholdFactor = $reextractThresholdFactor  (main thresholdFactor=$thresholdFactor)"
[ "$method" != standard ] && echo_info "  spatial derivative order = $methodOrder"
if [ -n "$reextractMaskHalfWidth" ]; then
    echo_info "  reextractMaskHalfWidth   = $reextractMaskHalfWidth samples (explicit)"
else
    echo_info "  reextractMaskHalfWidth   = per-group default (group's nSamples)"
fi
echo_info "  reextractMinClusterSize  = $reextractMinClusterSize spikes"
echo_info "  reextractChi2            = $reextractChi2"
echo_info "  reextractExtraFeat       = $reextractExtraFeat"
echo_info "  reextractInflationRatio  = $reextractInflationRatio"
echo_info "  reextractInflationCap    = $reextractInflationCap"
echo_info "  reextractAutoSubcluster  = $reextractAutoSubcluster"

# ////////////////////////////////////////////////////////////////////////////
# //  Build per-group channel list, verify pre-requisites (dotted names)
# ////////////////////////////////////////////////////////////////////////////

secondsToBytes()
{
    unset LANG && echo $1 $samplingRate $nChannels $resolution \
        | awk '{printf "%f", int($1*$2)/8*$3*$4}' | sed 's/[.].*//'
}

electrodeList=""
samplesInWaveform=""
peakSample=""
# Per-group resolved dotted paths (method-tagged; .res is Shared).
declare -A groupResFile
declare -A groupSpkFile
declare -A groupFetFile
declare -A groupCluFile
declare -A groupPcaFile
declare -A groupNSamples
declare -A groupActive
activeCount=0
skippedCount=0

for group in $(seq 1 $nElectrodeGroups); do
    electrodes=$(yaml_read $session \
        "//spikeDetection/channelGroups/group[$group]/channels/channel")
    check_mandatory_variable $electrodes "missing electrode list for group $group"
    electrodes=$(echo $electrodes | sed 's/ /,/g')
    electrodeList="$electrodeList:$electrodes"

    _ns=$(yaml_read $session "//spikeDetection/channelGroups/group[$group]/nSamples")
    _ps=$(yaml_read $session "//spikeDetection/channelGroups/group[$group]/peakSampleIndex")
    check_mandatory_variable $_ns "missing nSamples for group $group"
    check_mandatory_variable $_ps "missing peakSampleIndex for group $group"
    groupNSamples[$group]=$_ns
    if [ -z "$samplesInWaveform" ]; then
        samplesInWaveform=$_ns
        peakSample=$_ps
    elif [ "$_ns" != "$samplesInWaveform" ] || [ "$_ps" != "$peakSample" ]; then
        echo_warning "Group $group has nSamples=$_ns peakSampleIndex=$_ps differs from group 1"
        echo_warning "  the detection engine uses uniform values; using group 1's."
    fi

    # .res holds method-independent spike times — resolve it across methods.
    resFile=$(ndm_resolve_any "$session" res "$group" "$method")
    if [ -z "$resFile" ] || [ ! -f "$resFile" ]; then
        echo_warning "  group $group: no .res (any method) — skipping"
        groupActive[$group]=n
        skippedCount=$((skippedCount + 1))
        continue
    fi
    groupResFile[$group]=$resFile

    # Waveform / feature / cluster files are method-tagged.
    spkFile=$(ndm_method_path "$session" spk "$group" "$method")
    fetFile=$(ndm_method_path "$session" fet "$group" "$method")
    cluFile=$(ndm_method_path "$session" clu "$group" "$method")
    if [ ! -f "$spkFile" ]; then
        echo_warning "  group $group: no $spkFile — skipping"
        groupActive[$group]=n; skippedCount=$((skippedCount + 1)); continue
    fi
    if [ ! -f "$fetFile" ]; then
        echo_warning "  group $group: no $fetFile — skipping"
        groupActive[$group]=n; skippedCount=$((skippedCount + 1)); continue
    fi
    if [ ! -f "$cluFile" ]; then
        echo_warning "  group $group: no $cluFile — skipping (sort first)"
        groupActive[$group]=n; skippedCount=$((skippedCount + 1)); continue
    fi
    groupSpkFile[$group]=$spkFile
    groupFetFile[$group]=$fetFile
    groupCluFile[$group]=$cluFile

    # PCA basis (optional; process_shadowcluster reads it if present).
    pcaFile=$(ndm_method_path "$session" pca "$group" "$method")
    [ -f "$pcaFile" ] && groupPcaFile[$group]=$pcaFile || groupPcaFile[$group]=""

    groupActive[$group]=y
    activeCount=$((activeCount + 1))
done
electrodeList=${electrodeList#:}

if [ "$activeCount" -eq 0 ]; then
    echo_error "No groups have the full set of inputs — nothing to re-extract."
    echo_error "Run the primary detect/sort pipeline (method=$method) on at least one group first."
    exit $INPUTS_MISSING
fi
echo_info "Active groups: $activeCount  (skipped: $skippedCount)"

# Resolve mask half-width: explicit YAML value wins; else max per-active nSamples.
if [ -z "$reextractMaskHalfWidth" ]; then
    maxNs=0
    for group in $(seq 1 $nElectrodeGroups); do
        [ "${groupActive[$group]}" != "y" ] && continue
        ns=${groupNSamples[$group]}
        [ "$ns" -gt "$maxNs" ] && maxNs=$ns
    done
    reextractMaskHalfWidth=$maxNs
    echo_info "Resolved reextractMaskHalfWidth = $reextractMaskHalfWidth samples (max group nSamples)"
fi

startInBytes=$(secondsToBytes $start)
durationInBytes=$(secondsToBytes $duration)

# ////////////////////////////////////////////////////////////////////////////
# //  Compute reduced thresholds (standard / sdiff only; stderiv is internal)
# ////////////////////////////////////////////////////////////////////////////

if [ "$method" != stderiv ]; then
    echo_info "Computing baseline (median-threshold) and scaling by reextractThresholdFactor"
    baseline=$(tail -c +$(( startInBytes + 1 )) $session.fil \
        | head -c $durationInBytes \
        | process_medianthreshold -s $durationInBytes -n $nChannels -c $electrodeList)
    check_command_status process_medianthreshold
    thresholds=$(unset LANG && echo "$baseline" \
        | awk -v f="$reextractThresholdFactor" \
          'BEGIN{RS=":";FS=","} {for(i=1;i<=NF;i++) printf "%f,", $i*f; printf ":"}' \
        | sed 's/,:/:/g;s/:$//')
    echo_info "  reduced thresholds: $thresholds"
fi

# ////////////////////////////////////////////////////////////////////////////
# //  Pass 1 — re-detection with mask exclusion
# //
# //  The engine reads the existing spike times from <maskBase>.res.N; the .res
# //  is method-independent and lives under a dotted/shared name, so link the
# //  resolved file into a raw-named mask base for the (stem-based) binary.
# ////////////////////////////////////////////////////////////////////////////

tmpStem=$session-reextr-tmp
maskBase=$session-reextr-mask
rm -f $tmpStem.fil
ln -s $session.fil $tmpStem.fil
for group in $(seq 1 $nElectrodeGroups); do
    [ "${groupActive[$group]}" != "y" ] && continue
    rm -f "$maskBase.res.$group"
    ln -sf "$(basename "${groupResFile[$group]}")" "$maskBase.res.$group"
done

if [ "$method" = stderiv ]; then
    process_reextractspikes_stderiv \
        -n $nChannels \
        -c $electrodeList \
        -w $samplesInWaveform \
        -p $peakSample \
        -l $peakSearchLength \
        -r $refractoryPeriod \
        -f $reextractThresholdFactor \
        -B $startInBytes \
        -Z $durationInBytes \
        -d $methodOrder \
        -m $maskBase \
        -M $reextractMaskHalfWidth \
        -v \
        $tmpStem
    check_command_status process_reextractspikes_stderiv
    # The stderiv engine writes .spkD (stderiv-transformed waveforms); rename to
    # .spk so shadowcluster's hard-coded reader sees them (values unchanged).
    for group in $(seq 1 $nElectrodeGroups); do
        [ "${groupActive[$group]}" != "y" ] && continue
        [ -f "$tmpStem.spkD.$group" ] && mv "$tmpStem.spkD.$group" "$tmpStem.spk.$group"
    done
else
    process_reextractspikes \
        -n $nChannels \
        -c $electrodeList \
        -t $thresholds \
        -w $samplesInWaveform \
        -p $peakSample \
        -l $peakSearchLength \
        -r $refractoryPeriod \
        -m $maskBase \
        -M $reextractMaskHalfWidth \
        -v \
        $tmpStem
    check_command_status $reBinary
fi

rm -f $tmpStem.fil
for group in $(seq 1 $nElectrodeGroups); do
    [ "${groupActive[$group]}" != "y" ] && continue
    rm -f "$maskBase.res.$group"
done

# ////////////////////////////////////////////////////////////////////////////
# //  Pass 2 — in-place shadow-cluster merge per group
# ////////////////////////////////////////////////////////////////////////////

mergeStem=$session-reextr-merge
refBase=$session-reextr-ref

# Clean any stale sandbox outputs from a previous aborted run.
rm -f "$mergeStem".{res,spk,fet,clu,pca,shadowmark}.[0-9]*
rm -f "$mergeStem".{res,spk,fet,clu,pca,shadowmark}.[0-9]*.tmp
rm -f "$refBase".{spk,fet,clu,pca}.[0-9]*

committedCount=0
noSpikesCount=0

for group in $(seq 1 $nElectrodeGroups); do
    [ "${groupActive[$group]}" != "y" ] && continue

    _ns=${groupNSamples[$group]}
    nChInGroup=$(yaml_read $session \
        "//spikeDetection/channelGroups/group[$group]/channels/channel" | wc -w)

    if [ ! -e "$tmpStem.res.$group" ]; then
        echo_warning "  group $group: Pass 1 produced no $tmpStem.res.$group — skipping"
        noSpikesCount=$((noSpikesCount + 1))
        continue
    fi
    newSpkCount=$(( $(wc -c < "$tmpStem.res.$group") / 8 ))    # int64 timestamps
    if [ ! -s "$tmpStem.res.$group" ]; then
        echo_info "  group $group: Pass 1 accepted 0 new spikes — originals unchanged"
        rm -f "$tmpStem.res.$group" "$tmpStem.spk.$group" "$tmpStem.spkD.$group"
        noSpikesCount=$((noSpikesCount + 1))
        continue
    fi

    echo_info "Shadow-clustering group $group  ($_ns samples x $nChInGroup channels, $newSpkCount new spikes)"

    # Create .bak backups of the dotted originals the first time we touch them.
    for f in "${groupResFile[$group]}" "${groupSpkFile[$group]}" "${groupFetFile[$group]}" "${groupCluFile[$group]}"; do
        if [ ! -f "$f.bak" ]; then
            cp "$f" "$f.bak"
        else
            echo_info "  keeping existing $f.bak"
        fi
    done

    # process_shadowcluster reads <refBase>.{spk,fet,clu,pca}.N and writes
    # <outBase>.{spk,fet,clu,res}.N, hard-coding the raw extensions on the read
    # side.  Link the dotted files to raw-named entries under a dedicated refBase
    # (never the live files), so a failure leaves the session untouched and the
    # commit is a set of atomic renames onto the dotted names.
    for pair in "spk ${groupSpkFile[$group]}" "fet ${groupFetFile[$group]}" "clu ${groupCluFile[$group]}"; do
        ext=${pair%% *}; src=${pair#* }
        rm -f "$refBase.$ext.$group"
        ln -sf "$(realpath "$src")" "$refBase.$ext.$group"
    done
    if [ -n "${groupPcaFile[$group]}" ]; then
        rm -f "$refBase.pca.$group"
        ln -sf "$(realpath "${groupPcaFile[$group]}")" "$refBase.pca.$group"
    fi

    process_shadowcluster \
        --ref   "$refBase" \
        --new   "$tmpStem" \
        --out   "$mergeStem" \
        --grp   "$group" \
        --nChan "$nChInGroup" \
        --wav   "$_ns" \
        --minClusterSize "$reextractMinClusterSize" \
        --chi2  "$reextractChi2" \
        --extraFeat "$reextractExtraFeat" \
        --inflationRatio "$reextractInflationRatio" \
        --inflationCap   "$reextractInflationCap" \
        -v
    sc_status=$?

    # Tear down the read-side links (live dotted files were never touched).
    rm -f "$refBase".{spk,fet,clu,pca}."$group"

    if [ $sc_status -ne 0 ]; then
        echo_error "  group $group: process_shadowcluster failed; live files untouched"
        rm -f "$mergeStem".{res,spk,fet,clu,shadowmark}."$group"
        check_command_status process_shadowcluster $sc_status
    fi

    missing=""
    for ext in res clu spk fet; do
        [ ! -s "$mergeStem.$ext.$group" ] && missing="$missing .$ext"
    done
    if [ -n "$missing" ]; then
        echo_error "  group $group: sandbox missing outputs:$missing; live files untouched"
        rm -f "$mergeStem".{res,spk,fet,clu,shadowmark}."$group"
        exit $GENERAL_ERROR
    fi

    # Commit: atomic per-file renames onto the dotted names.  .clu last so an
    # interrupted commit leaves the session indexable by old cluster labels.
    mv -f "$mergeStem.res.$group" "${groupResFile[$group]}"
    mv -f "$mergeStem.spk.$group" "${groupSpkFile[$group]}"
    mv -f "$mergeStem.fet.$group" "${groupFetFile[$group]}"
    mv -f "$mergeStem.clu.$group" "${groupCluFile[$group]}"
    if [ -f "$mergeStem.shadowmark.$group" ]; then
        mv -f "$mergeStem.shadowmark.$group" "$session.shadowmark.$method.$group"
    else
        echo_warning "  group $group: process_shadowcluster did not produce a shadowmark sidecar"
        echo_warning "  ndm_subcluster_unmatched will skip this group; rebuild process_shadowcluster"
    fi
    committedCount=$((committedCount + 1))

    rm -f "$tmpStem.res.$group" "$tmpStem.spk.$group" "$tmpStem.spkD.$group"
done

# Sweep any leftover sandbox files.
rm -f "$mergeStem".{res,spk,fet,clu,pca,shadowmark}.[0-9]*
rm -f "$mergeStem".{res,spk,fet,clu,pca,shadowmark}.[0-9]*.tmp
rm -f "$refBase".{spk,fet,clu,pca}.[0-9]*

echo_info ""
echo_info "Done — $committedCount/$activeCount eligible group(s) had new spikes merged in-place"
echo_info "       ($noSpikesCount had no new spikes, $skippedCount pre-filtered in pre-scan)"
echo_info "Originals preserved at <dotted-name>.bak (for merged groups only)"
echo_info "To revert, rename the .bak files back over the primary files."

# ////////////////////////////////////////////////////////////////////////////
# //  Optional auto-subcluster pass
# ////////////////////////////////////////////////////////////////////////////

if [ "$reextractAutoSubcluster" = "1" ] && [ "$committedCount" -gt 0 ]; then
    echo_info ""
    echo_info "reextractAutoSubcluster=1 — invoking ndm_subcluster_unmatched"
    if command -v ndm_subcluster_unmatched >/dev/null 2>&1; then
        ndm_subcluster_unmatched "$session"
        sub_status=$?
        if [ $sub_status -ne 0 ]; then
            echo_warning "ndm_subcluster_unmatched exited with status $sub_status;"
            echo_warning "merged session is intact but unmatched bin was not re-clustered."
        fi
    else
        echo_warning "reextractAutoSubcluster=1 but ndm_subcluster_unmatched not in PATH;"
        echo_warning "run it manually to cluster the unmatched bin."
    fi
fi

echo_info "Inspect in Klusters:  klusters $session.$param_ext"
