#!/bin/bash
#////////////////////////////////////////////////////////////////////////////
#//  ndm_decomposecollisions — template-matching collision decomposition
#//
#//  For each spikeDetection group, reads curated .clu.N / .res.N / .spk.N
#//  files, builds per-unit mean waveform templates from the curated clusters,
#//  identifies spikes whose waveforms are poorly explained by any single
#//  template (collision candidates), and fits two-component matchingpursuit
#//  decompositions using all pairwise same-shank template combinations.
#//
#//  Output: SESSION.col.N  (one per spikeDetection group, binary sidecar)
#//
#//  The original .clu.N, .res.N and .spk.N files are never modified.
#//
#//  copyright (C) 2025 neurosuite-3 contributors  GPL-3.0-or-later
#////////////////////////////////////////////////////////////////////////////

source ndm_functions

program=$(basename $0)
if [ $# -gt 1 ]; then
    echo_error "usage: $program [parameter-file]"
    exit $GENERAL_ERROR
fi

directory=$(basename "$(pwd)")
session=${1:-$directory}
session=${session%.xml}; session=${session%.yaml}; session=${session%.yml}

print_header "$session - Decomposing spike collisions"

check_commands_installed process_decomposecollisions

# Resolve the YAML parameter file — required; no XML fallback
yamlfile=$(find_yaml_file "$session")
[ -z "$yamlfile" ] && {
    echo_error "No parameter file found for session '$session' (expected ${session}.yaml)"
    exit $INPUTS_MISSING; }
inputs_missing "$yamlfile" && exit $INPUTS_MISSING

# Read parameters from the ndm_decomposecollisions block.
#
# read_script_parameter's default is to look up under "$program" (the
# current script's basename), which is exactly what we want.  Passing the
# script name a second time as a positional argument is wrong — the
# function then treats the script name as the first parameter NAME to
# resolve, which fails silently and falls through to the real parameter
# name in the second position.  Remove the stray script-name argument.
maxShiftSamp=$(read_script_parameter "$session" maxShiftSamp)
maxShiftSamp=${maxShiftSamp:-10}

corrThreshold=$(read_script_parameter "$session" corrThreshold)
corrThreshold=${corrThreshold:-0.85}

residualThreshold=$(read_script_parameter "$session" residualThreshold)
residualThreshold=${residualThreshold:-0.25}

minSnrRms=$(read_script_parameter "$session" minSnrRms)
minSnrRms=${minSnrRms:-4.0}

minSpikesTemplate=$(read_script_parameter "$session" minSpikesTemplate)
minSpikesTemplate=${minSpikesTemplate:-30}

corrWindow=$(read_script_parameter "$session" corrWindow)
corrWindow=${corrWindow:-0}

excludeNoise=$(read_script_parameter "$session" excludeNoise)
excludeNoise=${excludeNoise:-true}

overwrite=$(read_script_parameter "$session" overwrite)
overwrite=${overwrite:-false}

nWorkers=$(read_script_parameter "$session" nWorkers)
nWorkers=${nWorkers:-0}

useGpu=$(read_script_parameter "$session" useGpu)
useGpu=${useGpu:-false}

# Acquisition parameters
samplingRate=$(yaml_read "$session" "//acquisitionSystem/samplingRate")
nChannels=$(yaml_read    "$session" "//acquisitionSystem/nChannels")
nBits=$(yaml_read        "$session" "//acquisitionSystem/nBits")
nSpikeGroups=$(yaml_count "$session" "//spikeDetection/channelGroups/group")

[ -z "$nSpikeGroups" ] || [ "$nSpikeGroups" -eq 0 ] && {
    echo_error "No spikeDetection groups found in $yamlfile"; exit $GENERAL_ERROR; }

# Count curated groups
clu_count=0
for (( g=1; g<=nSpikeGroups; g++ )); do
    [ -f "$session.clu.$g" ] && (( clu_count++ ))
done
[ "$clu_count" -eq 0 ] && {
    echo_error "No .clu files found. Run spike sorting and curation first."
    exit $INPUTS_MISSING; }
echo_message "Found $clu_count/$nSpikeGroups curated spike groups"

# Check at least one .spk or .spkD file exists (the C++ binary prefers
# .spkD when both are present — stderiv pipeline output).
spk_count=0
for (( g=1; g<=nSpikeGroups; g++ )); do
    { [ -f "$session.spk.$g" ] || [ -f "$session.spkD.$g" ]; } && (( spk_count++ ))
done
[ "$spk_count" -eq 0 ] && {
    echo_error "No .spk/.spkD files found. Waveform data is required for collision decomposition."
    exit $INPUTS_MISSING; }

# Check outputs (per-group .col files)
if [ "$overwrite" != "true" ]; then
    all_exist=true
    for (( g=1; g<=nSpikeGroups; g++ )); do
        [ -f "$session.clu.$g" ] && \
        { [ -f "$session.spk.$g" ] || [ -f "$session.spkD.$g" ]; } && \
        [ ! -f "$session.col.$g" ] && all_exist=false
    done
    if $all_exist; then
        echo_message "All .col files already exist; set overwrite=true to rerun"
        exit $OUTPUTS_EXIST
    fi
fi

process_decomposecollisions \
    --session              "$session"         \
    --param-file           "$yamlfile"        \
    --n-channels           "$nChannels"       \
    --n-groups             "$nSpikeGroups"    \
    --max-shift-samp       "$maxShiftSamp"    \
    --corr-threshold       "$corrThreshold"   \
    --residual-threshold   "$residualThreshold" \
    --min-snr-rms          "$minSnrRms"       \
    --min-spikes-template  "$minSpikesTemplate" \
    --corr-window          "$corrWindow"      \
    --n-workers            "$nWorkers"        \
    --gpu                  "$useGpu"          \
    --exclude-noise        "$excludeNoise"    \
    --overwrite            "$overwrite"

status=$?
[ $status -ne 0 ] && {
    echo_error "process_decomposecollisions failed (exit $status)"
    exit $GENERAL_ERROR; }

echo_message "Collision sidecar files written: ${session}.col.1 … ${session}.col.${nSpikeGroups}"
exit $NO_ERROR
