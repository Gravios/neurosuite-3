#!/usr/bin/env bash
#////////////////////////////////////////////////////////////////////////////
#//   DEPRECATED: folded into ndm_pca.
#//   `ndm_pca_stderiv [args]` == `ndm_pca --method stderiv [args]`.
#//   Kept as a thin shim so existing pipelines / session-YAML program entries
#//   keep running.  Prefer setting `method: stderiv` under ndm_pca.
#////////////////////////////////////////////////////////////////////////////
# -h/--help: this notice; the plugin handshake: decline (see ndm_functions).
for a in "$@"; do
	case "$a" in -h|--help) grep '^#//' "$0" | sed 's|^#//[[:space:]]\{0,3\}||' | grep -v '^/*$'; exit 0 ;; esac
done
case "${1:-}" in --ndm-version|--ndm-describe) exit 1 ;; esac
# Legacy sessions keep their parameters under the old program node; export
# alt_program so read_script_parameter falls back to it.
export alt_program=ndm_pca_stderiv
echo "ndm_pca_stderiv is deprecated; use 'ndm_pca --method stderiv'." >&2
exec ndm_pca --method stderiv "$@"
