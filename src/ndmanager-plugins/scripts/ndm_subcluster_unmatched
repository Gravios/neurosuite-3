#!/bin/bash
#////////////////////////////////////////////////////////////////////////////
#//
#//   Re-cluster the "unmatched" bin produced by process_shadowcluster.
#//
#//   After a ndm_reextractspikes / ndm_reextractspikes_stderiv run,
#//   each group's .clu.N contains the original cluster IDs plus:
#//     - shadow(k) = maxExistingId + 1 + k    (new spikes gated into
#//                   cluster k by robust Mahalanobis distance)
#//     - unmatched = 2 * maxExistingId + 2    (single bin holding all
#//                   new spikes that exceeded the χ² threshold from
#//                   every eligible parent)
#//
#//   The unmatched bin is often large (~90% of re-extracted spikes in
#//   typical sessions) and heterogeneous — it mixes genuinely novel
#//   low-amplitude units, collision artefacts, mis-masked existing
#//   spikes, and real noise.  Running KlustaKwik on this bin alone
#//   recovers the sub-structure so the operator can triage in Klusters
#//   with actual cluster labels instead of one amorphous pile.
#//
#//   Per-group activation is gated on the .shadowmark.<g> sidecar
#//   written by process_shadowcluster.  When absent, the group was
#//   never shadow-merged (e.g. reextract Pass 1 accepted 0 new spikes)
#//   and there is no unmatched bin to recluster — the group is skipped.
#//   This replaces the pre-rev-3 max(clu_ids) heuristic, which silently
#//   destroyed pre-existing noise/MUA bins on groups that bypassed
#//   shadowcluster entirely.
#//
#//   Pipeline-aware extension detection:
#//     - Reads from .fetD.N if present (stderiv / sdiffOrder ∈ {1, 3}
#//       pipeline), otherwise from .fet.N (raw pipeline).  This matches
#//       the convention established by ndm_reextractspikes_stderiv and
#//       ndm_reextractspikes.  .clu.N and .res.N are canonical (no D
#//       variant).
#//     - Sandbox output is ALWAYS written as .fet (not .fetD) regardless
#//       of the input variant, because KlustaKwik hard-codes the .fet
#//       extension when reading (klustakwik/KK.cpp:117).  There's no
#//       consumer for .fetD once the KK step is reached, so this is just
#//       a naming choice internal to the sandbox.
#//     - The session yaml is symlinked into the sandbox stem for the
#//       duration of the KK call so kkReadYamlSpikeParams sees the
#//       session's SamplingRate / channelIds / probe geometry.  Without
#//       this shim, KK falls back to SamplingRate=20000 with all probe
#//       fields unset, breaking chunked CEM and drift-aware paths.
#//
#//   Flow:
#//     1. Read $session.shadowmark.$g for the authoritative unmatched id.
#//        Skip if absent (group was not shadow-merged) or n_unmatched=0.
#//     2. Read $session.clu.$g, locate rows where clu == unmatched_id.
#//     3. Extract those rows from $session.{fet,fetD}.$g into a sandbox:
#//          $session-unmatched-$g.fet.$g   (always .fet for KK)
#//     4. Symlink session yaml → $session-unmatched-$g.<ext> so KK reads
#//        session params, then run KlustaKwik on the sandbox stem →
#//          $session-unmatched-$g.clu.$g
#//        Tear down the symlink regardless of KK exit status.
#//     5. Remap sandbox cluster IDs (1..K) to offset IDs
#//          (unmatched_id + 1) .. (unmatched_id + K)
#//        and merge back into $session.clu.$g over the unmatched rows.
#//        The final .clu.N header is updated to reflect the new max ID.
#//     6. Sandbox files removed on success; shadowmark rotated to
#//        .shadowmark.$g.done; originals preserved at
#//        $session.clu.$g.bak-sub (first-run wins, same policy as the
#//        re-extract scripts).
#//
#//   WAVEFORMS ARE NOT TOUCHED.  Re-clustering only affects the .clu
#//   file; .spk / .spkD / .fet / .fetD / .res stay exactly as they
#//   were after shadow-cluster merge.  The Mahalanobis subspace that
#//   defined "unmatched" is the reference .fet / .fetD space, so
#//   re-clustering happens in that same space — no waveform
#//   reprocessing required.
#//
#//   Arguments:  [parameter-file]  [electrodeGroup]
#//   If electrodeGroup is omitted, processes every group whose
#//   .shadowmark.<g> sidecar is present; groups without one are skipped.
#//
#//   copyright       (C) 2025 neurosuite-3 contributors
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////

source ndm_functions

program=$(basename "$0")
if [ $# -gt 2 ]; then
    echo_error "usage: $program [parameter-file] [electrodeGroup]"
    exit $GENERAL_ERROR
fi
directory=$(basename "$(pwd)")
session=${1:-$directory}
session=${session%.xml}
session=${session%.yaml}
session=${session%.yml}
param_ext=$(param_file_ext "$session")
electrodeGroup=$2

print_header "$session - Re-cluster unmatched bin from shadow-cluster merge"

check_commands_installed KlustaKwik python3

nElectrodeGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")
if [ "$nElectrodeGroups" -eq 0 ]; then
    echo_error "missing spike groups"
    exit $GENERAL_ERROR
fi

# ////////////////////////////////////////////////////////////////////////////
# //  Helper: extract unmatched rows from .fet OR .fetD into a sandbox
# //  .fet file (output is always .fet because KlustaKwik hard-codes that
# //  extension when reading its input).
# //
# //  The .fet.N / .fetD.N format is identical:
# //    int32 nDims header; then nSpikes × nDims × int64 rows.
# //  The .clu.N format is:
# //    int32 nClusters header; then nSpikes × int32 IDs.
# //  The two files are row-aligned (same index).
# //
# //  Caller passes:
# //    fetExt        ∈ {"fet","fetD"} — which variant to read from
# //    unmatchedId   the bin id taken from $session.shadowmark.<g>
# //                  (NOT inferred from max(clu_ids); see the rationale
# //                  in once() below)
# //
# //  Output is a sandbox stem with the same group suffix so KlustaKwik
# //  reads it naturally.  Returns the count on stdout, or empty string if
# //  no rows matched the supplied unmatched id.
# ////////////////////////////////////////////////////////////////////////////

extract_unmatched()
{
    local group=$1
    local sandboxStem=$2
    local fetExt=$3       # "fet" or "fetD"
    local unmatchedId=$4  # authoritative id from the shadowmark sidecar

    python3 - "$session" "$group" "$sandboxStem" "$fetExt" "$unmatchedId" <<'PYEOF'
import struct, sys, os
session, group, sandboxStem, fetExt, unmatched_id = (
    sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5]))

# .clu.N is canonical (no D variant, per the shadowcluster convention
# established in reextract rev 1+).  Feature file is the .fetExt variant
# — could be .fet or .fetD depending on whether the sort ran through
# the raw or stderiv pipeline.  KlustaKwik, however, hard-codes .fet
# when reading (klustakwik/KK.cpp:117), so the sandbox OUTPUT must
# always be .fet regardless of input.
clu_path = f"{session}.clu.{group}"
fet_path = f"{session}.{fetExt}.{group}"
out_fet  = f"{sandboxStem}.fet.{group}"

with open(clu_path, "rb") as f:
    clu_buf = f.read()
nClusters = struct.unpack("<i", clu_buf[:4])[0]
clu_ids = list(struct.unpack(f"<{(len(clu_buf)-4)//4}i", clu_buf[4:]))

# Caller passes the unmatched id from the shadowmark sidecar — the
# authoritative source.  We deliberately do NOT fall back to
# max(clu_ids) here: that heuristic mis-fires when shadowcluster
# never ran on this group (e.g. reextract Pass 1 accepted 0 new
# spikes), in which case max(clu_ids) is just the largest pre-existing
# cluster (typically the original noise/MUA bin) and re-clustering it
# silently destroys the operator's prior sort.
unmatched_rows = [i for i, c in enumerate(clu_ids) if c == unmatched_id]
if len(unmatched_rows) == 0:
    sys.exit(0)

# Extract matching rows from the .fet or .fetD file into the sandbox .fet.
with open(fet_path, "rb") as f:
    fet_buf = f.read()
nDims = struct.unpack("<i", fet_buf[:4])[0]
row_bytes = nDims * 8
hdr_size  = 4
total_rows = (len(fet_buf) - hdr_size) // row_bytes
assert total_rows == len(clu_ids), \
    f"clu/fet row mismatch: clu={len(clu_ids)} fet={total_rows}"

os.makedirs(os.path.dirname(os.path.abspath(out_fet)) or ".", exist_ok=True)
with open(out_fet, "wb") as f:
    f.write(struct.pack("<i", nDims))
    for row_idx in unmatched_rows:
        start = hdr_size + row_idx * row_bytes
        f.write(fet_buf[start:start + row_bytes])

# Report only the row count to the caller (unmatched_id was supplied).
print(f"{len(unmatched_rows)}")
PYEOF
}

# ////////////////////////////////////////////////////////////////////////////
# //  Helper: merge sandbox clu back into live clu with offset IDs.
# //
# //  Input:
# //    $session.clu.$g       live clu with unmatched rows tagged with
# //                          unmatched_id
# //    $sandboxStem.clu.$g   KlustaKwik output; IDs are 1..K (or 2..K+1,
# //                          with cluster 1 being noise in KK convention)
# //
# //  Output:
# //    $session.clu.$g       rewritten with unmatched rows replaced by
# //                          (unmatched_id + sub_id).  Rows that KK
# //                          labelled as "noise" (cluster 1) retain the
# //                          unmatched_id so the operator can still see
# //                          the residual bin.
# ////////////////////////////////////////////////////////////////////////////

merge_subcluster()
{
    local group=$1
    local sandboxStem=$2
    local unmatchedId=$3

    python3 - "$session" "$group" "$sandboxStem" "$unmatchedId" <<'PYEOF'
import struct, sys
session, group, sandboxStem, unmatched_id = \
    sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
live_clu = f"{session}.clu.{group}"
sub_clu  = f"{sandboxStem}.clu.{group}"

with open(live_clu, "rb") as f:
    lbuf = f.read()
with open(sub_clu, "rb") as f:
    sbuf = f.read()

n_live = struct.unpack("<i", lbuf[:4])[0]
live_ids = list(struct.unpack(f"<{(len(lbuf)-4)//4}i", lbuf[4:]))
sub_header = struct.unpack("<i", sbuf[:4])[0]
sub_ids = list(struct.unpack(f"<{(len(sbuf)-4)//4}i", sbuf[4:]))

unmatched_rows = [i for i, c in enumerate(live_ids) if c == unmatched_id]
assert len(unmatched_rows) == len(sub_ids), \
    f"subcluster row count mismatch: live={len(unmatched_rows)} sub={len(sub_ids)}"

# KlustaKwik convention: cluster 1 = noise.  Keep noise-labelled rows
# in the unmatched bin so the operator sees one consolidated residual
# (if we promoted them all to distinct offsets they'd fragment the
# cluster space with tiny bins).  Non-noise sub-IDs k≥2 become
# (unmatched_id + (k - 1)) so the first real sub-cluster starts at
# (unmatched_id + 1), not (unmatched_id + 2).
offset = unmatched_id   # so sub_id=2 → offset+1
max_sub = max((s for s in sub_ids if s >= 2), default=1)
max_new_id = offset + (max_sub - 1) if max_sub >= 2 else unmatched_id

for row_idx, sub_id in zip(unmatched_rows, sub_ids):
    if sub_id <= 1:
        # KK noise → leave in the unmatched bin
        continue
    live_ids[row_idx] = offset + (sub_id - 1)

# Final nClusters = 1 + count of distinct positive IDs (cluster 0 is
# always counted in the header regardless of presence).  Recompute
# from scratch to match Klusters' expectation.
distinct = sorted(set(live_ids))
new_nClusters = len(distinct)

with open(live_clu, "wb") as f:
    f.write(struct.pack("<i", new_nClusters))
    f.write(struct.pack(f"<{len(live_ids)}i", *live_ids))

n_promoted = sum(1 for s in sub_ids if s >= 2)
n_noise    = len(sub_ids) - n_promoted
print(f"promoted={n_promoted} noise_kept={n_noise} "
      f"new_clusters={(max_sub - 1) if max_sub >= 2 else 0} "
      f"max_new_id={max_new_id} total_nClusters={new_nClusters}")
PYEOF
}

# ////////////////////////////////////////////////////////////////////////////
# //  Per-group processing
# ////////////////////////////////////////////////////////////////////////////

once()
{
    local group=$1

    # .clu.N is canonical (no D variant); .param_ext is the session yaml.
    inputs_missing "$session.$param_ext" \
                   "$session.clu.$group" \
        && return $INPUTS_MISSING

    # Feature file: prefer the stderiv variant (.fetD) then fall back to
    # raw (.fet).  ndm_pca_stderiv writes .fetD for sdiffOrder ∈ {1, 3}
    # pipelines; ndm_pca writes .fet for the standard raw pipeline.  The
    # shadowcluster merge (rev 6 onward) leaves whichever extension the
    # sort was performed in, so the sub-clustering must honour the same.
    local fetExt
    if   [ -f "$session.fetD.$group" ]; then
        fetExt=fetD
    elif [ -f "$session.fet.$group" ]; then
        fetExt=fet
    else
        echo_warning "  group $group: no .fet or .fetD — skipping"
        return $INPUTS_MISSING
    fi

    # ── Authoritative unmatched-bin lookup (shadowmark sidecar) ────────────
    #
    # Pre-rev-3 behaviour was to take unmatched_id = max(clu_ids) and run
    # KlustaKwik on whatever rows matched.  This is unsafe whenever
    # process_shadowcluster did NOT actually run on this group — for
    # example, when reextract Pass 1 accepted 0 new spikes (typical for
    # most groups in a session) — because then max(clu_ids) is the
    # operator's largest pre-existing cluster, usually the noise/MUA bin,
    # and re-clustering it silently destroys the prior sort.
    #
    # The sidecar $session.shadowmark.<g> is written atomically by
    # process_shadowcluster and committed by the reextract wrapper; its
    # presence is the contract that says "this group was shadow-merged,
    # here is the residual bin".  If absent, we skip — the operator
    # should re-run ndm_reextractspikes / _stderiv to (re)produce the
    # sidecar before sub-clustering.
    local markFile="$session.shadowmark.$group"
    if [ ! -f "$markFile" ]; then
        echo_info "  group $group: no $markFile — shadowcluster did not run on this group; skipping"
        return $NO_ERROR
    fi
    local unmatchedId nUnmatchedFromMark
    unmatchedId=$(awk '$1=="unmatched_id"   {print $2; exit}'  "$markFile")
    nUnmatchedFromMark=$(awk '$1=="n_unmatched" {print $2; exit}' "$markFile")
    if [ -z "$unmatchedId" ]; then
        echo_warning "  group $group: $markFile missing unmatched_id key — skipping"
        return $GENERAL_ERROR
    fi
    if [ "${nUnmatchedFromMark:-0}" = "0" ]; then
        echo_info "  group $group: shadowmark reports n_unmatched=0 — nothing to sub-cluster, skipping"
        # Mark as done so we don't keep reading the sidecar on re-runs.
        mv -f "$markFile" "$markFile.done"
        return $NO_ERROR
    fi

    # Idempotence: if we've already sub-clustered this group, the backup
    # .clu.$group.bak-sub exists.  Don't re-process — the operator can
    # rm the .bak-sub to force a re-run.
    if [ -f "$session.clu.$group.bak-sub" ]; then
        echo_info "  group $group: .clu.$group.bak-sub exists — skipping"
        echo_info "    (remove the .bak-sub file to force a re-sub-cluster)"
        return $OUTPUTS_EXIST
    fi

    local sandboxStem=$session-unmatched-$group

    # Clean any stragglers from a previous aborted run.  Sandbox output is
    # always .fet (not .fetD) because KlustaKwik hard-codes .fet — no
    # consumer reads .fetD.  The extractor below writes {sandbox}.fet.{g}
    # regardless of whether input was .fet.{g} or .fetD.{g}.  The yaml
    # symlink (for KK's session-param auto-detection) is also cleaned
    # so a stale dangling link does not poison this run.
    rm -f "$sandboxStem.fet.$group" "$sandboxStem.clu.$group" \
          "$sandboxStem.klg.$group" "$sandboxStem.temp.clu.$group" \
          "$sandboxStem.yaml" "$sandboxStem.yml" "$sandboxStem.xml"

    # Pass 1: extract unmatched rows to sandbox .fet using the unmatched
    # id supplied by the shadowmark sidecar.
    local nUnmatched
    nUnmatched=$(extract_unmatched "$group" "$sandboxStem" "$fetExt" "$unmatchedId")
    if [ -z "$nUnmatched" ]; then
        echo_info "  group $group: shadowmark unmatched_id=$unmatchedId not present in live .clu — skipping"
        echo_info "    (group may have been hand-edited since the shadow merge)"
        rm -f "$sandboxStem.fet.$group"
        return $NO_ERROR
    fi

    echo_info "  group $group: unmatched cluster id=$unmatchedId, $nUnmatched spikes (read from .$fetExt.$group)"

    # Pass 2: KlustaKwik on the sandbox stem.  Uses the same three-tier
    # parameter resolution as ndm_klustakwik by delegating through that
    # wrapper.  ndm_klustakwik reads session.$param_ext for per-group
    # KK params; since we run it against the REAL session yaml (not a
    # sandbox yaml), per-group params are preserved.  But ndm_klustakwik
    # also expects session.fet.$group to be the full feature file — so
    # we temporarily point it at the sandbox via symlink, same pattern
    # as the reextract scripts.
    #
    # Actually simpler: call KlustaKwik directly with the sandbox stem,
    # reading KK params from the real session yaml.  KlustaKwik takes
    # <session> <group> as positionals — if we pass the sandbox stem it
    # writes .clu.$group next to the sandbox .fet.
    #
    # Parameter resolution mirrors ndm_klustakwik: read from the REAL
    # session yaml, pass values explicitly on the command line.
    local electrodes nFeatures
    electrodes=($(yaml_read $session "//spikeDetection/channelGroups/group[$group]/channels/channel"))
    local nElectrodes=${#electrodes[*]}
    nFeatures=$(yaml_read $session "//spikeDetection/channelGroups/group[$group]/nFeatures")
    check_mandatory_variable $nFeatures "missing nFeatures for group $group"

    # Read sandbox .fet's actual nDims for logging and sanity.  Use
    # UseFeatures=all to avoid pipeline-dependent arithmetic: KK parses
    # the .fet header and selects all dimensions when given "all".
    # This is robust across raw / stderiv / extra-peak variants.
    local sandboxDims
    sandboxDims=$(python3 -c "
import struct
with open('$sandboxStem.fet.$group','rb') as f: print(struct.unpack('<i', f.read(4))[0])")
    echo_info "  group $group: sandbox .fet.$group has $sandboxDims dims"
    if [ -z "$sandboxDims" ] || [ "$sandboxDims" -le 1 ]; then
        echo_error "  group $group: unreadable or degenerate sandbox .fet (nDims=$sandboxDims)"
        rm -f "$sandboxStem.fet.$group"
        return $GENERAL_ERROR
    fi

    # Per-group KK parameter read — full three-tier resolution via the
    # shared read_kk_param from ndm_functions.  Defaults here mirror
    # those in ndm_klustakwik so the sandbox benefits from the same
    # compile-time fallback values when the YAML omits a given knob.
    #
    # The sandbox operates on an OUTLIER bin (typically 80-90 %% of
    # re-extracted spikes), so the parameters most likely to unlock
    # sub-structure in a pre-collapsed feature space matter the most:
    #   nStarts              — multiple random inits escape local minima
    #   ChunkMinutes         — enables time-chunked CEM on long recordings
    #   SubspaceRecluster /
    #     SubspaceReclusterDepth — per-cluster subspace CEM splits clusters
    #                              that coalesced in the full 22-D space
    #   Phase15Iters         — xcorr realignment sharpens within-cluster
    #                          structure before the final merge
    #   TemplateMatchScore   — within-chunk template matching merges over-
    #                          split chunks more conservatively than χ²
    local minClusters maxClusters maxPossibleClusters mergeThresh
    local globalMergeIter timeMergeIter
    local nStarts nRuns phase15Iters initMethod penaltyMix
    local chunkMinutes chunkOverlapMinutes chunkPreseedFraction
    local maxIter splitEvery distThresh fullStepEvery changedThresh
    local subspaceDims subspaceRecluster subspaceReclusterDepth
    local templateMatchScore templateMatchIters splitRecurseDepth
    local crossChunkTemplateScore

    # ── Probe-keyed prior resolution ─────────────────────────────────────────
    # Try to locate a <probe_id>.<group>.prior.yaml whose probe_id matches
    # this session's channel-group structure.  When found, it shadows the
    # session yaml's per-shank defaults below: read_kk_param falls back to
    # the prior's value when the session yaml has no entry.  The session
    # yaml STILL wins if it explicitly sets a key, so per-recording overrides
    # remain possible.
    #
    # Resolution is best-effort: if kk_resolve_prior.py is missing, fails to
    # find a match, or returns a probe_id mismatch, we fall through to the
    # built-in defaults silently.  No prior == old behaviour exactly.
    local priorFile priorMinC priorMaxC priorMerge priorPenMix
    priorFile=""
    priorMinC=""; priorMaxC=""; priorMerge=""; priorPenMix=""
    if command -v kk_resolve_prior.py >/dev/null 2>&1; then
        priorFile=$(kk_resolve_prior.py --session "$session" --group "$group" 2>/dev/null || true)
    fi
    if [ -n "$priorFile" ] && [ -f "$priorFile" ]; then
        # Pull the four headline keys with python — small, no extra deps.
        # Each fetch prints empty on missing key so the read_kk_param defaults
        # still work below.
        local _py
        _py=$(python3 - "$priorFile" <<'PYEOF'
import sys, yaml
p = yaml.safe_load(open(sys.argv[1])) or {}
nc = p.get("n_clusters", {}) or {}
ed = p.get("effective_dimensionality", {}) or {}
print("MINC=%s"   % nc.get("p05",    ""))
print("MAXC=%s"   % nc.get("p95",    ""))
print("MERGE=%s"  % ed.get("merge_thresh_from_median_d_eff", ""))
print("PENMIX=%s" % p.get("penalty_mix_suggested", ""))
PYEOF
        )
        eval "$_py"
        priorMinC=${MINC:-}
        priorMaxC=${MAXC:-}
        priorMerge=${MERGE:-}
        priorPenMix=${PENMIX:-}
        echo_info "  group $group: prior $priorFile"
        echo_info "    minC=$priorMinC maxC=$priorMaxC merge=$priorMerge penaltyMix=$priorPenMix"
    fi

    # Helper: prefer prior value over the static default when the prior
    # provided one.  read_kk_param consults the session yaml first, so an
    # explicit per-shank override there still wins over the prior.
    local _dMinC=2; [ -n "$priorMinC" ] && _dMinC=$priorMinC
    local _dMaxC=100; [ -n "$priorMaxC" ] && _dMaxC=$priorMaxC
    local _dMerge=42.0; [ -n "$priorMerge" ] && _dMerge=$priorMerge
    local _dPenMix=0; [ -n "$priorPenMix" ] && _dPenMix=$priorPenMix

    minClusters=$(read_kk_param -b ndm_subcluster_unmatched $group minClusters $_dMinC)
    maxClusters=$(read_kk_param -b ndm_subcluster_unmatched $group maxClusters $_dMaxC)
    maxPossibleClusters=$(read_kk_param -b ndm_subcluster_unmatched $group maxPossibleClusters 500)
    mergeThresh=$(read_kk_param -b ndm_subcluster_unmatched $group mergeThresh $_dMerge)
    globalMergeIter=$(read_kk_param -b ndm_subcluster_unmatched $group globalMergeIter 50)
    timeMergeIter=$(read_kk_param -b ndm_subcluster_unmatched $group timeMergeIter 50)
    nStarts=$(read_kk_param -b ndm_subcluster_unmatched $group nStarts 3)
    nRuns=$(read_kk_param -b ndm_subcluster_unmatched $group nRuns 0)
    phase15Iters=$(read_kk_param -b ndm_subcluster_unmatched $group phase15Iters 2)
    initMethod=$(read_kk_param -b ndm_subcluster_unmatched $group initMethod farthest)
    penaltyMix=$(read_kk_param -b ndm_subcluster_unmatched $group penaltyMix $_dPenMix)
    chunkMinutes=$(read_kk_param -b ndm_subcluster_unmatched $group chunkMinutes 10)
    chunkOverlapMinutes=$(read_kk_param -b ndm_subcluster_unmatched $group chunkOverlapMinutes 2)
    chunkPreseedFraction=$(read_kk_param -b ndm_subcluster_unmatched $group chunkPreseedFraction 0.05)
    maxIter=$(read_kk_param -b ndm_subcluster_unmatched $group maxIter 500)
    splitEvery=$(read_kk_param -b ndm_subcluster_unmatched $group splitEvery 25)
    distThresh=$(read_kk_param -b ndm_subcluster_unmatched $group distThresh 6.9)
    fullStepEvery=$(read_kk_param -b ndm_subcluster_unmatched $group fullStepEvery 10)
    changedThresh=$(read_kk_param -b ndm_subcluster_unmatched $group changedThresh 0.05)
    subspaceDims=$(read_kk_param -b ndm_subcluster_unmatched $group subspaceDims 3)
    subspaceRecluster=$(read_kk_param -b ndm_subcluster_unmatched $group subspaceRecluster 1)
    subspaceReclusterDepth=$(read_kk_param -b ndm_subcluster_unmatched $group subspaceReclusterDepth 2)
    templateMatchScore=$(read_kk_param -b ndm_subcluster_unmatched $group templateMatchScore 0.0)
    templateMatchIters=$(read_kk_param -b ndm_subcluster_unmatched $group templateMatchIters 10)
    splitRecurseDepth=$(read_kk_param -b ndm_subcluster_unmatched $group splitRecurseDepth 0)
    crossChunkTemplateScore=$(read_kk_param -b ndm_subcluster_unmatched $group crossChunkTemplateScore 0.0)

    # Thread count: same strategy as ndm_klustakwik — 0 means "all cores".
    local nThreads
    nThreads=$(read_kk_param -b ndm_subcluster_unmatched $group nThreads 0)
    if [ "$nThreads" -le 0 ] 2>/dev/null; then
        nThreads=$(nproc 2>/dev/null || echo 1)
    fi
    export OMP_NUM_THREADS=$nThreads
    export OMP_WAIT_POLICY=passive

    print_header "  group $group - KlustaKwik on $nUnmatched unmatched spikes"

    # ── YAML visibility shim ────────────────────────────────────────────────
    #
    # KlustaKwik calls kkReadYamlSpikeParams(FileBase, ElecNo) which probes
    # for <FileBase>.yaml then <FileBase>.yml.  When invoked against the
    # sandbox stem ($sandboxStem = $session-unmatched-<g>) those probes
    # miss and KK falls back to SamplingRate=20000 with all probe geometry
    # / channelIds / nbSamples / peakSampleIndex unset (visible in the log
    # as "SamplingRate defaulting to 20000 Hz").  That fallback breaks
    # chunked CEM math whenever the session SR != 20000 and silently
    # disables drift-aware paths that need site positions.
    #
    # Symlink the live session yaml to the sandbox stem just for the
    # duration of the KK call.  The symlink is removed regardless of KK
    # exit status so a crash mid-run does not leave a stale link behind.
    local yamlShim=""
    if [ -f "$session.$param_ext" ]; then
        yamlShim="$sandboxStem.$param_ext"
        # Refuse to clobber a pre-existing real file (defensive: shouldn't
        # happen given the cleanup above, but a half-aborted prior run
        # could in principle leave one).
        if [ -e "$yamlShim" ] && [ ! -L "$yamlShim" ]; then
            echo_error "  group $group: $yamlShim exists and is not a symlink; refusing to clobber"
            return $GENERAL_ERROR
        fi
        ln -sf "$(basename "$session.$param_ext")" "$yamlShim"
    fi

    # Invocation mirrors ndm_klustakwik line-for-line, except:
    #   -UseFeatures all              — always use every sandbox feature
    #   -fSaveModel 0                 — no .model.N (sandbox is throw-away)
    #   -SaveIntermediates 0          — no intermediate .clu.N.M files
    # Everything else — nStarts, SubspaceRecluster*, TemplateMatch*, ChunkMinutes,
    # Phase15Iters, etc. — is passed through so the sub-run gets the same
    # clustering muscle as the main sort.
    KlustaKwik "$sandboxStem" "$group" \
        -MinClusters             $minClusters             \
        -MaxClusters             $maxClusters             \
        -MaxPossibleClusters     $maxPossibleClusters     \
        -UseFeatures             all                      \
        -nStarts                 $nStarts                 \
        -PenaltyMix              $penaltyMix              \
        -InitMethod              $initMethod              \
        -ChunkMinutes            $chunkMinutes            \
        -ChunkOverlapMinutes     $chunkOverlapMinutes     \
        -ChunkPreseedFraction    $chunkPreseedFraction    \
        -MergeThresh             $mergeThresh             \
        -GlobalMergeIter         $globalMergeIter         \
        -TimeMergeIter           $timeMergeIter           \
        -MaxIter                 $maxIter                 \
        -SplitEvery              $splitEvery              \
        -DistThresh              $distThresh              \
        -FullStepEvery           $fullStepEvery           \
        -ChangedThresh           $changedThresh           \
        -nRuns                   $nRuns                   \
        -Phase15Iters            $phase15Iters            \
        -SubspaceDims            $subspaceDims            \
        -SubspaceRecluster       $subspaceRecluster       \
        -SubspaceReclusterDepth  $subspaceReclusterDepth  \
        -TemplateMatchScore      $templateMatchScore      \
        -TemplateMatchIters      $templateMatchIters      \
        -SplitRecurseDepth       $splitRecurseDepth       \
        -CrossChunkTemplateScore $crossChunkTemplateScore \
        -Log                     1                        \
        -Screen                  0                        \
        -fSaveModel              0                        \
        -SaveIntermediates       0
    local kk_status=$?

    # Tear down YAML shim regardless of outcome — leaves no dangling link
    # on the next invocation, even if KK crashed mid-run.
    if [ -n "$yamlShim" ] && [ -L "$yamlShim" ]; then
        rm -f "$yamlShim"
    fi

    unset OMP_NUM_THREADS OMP_WAIT_POLICY

    if [ $kk_status -ne 0 ]; then
        echo_error "  group $group: KlustaKwik on unmatched bin failed (exit $kk_status); live .clu.$group untouched"
        rm -f "$sandboxStem.fet.$group" "$sandboxStem.clu.$group"
        return $kk_status
    fi

    if [ ! -s "$sandboxStem.clu.$group" ]; then
        echo_error "  group $group: KlustaKwik produced empty .clu.$group; live .clu.$group untouched"
        rm -f "$sandboxStem.fet.$group" "$sandboxStem.clu.$group"
        return $GENERAL_ERROR
    fi

    # Pass 3: backup live .clu, then merge sandbox IDs back with offset.
    # Atomic through temp-write + rename inside merge_subcluster.
    cp "$session.clu.$group" "$session.clu.$group.bak-sub"
    local merge_report
    merge_report=$(merge_subcluster "$group" "$sandboxStem" "$unmatchedId")
    echo_info "  group $group: $merge_report"

    # Cleanup sandbox.
    rm -f "$sandboxStem.fet.$group" \
          "$sandboxStem.clu.$group" \
          "$sandboxStem.klg.$group" \
          "$sandboxStem.temp.clu.$group"

    # Rotate the shadowmark sidecar to .done so a re-run won't re-trigger
    # the sub-cluster on the same residual.  The .clu.$group.bak-sub
    # idempotence check above is the primary guard; rotating the sidecar
    # keeps the audit trail without the sidecar reading stale on a future
    # invocation that sees a manually-restored .clu.$group.
    if [ -f "$markFile" ]; then
        mv -f "$markFile" "$markFile.done"
    fi

    return $NO_ERROR
}

# ////////////////////////////////////////////////////////////////////////////
# //  Driver
# ////////////////////////////////////////////////////////////////////////////

if [ -z "$electrodeGroup" ]; then
    overallStatus=$NO_ERROR
    for (( g=1; g<=nElectrodeGroups; g++ )); do
        once $g
        s=$?
        if [ $s -ne $NO_ERROR ] && [ $s -ne $OUTPUTS_EXIST ] && [ $s -ne $INPUTS_MISSING ]; then
            overallStatus=$s
        fi
    done
    exit $overallStatus
else
    once $electrodeGroup
    exit $?
fi
