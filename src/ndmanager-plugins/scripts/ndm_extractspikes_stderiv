#!/bin/bash
#////////////////////////////////////////////////////////////////////////////
#//   DEPRECATED: folded into ndm_extractspikes.
#//   `ndm_extractspikes_stderiv [args]` == `ndm_extractspikes --method stderiv [args]`.
#//   Kept as a thin shim so existing pipelines / session-YAML program entries
#//   keep running.  Prefer setting `method: stderiv` under ndm_extractspikes.
#////////////////////////////////////////////////////////////////////////////
# Legacy sessions keep their parameters under the old program node; export
# alt_program so read_script_parameter falls back to it.
export alt_program=ndm_extractspikes_stderiv
echo "ndm_extractspikes_stderiv is deprecated; use 'ndm_extractspikes --method stderiv'." >&2
exec ndm_extractspikes --method stderiv "$@"
