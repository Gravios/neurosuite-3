#!/bin/bash
#////////////////////////////////////////////////////////////////////////////
#//  ndm_estimatedrift — estimate spatial drift from curated .clu files
#//
#//  Reads .res (spike times) and .clu (cluster assignments, post-curation)
#//  for each spikeDetection group, reconstructs per-unit waveform centre-
#//  of-mass (CoM) on the shank from the .spk file + probe geometry, then
#//  tracks how CoM positions shift over time windows.
#//
#//  Output: SESSION.drift (YAML)
#//
#//  copyright (C) 2025 neurosuite-3 contributors  GPL-3.0-or-later
#////////////////////////////////////////////////////////////////////////////

source ndm_functions

program=$(basename $0)
if [ $# -gt 1 ]; then
    echo_error "usage: $program [parameter-file]"
    exit $GENERAL_ERROR
fi

directory=$(basename "$(pwd)")
session=${1:-$directory}
session=${session%.xml}; session=${session%.yaml}; session=${session%.yml}

print_header "$session - Estimating spatial drift from curated .clu files"

check_commands_installed python3
python3 -c "import yaml, numpy" 2>/dev/null || {
    echo_error "Python packages missing: install pyyaml and numpy"; exit $GENERAL_ERROR; }

# Resolve the YAML parameter file — required; no XML fallback
yamlfile=$(find_yaml_file "$session")
[ -z "$yamlfile" ] && {
    echo_error "No parameter file found for session '$session' (expected ${session}.yaml)"; exit $INPUTS_MISSING; }
inputs_missing "$yamlfile" && exit $INPUTS_MISSING
outputs_exist  "$session.drift" && exit $OUTPUTS_EXIST

windowSec=$(read_script_parameter "$session" ndm_estimatedrift windowSec);  windowSec=${windowSec:-60}
minUnits=$(read_script_parameter  "$session" ndm_estimatedrift minUnits);   minUnits=${minUnits:-3}
minSpikes=$(read_script_parameter "$session" ndm_estimatedrift minSpikes);  minSpikes=${minSpikes:-20}
excludeNoise=$(read_script_parameter "$session" ndm_estimatedrift excludeNoise); excludeNoise=${excludeNoise:-true}
probeLibrary=$(read_script_parameter "$session" ndm_estimatedrift probeLibrary)

samplingRate=$(yaml_read "$session" "//acquisitionSystem/samplingRate")
nChannels=$(yaml_read    "$session" "//acquisitionSystem/nChannels")
nBits=$(yaml_read        "$session" "//acquisitionSystem/nBits")
nSpikeGroups=$(yaml_count "$session" "//spikeDetection/channelGroups/group")

[ -z "$nSpikeGroups" ] || [ "$nSpikeGroups" -eq 0 ] && {
    echo_error "No spikeDetection groups in $yamlfile"; exit $GENERAL_ERROR; }

clu_count=0
for (( g=1; g<=nSpikeGroups; g++ )); do
    [ -f "$session.clu.$g" ] && (( clu_count++ ))
done
[ "$clu_count" -eq 0 ] && {
    echo_error "No .clu files found. Run spike sorting and curation first."; exit $INPUTS_MISSING; }
echo_message "Found $clu_count/$nSpikeGroups curated spike groups"

# Locate the Python helper alongside this script, or in PATH
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY_HELPER="${SCRIPT_DIR}/process_estimatedrift.py"
[ -f "$PY_HELPER" ] || PY_HELPER="process_estimatedrift.py"

python3 "$PY_HELPER" \
    --session        "$session" \
    --param-file     "$yamlfile" \
    --sampling-rate  "$samplingRate" \
    --n-channels     "$nChannels" \
    --n-bits         "$nBits" \
    --n-groups       "$nSpikeGroups" \
    --window-sec     "$windowSec" \
    --min-units      "$minUnits" \
    --min-spikes     "$minSpikes" \
    --exclude-noise  "$excludeNoise" \
    ${probeLibrary:+--probe-library "$probeLibrary"} \
    --output         "$session.drift"

status=$?
[ $status -ne 0 ] && { echo_error "process_estimatedrift.py failed (exit $status)"; exit $GENERAL_ERROR; }
echo_message "Drift file written: $session.drift"
exit $NO_ERROR
