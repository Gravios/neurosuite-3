#!/bin/bash


#////////////////////////////////////////////////////////////////////////////
#//
#//   High-pass filtering (for spikes)
#//
#//   filter: butterworth (default) -- zero-phase Butterworth (process_butterworth):
#//           highPassHz (default 800), lowPassHz (default 0 = none), order
#//           (default 3; zero phase doubles it), precision (auto|double|single).
#//   filter: median -- the historical median-subtraction high-pass
#//           (process_medianfilter, windowHalfLength).
#//
#//   copyright       (C) 2007-2010 by Michaël Zugaro
#//   email           michael.zugaro@college-de-france.fr
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////

# Source helper functions
source ndm_functions

# Parse command-line
program=$(basename $0)
if [ $# -gt 1 ]
then
	echo_error "usage: $program [parameter-file]"
	exit $GENERAL_ERROR
fi
ndm_resolve_session "$@"
[ "$NDM_SHIFTED" = 0 ] && set -- "$session" "$@"
param_ext=$(param_file_ext "$session")

# Print a header to indicate current processing step
print_header "$session - High-pass filtering"

# Input data extension: the filter reads $session.$inputExtension (default dat),
# so it can filter an alternative, externally-processed source instead of the
# raw .dat (YAML field inputExtension; defaults to dat when unset).
inputExtension=$(read_script_parameter $session inputExtension)
inputExtension=${inputExtension:-dat}

# Check input and output files
outputs_exist $session.fil && exit $OUTPUTS_EXIST
inputs_missing "$session.$param_ext" "$session.$inputExtension" && exit $INPUTS_MISSING

filter=$(read_script_parameter $session filter)
filter=${filter:-butterworth}
case "$filter" in
	butterworth|median) ;;
	*) echo_error "filter must be butterworth or median (got '$filter')"; exit $GENERAL_ERROR ;;
esac

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Read Parameters
# ////////////////////////////////////////////////////////////////////////////////////////////////

nChannels=$(yaml_read $session "//acquisitionSystem/nChannels")
check_mandatory_variable $nChannels "missing number of channels"

if [ "$filter" = butterworth ]; then
	check_commands_installed xpathReader process_butterworth
	samplingRate=$(yaml_read $session "//acquisitionSystem/samplingRate")
	check_mandatory_variable $samplingRate "missing sampling rate"
	highPassHz=$(read_script_parameter $session highPassHz)
	lowPassHz=$(read_script_parameter $session lowPassHz)
	order=$(read_script_parameter $session order)
	precision=$(read_script_parameter $session precision)
	highPassHz=${highPassHz:-800}; lowPassHz=${lowPassHz:-0}
	order=${order:-3}; precision=${precision:-auto}
	echo_info " Butterworth zero-phase     : high-pass $highPassHz Hz$( [ "$lowPassHz" != 0 ] && echo ", low-pass $lowPassHz Hz"), order $order (x2 forward+backward), precision $precision"
	process_butterworth -n $nChannels -s $samplingRate -l $highPassHz -u $lowPassHz \
		-o $order -p $precision -v "$session.$inputExtension" $session.fil
	check_command_status process_butterworth
	exit $NO_ERROR
fi

check_commands_installed xpathReader process_medianfilter
windowHalfLength=$(read_script_parameter $session windowHalfLength)
# chunkSize: bytes to process per pass (default 64 GiB).
# Can be overridden per-session in the XML <ndm_hipass> parameters block.
# Uses yaml_read directly with the correct <n> element XPath (not read_script_parameter
# which incorrectly searches for <name> elements).
chunkSize=$(yaml_read $session "//program/n[.='ndm_hipass']/../parameters/parameter/n[.='chunkSize']/../value")
chunkSize=${chunkSize:-134217728}   # default: 128 MiB = 128*1024*1024

# Cap at 512 MiB regardless of what the XML says, to prevent OOM on large
# multi-channel recordings where the old 64 GiB default caused bad_alloc.
maxChunkSize=536870912   # 512 MiB
if [ "$chunkSize" -gt "$maxChunkSize" ] 2>/dev/null; then
    echo "ndm_hipass: chunkSize $chunkSize exceeds cap, clamping to $maxChunkSize"
    chunkSize=$maxChunkSize
fi

check_mandatory_variable $windowHalfLength "missing window half-length"

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Process
# ////////////////////////////////////////////////////////////////////////////////////////////////

process_medianfilter -n $nChannels -w $windowHalfLength -b $chunkSize -v "$session.$inputExtension" $session.fil
check_command_status process_medianfilter
