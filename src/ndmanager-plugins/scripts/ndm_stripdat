#!/bin/bash

#////////////////////////////////////////////////////////////////////////////
#//
#//   Remove spike waveforms from a .dat file to produce a spike-cleaned
#//   recording: <session>-spkclean.dat
#//
#//   Uses process_subtractspikes to subtract each spike's contribution
#//   from the raw voltage trace.  When .clu.N files are present, a
#//   per-cluster template model is used:
#//     - Asymmetric-exponential PC1 waveform model (shape variation)
#//     - Contamination exclusion (concomitant spike windows excluded
#//       from template estimation)
#//     - ISI-driven dual-template burst shape compensation
#//     - Projection-based amplitude scaling
#//   When no .clu.N exists for a group, the raw .spk.N waveforms are
#//   subtracted directly.
#//
#//   The original .dat is never modified.
#//
#//   Output
#//   ------
#//   <session>-spkclean.dat
#//
#//   Parameters (read from ndm_stripdat block of the YAML)
#//   -----------------------------------------------------
#//     stripClusters   : Which clusters to subtract (per group).
#//                       "default"  strip every cluster except 0 and 1
#//                                  (neurosuite convention: 0=artefact,
#//                                  1=MUA).  This is the default.
#//                       "all"      strip every cluster including noise/MUA.
#//                       "2,3,5"    strip only the listed cluster ids.
#//                       Only used when no per-group sidecar exists AND
#//                       auto-generation (see below) does not find any
#//                       curated units for that group.
#//     subtractionMode : Three strategies available.
#//                       "raw" (default) — subtract the raw .spk.N
#//                       waveform directly (Layer 0).  Near-exact
#//                       cancellation at spike windows; skips all
#//                       template modelling; fast.  Appropriate for
#//                       the iterative strip-good → re-detect workflow.
#//                       "model" — Layer 1 (per-cluster mean template +
#//                       ISI burst correction) or Layer 2 (exponential
#//                       PC1 shape model) with contamination-aware
#//                       neighbour cleaning and drift compensation.
#//                       Preserves the noise baseline at subtracted
#//                       spike windows.  Appropriate for LFP extraction
#//                       where you want the residual to look like
#//                       surrounding noise, not a hole in the trace.
#//                       "botm" — Bayes-Optimal Template Matching
#//                       (Proepper 2015, §3.4).  Estimates noise
#//                       covariance C from between-spike periods,
#//                       builds per-cluster matched filter f = C^(-1)·ξ,
#//                       subtracts with Bayes-optimal amplitude
#//                       a = (obs^T·f) / (ξ^T·f).  Closes the
#//                       implicit-white-noise gap in model mode.
#//                       Preserves noise baseline.  Slower than model
#//                       (covariance estimation + matrix inversion per
#//                       group) but mathematically principled.
#//     botmRidge       : Covariance ridge regularization for BOTM mode.
#//                       Only used when subtractionMode=botm.  Default
#//                       "1e-3" — raise if you see "covariance inversion
#//                       failed" errors (short recordings, few noise
#//                       samples).
#//     autoStrip       : "true" (default) to auto-generate a strip list
#//                       from the top-level YAML 'units:' block when no
#//                       per-group sidecar is present.  Any unit whose
#//                       'quality' field matches one of the qualityTags
#//                       (case-insensitive) is added to the list for its
#//                       group.  Set "false" to disable; only explicit
#//                       sidecars and stripClusters are then consulted.
#//     qualityTags     : Comma-separated quality labels that count as
#//                       "strip-worthy" during auto-generation.
#//                       Default: "good,great,excellent".
#//     overwrite       : "true" to re-run even if <session>-spkclean.dat
#//                       exists; default "false".
#//     redetectSpikes  : "yes" to chain ndm_redetectspikes afterwards.
#//
#//   Per-group sidecars and auto-generation
#//   --------------------------------------
#//   For any electrode group g, the priority for which clusters get
#//   stripped is:
#//     1. If <session>.strip.<g> exists, use it (explicit operator
#//        override).  Plain text: one integer cluster id per line,
#//        blank lines and '#' comments allowed.
#//     2. Else, if autoStrip=true and the YAML 'units:' block has at
#//        least one entry for group g, generate the list from unit
#//        entries whose 'quality' matches qualityTags.  Written to
#//        <session>.autostrip.<g> with a provenance header.  This file
#//        is regenerated on every ndm_stripdat run.
#//     3. Else, use the global stripClusters parameter.
#//     4. Else, the built-in default (strip every non-0/1 cluster).
#//
#//   Typical workflow: curate in Klusters; Klusters writes each unit's
#//   Quality field into the YAML; re-run ndm_stripdat; auto-generation
#//   picks up the newly-tagged units and subtracts them.  If you want
#//   a different set for a particular run, write <session>.strip.<g>
#//   by hand — it shadows the auto-generated list for that group.
#//
#//   Per-group sidecar
#//   -----------------
#//   For any electrode group g, a file <session>.strip.<g> will override
#//   the global stripClusters for that group.  The file is a plain text
#//   list of integer cluster ids (one per line; '#' comments and blanks
#//   allowed).  This is the recommended place to keep "curated good units"
#//   lists as you iterate.
#//
#//   Iterative strip-good → re-detect workflow
#//   -----------------------------------------
#//     1. Sort, curate.  Mark the clusters you trust as real.
#//     2. Write their ids into <session>.strip.<g> per group.
#//     3. Run ndm_stripdat      → <session>-spkclean.dat
#//     4. Run ndm_redetectspikes → new .res/.spk for missed spikes
#//     5. Sort the new detections, curate newcomers.
#//     6. Append confirmed newcomers to <session>.strip.<g> and
#//        re-run ndm_stripdat against the ORIGINAL .dat (the guard
#//        in this script prevents overwriting the existing clean dat;
#//        set overwrite=true or delete it first).
#//     7. Repeat until re-detection finds no new real units.
#//
#//   Typical next steps
#//   ------------------
#//   ndm_lfp              — downsample the cleaned dat to LFP
#//                          (auto-detects session-spkclean.dat)
#//   ndm_redetectspikes   — second-round spike detection on the cleaned dat
#//
#//   copyright       (C) 2025 neurosuite-3 contributors
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////

# Source helper functions
source ndm_functions

# Parse command-line
program=$(basename $0)
if [ $# -gt 1 ]
then
	echo_error "usage: $program [parameter-file]"
	exit $GENERAL_ERROR
fi
ndm_resolve_session "$@"
[ "$NDM_SHIFTED" = 0 ] && set -- "$session" "$@"
param_ext=$(param_file_ext "$session")

print_header "$session - Stripping spike waveforms from dat"

# ── Input checks ─────────────────────────────────────────────────────────────
inputs_missing "$session.$param_ext" $session.dat && exit $INPUTS_MISSING

check_commands_installed process_subtractspikes

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Read Parameters
# ////////////////////////////////////////////////////////////////////////////////////////////////

nChannels=$(yaml_read $session "//acquisitionSystem/nChannels")
samplingRate=$(yaml_read $session "//acquisitionSystem/samplingRate")
nBits=$(yaml_read $session "//acquisitionSystem/nBits")
redetectSpikes=$(read_script_parameter $session redetectSpikes)

# New optional parameters (ndm_stripdat block):
#   stripClusters : "default" (strip non-noise, excluding 0 and 1 — the
#                   neurosuite convention), "all" (strip every cluster),
#                   or a comma-separated list like "2,3,5".  This is the
#                   global default for every group that does NOT have
#                   a per-group sidecar file (see below).  Defaults to
#                   "default".
#   overwrite     : "true" to re-run even if $session-spkclean.dat exists.
#                   Defaults to "false".  Stripping a typical 3-hour
#                   recording takes tens of minutes, so the guard avoids
#                   accidental re-runs.
#
# Per-group override: if the file $session.strip.<g> exists, it is used
# for that group instead of the global stripClusters value.  The file is
# a plain text file with one integer cluster id per line; blank lines and
# lines starting with '#' are ignored.  This is the recommended way to
# iterate the strip-good-re-detect loop: after each curation round, update
# each group's $session.strip.<g> file and re-run ndm_stripdat.
stripClusters=$(read_script_parameter $session stripClusters)
check_optional_variable $stripClusters || stripClusters="default"

overwrite=$(read_script_parameter $session overwrite)
check_optional_variable $overwrite || overwrite="false"

# subtractionMode: "model" (Layer 1/2 cluster-aware; preserves baseline
# noise — appropriate for LFP extraction) or "raw" (Layer 0 raw .spk.N
# subtraction; near-exact cancellation, skips model fitting entirely —
# appropriate for the iterative strip-good-re-detect workflow because
# residual amplitude at subtracted spike windows falls below threshold).
# Default: "raw" — if you're running ndm_stripdat you're almost certainly
# either producing input to ndm_redetectspikes or cleaning for LFP; in
# either case raw is the safer choice (for re-detection it's better; for
# LFP the difference is invisible after downsampling).
subtractionMode=$(read_script_parameter $session subtractionMode)
check_optional_variable $subtractionMode || subtractionMode="raw"
if [ "$subtractionMode" != "model" ] \
   && [ "$subtractionMode" != "raw" ] \
   && [ "$subtractionMode" != "botm" ]
then
	echo_error "subtractionMode must be 'model', 'raw', or 'botm', got '$subtractionMode'"
	exit $GENERAL_ERROR
fi

# botmRidge: numerical regularization of noise covariance C in BOTM mode.
# Fraction of trace(C)/dim added to the diagonal before inversion.  Only
# used when subtractionMode=botm.  Default 1e-3 — raise if C is singular
# (e.g. very short recordings, few noise samples).
botmRidge=$(read_script_parameter $session botmRidge)
check_optional_variable $botmRidge || botmRidge="1e-3"

# autoStrip: when "true" (default), missing $session.strip.$g sidecars are
# auto-generated from the YAML's top-level 'units:' block.  A unit is
# included in the auto-generated strip list if its 'quality' label matches
# one of the configured qualityTags (case-insensitive).  When "false",
# only existing sidecars and the global stripClusters are consulted; no
# auto-generation.  Most users should leave this on: curation in Klusters
# populates the Quality field, and the strip sidecar "just works" on the
# next ndm_stripdat run.
autoStrip=$(read_script_parameter $session autoStrip)
check_optional_variable $autoStrip || autoStrip="true"

# qualityTags: comma-separated list of quality label strings that qualify
# a unit as "good enough to strip".  Matched case-insensitively against
# the trimmed quality field written by Klusters.  Default matches the
# descriptors in common use in the lab ("good", "great", "excellent").
# Users whose curation vocabulary differs (e.g. "single-unit", "SU",
# "accepted") can override here.
qualityTags=$(read_script_parameter $session qualityTags)
check_optional_variable $qualityTags || qualityTags="good,great,excellent"

check_mandatory_variable $nChannels   "missing number of channels"
check_mandatory_variable $samplingRate "missing sampling rate"

nBits=${nBits:-16}

# ── Output guard (before loading anything expensive) ─────────────────────
outputDat="$session-spkclean.dat"
if [ -f "$outputDat" ] && [ "$overwrite" != "true" ]
then
	echo_message "$outputDat already exists; set overwrite=true to re-run"
	exit $OUTPUTS_EXIST
fi

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Build group specs
# ////////////////////////////////////////////////////////////////////////////////////////////////

nElectrodeGroups=$(yaml_count $session "//spikeDetection/channelGroups/group")

if [ -z "$nElectrodeGroups" ] || [ "$nElectrodeGroups" -eq 0 ]
then
	echo_error "no spikeDetection/channelGroups found in parameter file"
	exit $GENERAL_ERROR
fi

# ── Map each spikeDetection group to its 1-based probe list position ─────────
# Reads probeId from each group's YAML entry; finds its position in the
# top-level probes: list (1-based).  Defaults to 1 on any error so that
# single-probe sessions work without needing a probes: block.
mapGroupToProbeIdx()
{
	python3 - "$1" "$session" << 'PEOF'
import sys, yaml, os
group   = int(sys.argv[1])
session = sys.argv[2]
yamlfile = next((session + e for e in ('.yaml', '.yml', '.xml')
                 if os.path.isfile(session + e)), None)
if not yamlfile:
    print(1); sys.exit(0)
try:
    with open(yamlfile) as f:
        param = yaml.safe_load(f)
except Exception:
    print(1); sys.exit(0)
grps   = (param or {}).get('spikeDetection', {}).get('channelGroups', [])
probes = (param or {}).get('probes', [])
pid    = grps[group - 1].get('probeId') if 0 < group <= len(grps) else None
if pid is None or not probes:
    print(1); sys.exit(0)
for i, e in enumerate(probes):
    if int(e.get('id', e.get('probeId', i))) == int(pid):
        print(i + 1); sys.exit(0)
print(1)
PEOF
}

# ── Auto-generate strip sidecar from YAML 'units:' Quality labels ────────
# Prints one cluster id per line for group $1 to stdout if — and only if —
# the YAML has at least one 'units:' entry for that group whose 'quality'
# field (case-insensitively, after trimming) matches one of the tags in
# the comma-separated tag list $2.  Prints nothing if:
#   - the YAML is missing or can't be parsed
#   - there are no 'units:' entries for that group (uncurated session)
#   - no units in that group match the tags
#
# The caller distinguishes "YAML has no curation for this group" from
# "YAML has curation but nothing good" by the exit code: 0 = at least one
# id written, 1 = nothing written.  This lets the caller fall back to the
# global stripClusters in the "uncurated" case while still allowing an
# explicit "no good units here" result to mean "subtract nothing".
#
# The Klusters 'quality' field is free-text (QLineEdit), so the match is
# case-insensitive with whitespace trimmed on both sides.
autoStripFromQuality()
{
	python3 - "$1" "$2" "$session" << 'PEOF'
import sys, os, yaml
group       = int(sys.argv[1])
tag_list    = [t.strip().lower() for t in sys.argv[2].split(',') if t.strip()]
session     = sys.argv[3]
tag_set     = set(tag_list)

yamlfile = next((session + e for e in ('.yaml', '.yml')
                 if os.path.isfile(session + e)), None)
if not yamlfile:
    sys.exit(1)                  # XML-only sessions: skip auto-gen
try:
    with open(yamlfile) as f:
        param = yaml.safe_load(f)
except Exception as exc:
    print(f'# YAML parse failure: {exc}', file=sys.stderr)
    sys.exit(1)

units = (param or {}).get('units') or []
if not isinstance(units, list) or not units:
    sys.exit(1)                  # no curation in YAML → caller falls back

# Filter to this group's entries
in_group = [u for u in units
            if isinstance(u, dict) and u.get('group') == group]
if not in_group:
    sys.exit(1)                  # group uncurated

# Match quality against tag set (case-insensitive, trimmed)
keep_ids = []
for u in in_group:
    q = u.get('quality')
    if q is None:
        continue
    q_norm = str(q).strip().lower()
    if q_norm in tag_set:
        cid = u.get('cluster')
        if cid is not None:
            try:
                keep_ids.append(int(cid))
            except (TypeError, ValueError):
                continue

if not keep_ids:
    # Group was curated but no units tagged good/great/excellent
    # → return empty list (caller subtracts nothing for this group).
    # Signal success so caller doesn't fall back to global stripClusters.
    sys.exit(0)

# Deduplicate + sort for reproducibility
for cid in sorted(set(keep_ids)):
    print(cid)
sys.exit(0)
PEOF
}

groupSpecs=""
for group in $(seq 1 $nElectrodeGroups)
do
	resFile=$session.res.$group
	spkFile=$session.spk.$group

	if [ ! -f "$resFile" ] || [ ! -f "$spkFile" ]
	then
		echo_error "  Missing $resFile or $spkFile"
		exit $INPUTS_MISSING
	fi

	channels=$(yaml_read $session \
		"//spikeDetection/channelGroups/group[$group]/channels/channel")
	nSamples=$(yaml_read $session \
		"//spikeDetection/channelGroups/group[$group]/nSamples")
	peakSample=$(yaml_read $session \
		"//spikeDetection/channelGroups/group[$group]/peakSampleIndex")

	check_mandatory_variable $channels   "missing channel list for spike group $group"
	check_mandatory_variable $nSamples   "missing nSamples for spike group $group"
	check_mandatory_variable $peakSample "missing peakSampleIndex for spike group $group"

	cluFile=$session.clu.$group
	[ ! -f "$cluFile" ] && cluFile="-"

	# Attach the binary drift signal file for this probe (if it exists)
	probeIdx=$(mapGroupToProbeIdx $group)
	driftFile=$session.dat.drift.$probeIdx
	if [ ! -f "$driftFile" ]
	then
		driftFile="-"
	else
		echo_info "  Group $group: using drift file $driftFile (probe $probeIdx)"
	fi

	# ── Resolve strip spec for this group ────────────────────────────
	# Priority:
	#   1. Per-group sidecar $session.strip.$group  (user's explicit override)
	#   2. Auto-generated from YAML 'units' quality labels (if autoStrip=true
	#      and at least one 'units' entry exists for this group)
	#   3. Global YAML stripClusters parameter
	#   4. Built-in default: strip non-noise (exclude 0, 1)
	sidecar="$session.strip.$group"
	autoSidecar="$session.autostrip.$group"
	# Remove stale auto-generated file from previous runs — we rebuild it
	# each run so it stays in sync with the current YAML curation state.
	rm -f "$autoSidecar"

	if [ -f "$sidecar" ]
	then
		stripSpec="@$sidecar"
		echo_info "  Group $group: using strip sidecar $sidecar"
	elif [ "$autoStrip" = "true" ] \
	     && autoStripFromQuality "$group" "$qualityTags" > "$autoSidecar" 2>/dev/null \
	     && [ -s "$autoSidecar" ]
	then
		# At least one unit in this group was tagged with a matching quality
		n_auto=$(wc -l < "$autoSidecar")
		stripSpec="@$autoSidecar"
		# Add a provenance header to the auto-generated file for the
		# operator to see where the list came from if they inspect it.
		{
			echo "# auto-generated by ndm_stripdat on $(date -Is)"
			echo "# source: YAML 'units' entries for group $group"
			echo "# qualityTags: $qualityTags"
			cat "$autoSidecar"
		} > "$autoSidecar.tmp" && mv "$autoSidecar.tmp" "$autoSidecar"
		echo_info "  Group $group: auto-generated strip list from YAML quality" \
		          "(${n_auto} unit(s), tags={$qualityTags}) → $autoSidecar"
	else
		# Either autoStrip=false, no YAML curation for this group, or the
		# helper script was unable to parse.  Fall through to the global
		# stripClusters setting.  (If autoStripFromQuality wrote a 0-byte
		# file because the group was curated but nothing matched, we also
		# land here; this is the desired "no good units → nothing to strip"
		# outcome, but without an explicit sidecar the global default will
		# now fire — probably not what the user wants.  To signal that
		# explicitly, the user should create an empty $session.strip.$group
		# file by hand, OR set stripClusters to something narrow in the
		# YAML.)
		rm -f "$autoSidecar"  # tidy up 0-byte file if any
		if [ "$stripClusters" = "default" ] || [ -z "$stripClusters" ]
		then
			stripSpec="-"
		else
			stripSpec="$stripClusters"
		fi
	fi

	channels=$(echo $channels | tr ' ' ',')
	groupSpecs="$groupSpecs $resFile:$spkFile:$cluFile:$channels:$nSamples:$peakSample:$driftFile:$stripSpec"
done

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Subtract spikes
# ////////////////////////////////////////////////////////////////////////////////////////////////

echo_info "Subtracting spike waveforms from $nElectrodeGroups electrode group(s)"
echo_info "Strip mode:       $stripClusters  (per-group sidecar files take priority)"
echo_info "Subtraction mode: $subtractionMode"
[ "$subtractionMode" = "botm" ] && echo_info "BOTM ridge:       $botmRidge"
echo_info "Output:           $outputDat"

process_subtractspikes \
	-n $nChannels -b $nBits \
	-s $samplingRate \
	--subtraction-mode $subtractionMode \
	--botm-ridge $botmRidge \
	$session.dat $outputDat \
	$groupSpecs
check_command_status process_subtractspikes

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Optional: second-round spike detection
# ////////////////////////////////////////////////////////////////////////////////////////////////

if [ "$redetectSpikes" = "yes" ]
then
	check_commands_installed ndm_redetectspikes
	echo_info "Running second-round spike detection (ndm_redetectspikes)…"
	ndm_redetectspikes $session
	check_command_status ndm_redetectspikes
else
	echo_info "Spike-cleaned dat written: $session-spkclean.dat"
	echo_info "Next steps:"
	echo_info "  ndm_lfp $session              — create LFP (auto-uses spkclean.dat)"
	echo_info "  ndm_redetectspikes $session   — second-round spike detection"
fi
