#!/bin/bash

#////////////////////////////////////////////////////////////////////////////
#//
#//   Run KlustaKwik spike sorting for each spikeDetection group
#//
#//   copyright       (C) 2025 neurosuite-3 contributors
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////

# Source helper functions
source ndm_functions

# Parse command-line
program=$(basename $0)
if [ $# -gt 2 ]
then
	echo_error "usage: $program [parameter-file] [electrodeGroup]"
	exit $GENERAL_ERROR
fi
directory=$(basename "$(pwd)")
session=${1:-$directory}
session=${session%.xml}
session=${session%.yaml}
session=${session%.yml}
param_ext=$(param_file_ext "$session")
electrodeGroup=$2

# Print a header to indicate current processing step
print_header "$session - Running KlustaKwik spike sorting"

# Check required programs
check_commands_installed KlustaKwik

# ── Three-tier parameter reader ───────────────────────────────────────────────
# Reads a KlustaKwik parameter for a given electrode group using three tiers:
#   1. spikeDetection.channelGroups[g].klustakwik.<param>  (per-group, highest priority)
#   2. programs[ndm_klustakwik].parameters.<param>          (global session override)
#   3. Caller-supplied default                               (safety net)
#
# Usage: read_kk_param <group> <paramName> <default>
# Outputs the resolved value to stdout.
read_kk_param()
{
	local group=$1
	local name=$2
	local default=$3

	# Tier 1: per-group spikeDetection.channelGroups[group].klustakwik.<name>
	local value
	value=$(yaml_read "$session" "//spikeDetection/channelGroups/group[$group]/klustakwik/$name")
	if ! xml_read_failed "$value"
	then
		echo "$value"
		return
	fi

	# Tier 2: global programs[ndm_klustakwik] block via read_script_parameter
	value=$(read_script_parameter "$session" "$name")
	if ! xml_read_failed "$value"
	then
		echo "$value"
		return
	fi

	# Tier 3: built-in default
	echo "$default"
}

# Run KlustaKwik for a single electrode group
once()
{
	local electrodeGroup=$1

	# Check input files
	inputs_missing "$session.$param_ext" $session.fet.$electrodeGroup && return $INPUTS_MISSING

	# Check output file — honour the overwrite flag (default: 0 = skip)
	# The flag follows the same three-tier resolution as all other KK parameters:
	#   spikeDetection.channelGroups[g].klustakwik.overwrite   (per-group)
	#   programs[ndm_klustakwik].parameters.overwrite           (global)
	#   built-in default: 0
	# Set overwrite: 1 to force re-sorting a group whose .clu already exists.
	overwrite=$(read_kk_param $electrodeGroup overwrite 0)
	if outputs_exist $session.clu.$electrodeGroup
	then
		if [ "$overwrite" = "1" ]
		then
			echo_warning "overwrite=1: removing existing output '$session.clu.$electrodeGroup' and re-running."
			rm -f $session.clu.$electrodeGroup
		else
			return $OUTPUTS_EXIST
		fi
	fi

	# ////////////////////////////////////////////////////////////////////////////////////////////////
	# // Read Parameters
	# ////////////////////////////////////////////////////////////////////////////////////////////////

	nElectrodeGroups=$(xml_count $session "//spikeDetection/channelGroups/group")
	if [ $electrodeGroup -gt $nElectrodeGroups ]
	then
		echo_error "spike group $electrodeGroup is undefined"
		exit $GENERAL_ERROR
	fi

	# Number of channels in this group
	electrodes=($(xml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/channels/channel"))
	nElectrodes=${#electrodes[*]}

	# Number of PCA features per channel
	nFeatures=$(xml_read $session "//spikeDetection/channelGroups/group[$electrodeGroup]/nFeatures")
	check_mandatory_variable $nFeatures "missing number of features for electrode group $electrodeGroup"

	# UseFeatures: one '1' per PCA feature per channel, plus energy, plus timestamp.
	# The timestamp MUST be the last '1' so that KlustaKwik's timeDimIdx = nDims-1
	# points to real session timestamps.  Without it, RunChunkedCEM partitions by
	# energy instead of time, and Phase 3 cluster realignment is meaningless.
	nTotalFeatures=$(( nElectrodes * nFeatures + 2 ))
	useFeatures=$(printf '1%.0s' $(seq 1 $nTotalFeatures))

	# ── Parameter resolution (three tiers) ───────────────────────────────────
	# Probe-calibrated (usually from tier-1 per-group block):
	maxClusters=$(read_kk_param $electrodeGroup maxClusters 100)
	maxPossibleClusters=$(read_kk_param $electrodeGroup maxPossibleClusters 500)
	mergeThresh=$(read_kk_param $electrodeGroup mergeThresh 42.0)
	globalMergeIter=$(read_kk_param $electrodeGroup globalMergeIter 50)
	timeMergeIter=$(read_kk_param $electrodeGroup timeMergeIter 50)

	# Session-level (usually from tier-2 global block or tier-3 defaults):
	minClusters=$(read_kk_param $electrodeGroup minClusters 2)
	nStarts=$(read_kk_param $electrodeGroup nStarts 3)
	parallelK=$(read_kk_param $electrodeGroup parallelK 0)
	initMethod=$(read_kk_param $electrodeGroup initMethod farthest)
	penaltyMix=$(read_kk_param $electrodeGroup penaltyMix 0)
	chunkMinutes=$(read_kk_param $electrodeGroup chunkMinutes 10)
	chunkOverlapMinutes=$(read_kk_param $electrodeGroup chunkOverlapMinutes 2)
	chunkPreseedFraction=$(read_kk_param $electrodeGroup chunkPreseedFraction 0.05)
	maxIter=$(read_kk_param $electrodeGroup maxIter 500)
	splitEvery=$(read_kk_param $electrodeGroup splitEvery 25)
	distThresh=$(read_kk_param $electrodeGroup distThresh 6.9)
	fullStepEvery=$(read_kk_param $electrodeGroup fullStepEvery 10)
	changedThresh=$(read_kk_param $electrodeGroup changedThresh 0.05)
	log=$(read_kk_param $electrodeGroup log 1)
	screen=$(read_kk_param $electrodeGroup screen 0)
	fSaveModel=$(read_kk_param $electrodeGroup fSaveModel 1)
	saveIntermediates=$(read_kk_param $electrodeGroup saveIntermediates 0)

	# ── Thread count ────────────────────────────────────────────────────────
	# nThreads controls OMP_NUM_THREADS for the KlustaKwik subprocess.
	# KlustaKwik has no -nThreads flag; the OpenMP runtime reads the env var.
	#
	# Resolution: read_kk_param (three tiers) → 0 means "use all cores".
	# Groups run sequentially so all cores are available to each group by
	# default; set nThreads explicitly only when you need to leave headroom
	# for other work running in parallel on the same machine.
	nThreads=$(read_kk_param $electrodeGroup nThreads 0)
	if [ "$nThreads" -le 0 ] 2>/dev/null
	then
		nThreads=$(nproc 2>/dev/null || echo 1)
	fi
	export OMP_NUM_THREADS=$nThreads
	# OMP_WAIT_POLICY=passive: idle workers yield to the OS instead of
	# spinning. Without this, 16 OMP threads + the CUDA polling thread all
	# spin simultaneously, exceeding the available core count and causing
	# the scheduler to time-slice — the parallel chunks then run one at a
	# time.  Passive wait has negligible overhead for second-scale chunks.
	export OMP_WAIT_POLICY=passive

	# ////////////////////////////////////////////////////////////////////////////////////////////////
	# // Process
	# ////////////////////////////////////////////////////////////////////////////////////////////////

	print_header "$session - Group $electrodeGroup ($nElectrodes ch, $nTotalFeatures features incl. timestamp)"

	KlustaKwik $session $electrodeGroup \
		-MinClusters             $minClusters             \
		-MaxClusters             $maxClusters             \
		-MaxPossibleClusters     $maxPossibleClusters     \
		-UseFeatures             $useFeatures             \
		-nStarts                 $nStarts                 \
		-PenaltyMix              $penaltyMix              \
		-InitMethod              $initMethod              \
		-ChunkMinutes            $chunkMinutes            \
		-ChunkOverlapMinutes     $chunkOverlapMinutes     \
		-ChunkPreseedFraction    $chunkPreseedFraction    \
		-MergeThresh             $mergeThresh             \
		-GlobalMergeIter         $globalMergeIter         \
		-TimeMergeIter           $timeMergeIter           \
		-MaxIter                 $maxIter                 \
		-SplitEvery              $splitEvery              \
		-DistThresh              $distThresh              \
		-FullStepEvery           $fullStepEvery           \
		-ChangedThresh           $changedThresh           \
		-Log                     $log                     \
		-Screen                  $screen                  \
		-fSaveModel              $fSaveModel              \
		-SaveIntermediates       $saveIntermediates       \
		-ParallelK               $parallelK

	check_command_status KlustaKwik
	unset OMP_NUM_THREADS
	unset OMP_WAIT_POLICY
}

# Run all groups, or just the one requested
if [ -z "$electrodeGroup" ]
then
	nGroups=$(xml_count $session "//spikeDetection/channelGroups/group")
	if [ $nGroups -eq 0 ]
	then
		echo_error "missing spike groups"
		exit $GENERAL_ERROR
	fi

	# KlustaKwik is CPU-intensive — run groups sequentially to avoid
	# thrashing on shared memory and CPU resources
	overallStatus=$NO_ERROR
	for (( i=1; i<=nGroups; i++ ))
	do
		once $i
		groupStatus=$?
		if [ $groupStatus -ne $NO_ERROR ] && [ $groupStatus -ne $OUTPUTS_EXIST ] && [ $groupStatus -ne $INPUTS_MISSING ]
		then
			overallStatus=$groupStatus
		fi
	done

	exit $overallStatus
else
	once $electrodeGroup
	exit $?
fi
