#!/bin/bash

#////////////////////////////////////////////////////////////////////////////
#//
#//   Create LFP files by downsampling a .dat file.
#//
#//   If <session>-spkclean.dat exists (produced by ndm_stripdat), it is
#//   used as the resampling source in preference to the raw .dat.  The
#//   subtractSpikes parameter can trigger ndm_stripdat automatically when
#//   the cleaned dat is not yet present.
#//
#//   inputExtension (default dat) names the file to downsample:
#//   <session>.<inputExtension>.  Set to anything but dat and it selects
#//   the source outright — the spike-cleaned dat is not consulted, because
#//   ndm_stripdat cleans <session>.dat and nothing else.
#//
#//   copyright       (C) 2007-2010 by Michaël Zugaro
#//   email           michael.zugaro@college-de-france.fr
#//
#//   This program is free software; you can redistribute it and/or modify
#//   it under the terms of the GNU General Public License as published by
#//   the Free Software Foundation; either version 3 of the License, or
#//   (at your option) any later version.
#//
#////////////////////////////////////////////////////////////////////////////

# Source helper functions
source ndm_functions

# Parse command-line
program=$(basename $0)
if [ $# -gt 1 ]
then
	echo_error "usage: $program [parameter-file]"
	exit $GENERAL_ERROR
fi
ndm_resolve_session "$@"
[ "$NDM_SHIFTED" = 0 ] && set -- "$session" "$@"
param_ext=$(param_file_ext "$session")

print_header "$session - Creating LFP file"

# Input data extension: the resampler reads $session.$inputExtension (default
# dat), so it can downsample an alternative, externally-processed source
# instead of the raw .dat (YAML field inputExtension; defaults to dat when
# unset).
inputExtension=$(read_script_parameter $session inputExtension)
inputExtension=${inputExtension:-dat}

outputs_exist $session.lfp && exit $OUTPUTS_EXIST
inputs_missing "$session.$param_ext" "$session.$inputExtension" && exit $INPUTS_MISSING

check_commands_installed xpathReader process_resample

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Read Parameters
# ////////////////////////////////////////////////////////////////////////////////////////////////

nChannels=$(yaml_read $session "//acquisitionSystem/nChannels")
oldSamplingRate=$(yaml_read $session "//acquisitionSystem/samplingRate")
newSamplingRate=$(read_script_parameter $session samplingRate)
subtractSpikes=$(read_script_parameter $session subtractSpikes)

check_mandatory_variable $nChannels      "missing number of channels"
check_mandatory_variable $oldSamplingRate "missing source sampling rate"
check_mandatory_variable $newSamplingRate "missing target sampling rate"

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Select input: explicit inputExtension > spike-cleaned dat > raw dat
# ////////////////////////////////////////////////////////////////////////////////////////////////

cleanDat=$session-spkclean.dat
created_clean_dat=false

if [ "$inputExtension" != dat ]
then
	# inputExtension names the source outright, so it wins over the cleaned-dat
	# shortcut.  ndm_stripdat only ever reads $session.dat and writes
	# $session-spkclean.dat, so a cleaned dat is NOT a cleaned version of this
	# file: silently resampling it would ignore the source that was asked for.
	if [ "$subtractSpikes" = "yes" ]
	then
		echo_error "subtractSpikes=yes conflicts with inputExtension=$inputExtension:"
		echo_error "ndm_stripdat cleans $session.dat only, so it cannot produce a spike-free"
		echo_error "$session.$inputExtension. Set subtractSpikes to no, or inputExtension to dat."
		exit $GENERAL_ERROR
	fi
	[ -f "$cleanDat" ] && echo_info "Ignoring $cleanDat: inputExtension selects $session.$inputExtension"
	dat_source=$session.$inputExtension
elif [ -f "$cleanDat" ]
then
	echo_info "Using existing spike-cleaned dat: $cleanDat"
	dat_source=$cleanDat
else
	# Resolve subtractSpikes: auto-detect when unset
	if [ -z "$subtractSpikes" ] || [ "$subtractSpikes" = "auto" ]
	then
		if ls $session.spk.* >/dev/null 2>&1
		then
			subtractSpikes="yes"
		else
			subtractSpikes="no"
		fi
	fi

	if [ "$subtractSpikes" = "yes" ]
	then
		check_commands_installed ndm_stripdat
		echo_info "Running ndm_stripdat to produce spike-cleaned dat…"
		ndm_stripdat $session
		check_command_status ndm_stripdat
		created_clean_dat=true
		dat_source=$cleanDat
	else
		dat_source=$session.$inputExtension
	fi
fi

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Resample
# ////////////////////////////////////////////////////////////////////////////////////////////////

echo_info "Resampling $dat_source → $session.lfp ($oldSamplingRate → $newSamplingRate Hz)"

process_resample \
	-n $nChannels -f $oldSamplingRate,$newSamplingRate \
	$dat_source $session.lfp
check_command_status process_resample

# ////////////////////////////////////////////////////////////////////////////////////////////////
# // Clean up
# ////////////////////////////////////////////////////////////////////////////////////////////////

# Remove the cleaned dat only if ndm_lfp created it itself (i.e. ndm_stripdat
# was called from here).  If the user ran ndm_stripdat separately beforehand,
# the file is left in place for ndm_redetectspikes or other downstream use.
if [ "$created_clean_dat" = "true" ]
then
	rm -f $cleanDat
fi
