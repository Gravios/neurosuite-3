<refentry xmlns="http://docbook.org/ns/docbook" version="5.2" id="process">

	<refmeta>
		<refentrytitle>process</refentrytitle>
		<manvolnum>1</manvolnum>
	</refmeta>

	<refnamediv>
		<refname>process</refname><refpurpose>a collection of command-line tools to process electrophysiological signals, video and behavioral events.</refpurpose>
	</refnamediv>

	<refsect1>
		<title>Description</title>
		<para>
			This is a collection of command-line tools to process electrophysiological signals, video and behavioral events. They are similar to <command>ndm</command> scripts, except that parameters are read from the command-line rather than from the session parameter file (<filename>SESSION.yaml</filename>; an XML file is only a fallback). Under normal circumstances, you should not need to use these tools directly: instead, you should simply run <command>ndm_start</command> and let it automatically handle all processing tasks (see the manual page for <command>ndm</command> for details).
		</para>
	</refsect1>
	<refsect1>
		<title>Technical Reference</title>
		<para>
			The main tools, by task. Tools without a manual page print their options with <option>-h</option>; <filename>doc/ndmanager-plugins/commands/README.md</filename> in the source tree lists every command.
		</para>
		<variablelist>
			<varlistentry>
				<term>File format conversion</term>
				<listitem>
					<variablelist>
						<varlistentry>
							<term><command moreinfo="refentry">process_nlxconvert</command></term>
							<listitem>
								<para>
									convert files recorded with Neuralynx acquisition systems.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_smrconvert</command></term>
							<listitem>
								<para>
									convert files recorded with Spike2 acquisition systems.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command>process_plxconvert</command></term>
							<listitem>
								<para>
									convert Plexon <replaceable>.plx</replaceable> / <replaceable>.pl2</replaceable> files to <replaceable>.dat</replaceable> plus metadata.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command>process_aomconvert</command></term>
							<listitem>
								<para>
									convert AlphaOmega <replaceable>.mat</replaceable> (HDF5) files to <replaceable>.dat</replaceable> plus YAML.
								</para>
							</listitem>
						</varlistentry>
					</variablelist>
				</listitem>
			</varlistentry>
			<varlistentry>
				<term>Wideband signal processing</term>
				<listitem>
					<variablelist>
						<varlistentry>
							<term><command moreinfo="refentry">process_resample</command></term>
							<listitem>
								<para>
									resample a multiplexed binary data file (<replaceable>.dat</replaceable>, <replaceable>.fil</replaceable>, etc.)
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_merge</command></term>
							<listitem>
								<para>
									merge simultaneously recorded multiplexed binary files (<replaceable>.dat</replaceable>, <replaceable>.fil</replaceable>, etc.)
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_extractchannels</command></term>
							<listitem>
								<para>
									extract channels from a multiplexed binary file (<replaceable>.dat</replaceable>, <replaceable>.fil</replaceable>, etc.)
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command>process_slicebinary</command></term>
							<listitem>
								<para>
									copy a subset of channels of a multiplexed binary file into a new file.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_butterworth</command></term>
							<listitem>
								<para>
									zero-phase Butterworth high-pass (optionally band-pass) filter (<replaceable>.dat</replaceable> -> <replaceable>.fil</replaceable>); the default filter of <command>ndm_hipass</command>.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_medianfilter</command></term>
							<listitem>
								<para>
									median-based hi-pass filter (<replaceable>.dat</replaceable> -> <replaceable>.fil</replaceable>); used by <command>ndm_hipass</command> when <literal>filter: median</literal> is set, and by <command>ndm_bandpass</command>.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_lowpass</command></term>
							<listitem>
								<para>
									linear-phase FIR low-pass filter, the upper edge of <command>ndm_bandpass</command>.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_extractemg</command></term>
							<listitem>
								<para>
									identify, remove and extract EMG events with FastICA, per probe.
								</para>
							</listitem>
						</varlistentry>
					</variablelist>
				</listitem>
			</varlistentry>
			<varlistentry>
				<term>Spike processing</term>
				<listitem>
					<variablelist>
						<varlistentry>
							<term><command moreinfo="refentry">process_medianthreshold</command></term>
							<listitem>
								<para>
									compute the spike detection threshold for a hi-pass filtered multiplexed binary  (<replaceable>.fil</replaceable>) file.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_extractspikes</command></term>
							<listitem>
								<para>
									extract spike waveforms (<replaceable>.spk</replaceable>) and timestamps (<replaceable>.res</replaceable>) from a high-pass filtered multiplexed binary (<replaceable>.fil</replaceable>) data file.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_extractspikes_sdiff</command></term>
							<listitem>
								<para>
									as <command>process_extractspikes</command>, detecting on a spatial derivative across the group's channels.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command>process_extractspikes_stderiv</command></term>
							<listitem>
								<para>
									as above, detecting on a spatial plus temporal derivative and writing the transformed waveforms (<replaceable>.spkD</replaceable>).
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_reextractspikes</command></term>
							<listitem>
								<para>
									second-pass detection that masks already known spikes (also a <command>_stderiv</command> variant).
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_spikegrouper</command></term>
							<listitem>
								<para>
									discover spike detection channel groups from a high-pass filtered signal.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_pca</command></term>
							<listitem>
								<para>
									compute principal component analysis (PCA) on spike data for subsequent cluster cutting (-> <replaceable>.fet</replaceable> and <replaceable>.pca</replaceable> files); <command>process_pca_stderiv</command> and <command>process_pca_multichannel</command> are variants.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_refeaturize</command></term>
							<listitem>
								<para>
									re-project waveforms through a saved <replaceable>.pca</replaceable> basis.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_denoiseuniform</command></term>
							<listitem>
								<para>
									remove spike events that are nearly identical on all channels of a group.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_shadowcluster</command></term>
							<listitem>
								<para>
									assign re-extracted spikes to shadow clusters of existing clusters.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_reassignspikes</command></term>
							<listitem>
								<para>
									re-score and reassign low-amplitude burst spikes with a state-conditioned waveform model.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command>process_decomposecollisions</command></term>
							<listitem>
								<para>
									decompose collisions of two units after curation (run through <command>ndm_decomposecollisions</command>).
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_reorderclusters</command></term>
							<listitem>
								<para>
									reorder clusters in a cluster (<replaceable>.clu</replaceable>) file.
								</para>
							</listitem>
						</varlistentry>
						<varlistentry>
							<term><command moreinfo="refentry">process_removeartefacts</command></term>
							<listitem>
								<para>
									removes artefacts (channel 0) from spike waveform (<replaceable>.spk</replaceable>), spike time (<replaceable>.res</replaceable>), feature (<replaceable>.fet</replaceable>) and cluster (<replaceable>.clu</replaceable>) files.
								</para>
							</listitem>
						</varlistentry>
					</variablelist>
				</listitem>
			</varlistentry>
			<varlistentry>
				<term>Video processing</term>
				<listitem>
					<variablelist>
						<varlistentry>
							<term><command moreinfo="refentry">process_extractleds</command></term>
							<listitem>
								<para>
									extract LEDs from a video (<replaceable>.mpg</replaceable>, <replaceable>.avi</replaceable>, etc.) file.
								</para>
							</listitem>
						</varlistentry>
					</variablelist>
				</listitem>
			</varlistentry>
			<varlistentry>
				<term>Miscellaneous</term>
				<listitem>
					<variablelist>
						<varlistentry>
							<term><command moreinfo="refentry">xpathReader</command></term>
							<listitem>
								<para>
									read information from an XML file using XPath syntax queries.
								</para>
							</listitem>
						</varlistentry>
					</variablelist>
				</listitem>
			</varlistentry>
		</variablelist>
	</refsect1>

