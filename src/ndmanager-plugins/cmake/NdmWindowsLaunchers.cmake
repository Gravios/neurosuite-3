# NdmWindowsLaunchers.cmake — the ndm_* pipeline scripts on Windows.
#
# The ndm_* steps are bash scripts (and a few extension-less Python ones).
# Windows cannot run a file without an extension, so typing `ndm_hipass` in cmd
# or PowerShell does nothing useful.  ndm_windows_launchers(<scripts>) installs,
# into the same bin directory:
#
#   <script>        the script itself, with LF line endings whatever the
#                   checkout did (Git for Windows checks text out as CRLF by
#                   default, and bash then fails on the \r);
#   <script>.bat    a launcher that runs it with Git Bash (bash scripts) or
#                   Python (#!/usr/bin/env python3 scripts), so `ndm_hipass`
#                   works from cmd, PowerShell and anything that starts .bat;
#   ndm-env.bat     what the launchers call to find Git Bash and Python and to
#                   put this bin directory first on PATH;
#   ndm-bash/python3  for Git Bash: runs `py -3` (or `python`), since the Windows
#                   Python installer provides no python3 and the Store
#                   placeholder of that name only opens the Store.  In its
#                   own directory, which only the launchers put on PATH.
#
# Libraries that are sourced, not run (ndm_functions, ndm_custody), get no
# launcher, nor does process_spikegrouper, whose .exe has the same name.
#
# SPDX-License-Identifier: GPL-3.0-or-later
include_guard(GLOBAL)

function(ndm_windows_launchers)
    set(_no_launcher ndm_functions ndm_custody process_spikegrouper)
    set(_out "${CMAKE_CURRENT_BINARY_DIR}/windows-scripts")
    file(MAKE_DIRECTORY "${_out}")
    set(_installed "")
    foreach(_name IN LISTS ARGN)
        set(_src "${CMAKE_CURRENT_SOURCE_DIR}/${_name}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_src}")
        # LF copy.  file(READ) / file(WRITE) keep the text as it is (no
        # @VAR@ or ${VAR} substitution, unlike configure_file).
        file(READ "${_src}" _text)
        string(REPLACE "\r\n" "\n" _text "${_text}")
        file(WRITE "${_out}/${_name}" "${_text}")
        list(APPEND _installed "${_out}/${_name}")

        if(_name IN_LIST _no_launcher)
            continue()
        endif()
        string(REGEX MATCH "^#![^\n]*" _shebang "${_text}")
        if(_shebang MATCHES "python")
            set(_run "\"%NDM_PYTHON%\" %NDM_PYTHON_ARGS% \"%NDM_SCRIPT%\" %*")
        else()
            set(_run "\"%NDM_BASH%\" \"%NDM_SCRIPT%\" %*")
        endif()
        file(WRITE "${_out}/${_name}.bat"
            "@echo off\r\n"
            "rem ${_name} for cmd / PowerShell: runs the script beside this file.\r\n"
            "rem Generated by NdmWindowsLaunchers.cmake.\r\n"
            "setlocal\r\n"
            "call \"%~dp0ndm-env.bat\"\r\n"
            "if errorlevel 1 exit /b 127\r\n"
            "rem Forward slashes: the scripts take their name from basename $0,\r\n"
            "rem which splits on / only, and look up their parameters by it.\r\n"
            "set \"NDM_SCRIPT=%~dp0${_name}\"\r\n"
            "set \"NDM_SCRIPT=%NDM_SCRIPT:\\=/%\"\r\n"
            "${_run}\r\n"
            "exit /b %ERRORLEVEL%\r\n")
        list(APPEND _installed "${_out}/${_name}.bat")
    endforeach()

    # Shared by the launchers.  No setlocal: it sets NDM_BASH, NDM_PYTHON,
    # NDM_PYTHON_ARGS and PATH for the caller (which has its own setlocal).
    # No parenthesised blocks: %ProgramFiles(x86)% would end them early.
    file(WRITE "${_out}/ndm-env.bat"
        "@echo off\r\n"
        "rem ndm-env.bat: finds Git Bash and Python for the ndm_* launchers.\r\n"
        "rem Set NS_BASH or NS_PYTHON to override.  Generated by NdmWindowsLaunchers.cmake.\r\n"
        "rem ndm-bash holds the python3 that Git Bash runs; kept off the user PATH.\r\n"
        "set \"PATH=%~dp0ndm-bash;%~dp0;%PATH%\"\r\n"
        "set \"NDM_BASH=\"\r\n"
        "if defined NS_BASH if exist \"%NS_BASH%\" set \"NDM_BASH=%NS_BASH%\"\r\n"
        "rem Git for Windows' bin\\bash.exe, never System32\\bash.exe (that is WSL).\r\n"
        "if not defined NDM_BASH if exist \"%ProgramFiles%\\Git\\bin\\bash.exe\" set \"NDM_BASH=%ProgramFiles%\\Git\\bin\\bash.exe\"\r\n"
        "if not defined NDM_BASH if exist \"%LocalAppData%\\Programs\\Git\\bin\\bash.exe\" set \"NDM_BASH=%LocalAppData%\\Programs\\Git\\bin\\bash.exe\"\r\n"
        "if not defined NDM_BASH if exist \"%ProgramFiles(x86)%\\Git\\bin\\bash.exe\" set \"NDM_BASH=%ProgramFiles(x86)%\\Git\\bin\\bash.exe\"\r\n"
        "rem %%~$PATH:G is cmd's own PATH search (where.exe is not needed).\r\n"
        "if not defined NDM_BASH for %%G in (git.exe) do if not \"%%~$PATH:G\"==\"\" if exist \"%%~dp$PATH:G..\\bin\\bash.exe\" set \"NDM_BASH=%%~dp$PATH:G..\\bin\\bash.exe\"\r\n"
        "if not defined NDM_BASH echo ndm: Git Bash not found. Install Git for Windows, or set NS_BASH to its bin\\bash.exe. 1>&2\r\n"
        "if not defined NDM_BASH exit /b 127\r\n"
        "set \"NDM_PYTHON=\"\r\n"
        "set \"NDM_PYTHON_ARGS=\"\r\n"
        "if defined NS_PYTHON if exist \"%NS_PYTHON%\" set \"NDM_PYTHON=%NS_PYTHON%\"\r\n"
        "if not defined NDM_PYTHON for %%P in (py.exe) do if not \"%%~$PATH:P\"==\"\" set \"NDM_PYTHON=%%~$PATH:P\"\r\n"
        "if defined NDM_PYTHON if not defined NS_PYTHON set \"NDM_PYTHON_ARGS=-3\"\r\n"
        "rem python.exe, unless the first one is the Microsoft Store placeholder.\r\n"
        "if not defined NDM_PYTHON for %%P in (python.exe) do if not \"%%~$PATH:P\"==\"\" set \"NDM_PYTHON=%%~$PATH:P\"\r\n"
        "if defined NDM_PYTHON if not \"%NDM_PYTHON:WindowsApps=%\"==\"%NDM_PYTHON%\" set \"NDM_PYTHON=\"\r\n"
        "if not defined NDM_PYTHON set \"NDM_PYTHON=python\"\r\n"
        "exit /b 0\r\n")
    list(APPEND _installed "${_out}/ndm-env.bat")

    # python3 for the scripts run by Git Bash (they call python3 by name).
    file(MAKE_DIRECTORY "${_out}/ndm-bash")
    file(WRITE "${_out}/ndm-bash/python3"
        "#!/bin/bash\n"
        "# python3 for the ndm_* scripts under Git Bash on Windows, where the\n"
        "# Python installer provides py and python but no python3.\n"
        "# Generated by NdmWindowsLaunchers.cmake.\n"
        "if [ -n \"$NS_PYTHON\" ]; then exec \"$NS_PYTHON\" \"$@\"; fi\n"
        "if command -v py >/dev/null 2>&1; then exec py -3 \"$@\"; fi\n"
        "exec python \"$@\"\n")
    install(PROGRAMS "${_out}/ndm-bash/python3" DESTINATION "${CMAKE_INSTALL_BINDIR}/ndm-bash")

    install(PROGRAMS ${_installed} DESTINATION "${CMAKE_INSTALL_BINDIR}")
    message(STATUS "ndmanager-plugins: Windows launchers (.bat, Git Bash) for the ndm_* scripts")
endfunction()
