        <item row="3" column="0">
         <widget class="QCheckBox" name="curationLoggingCheckBox">
          <property name="text">
           <string>Enable curation logging</string>
          </property>
          <property name="toolTip">
           <string>Record per-action curation snapshots to the .curation_log file. Each realign/nudge/group/split takes a full-dataset audit snapshot (computeAllCentroids); disabling this skips that work, removing its overhead during performance testing. The on-disk curation audit trail is not written while disabled. Undo/redo are unaffected. Default: on.</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QCheckBox" name="autoRealignAfterMergeCheckBox">
          <property name="text">
           <string>Auto-align spikes after each merge</string>
          </property>
          <property name="toolTip">
           <string>After a Group Clusters (merge) operation, automatically run spike realignment on the resulting merged cluster using the current realignment settings above — no dialog. Skipped while a realignment job is already running. Applies to interactive merges only, not the batch Auto-Merge. Default: off.</string>
          </property>
          <property name="checked">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item row="5" column="0">
         <widget class="QCheckBox" name="autoRenumberAfterMergeCheckBox">
          <property name="text">
           <string>Auto-renumber clusters after cluster edits</string>
          </property>
          <property name="toolTip">
           <string>After a cluster-set-changing edit — merge (Group Clusters or batch Auto-Merge), split, new cluster, delete-to-noise/artifact, or recluster — automatically renumber the clusters (same as the Renumber Clusters action, R) so IDs stay contiguous. Not applied to membership-only changes. Default: off.</string>
          </property>
          <property name="checked">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item row="6" column="0">
         <widget class="QCheckBox" name="autoUpdateMatricesAfterMergeCheckBox">
          <property name="text">
           <string>Auto-update matrices after cluster edits</string>
          </property>
          <property name="toolTip">
           <string>After any cluster edit — merge, split, new cluster, delete-to-noise/artifact, recluster, or a membership change — automatically recompute the error / template / residual matrices (same as the Update Error Matrix action, U). No effect when no matrix view is open. Default: off.</string>
          </property>
          <property name="checked">
           <bool>false</bool>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
