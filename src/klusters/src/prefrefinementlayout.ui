         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="knnThresholdSpinBox">
          <property name="toolTip">
           <string>Majority threshold as a fraction of K (0.0-1.0). 0.5 = simple majority. Spikes that don't reach any majority go to a residual bin.</string>
          </property>
          <property name="minimum"><double>0.000000000000000</double></property>
          <property name="maximum"><double>1.000000000000000</double></property>
          <property name="singleStep"><double>0.050000000000000</double></property>
          <property name="decimals"><number>2</number></property>
          <property name="value"><double>0.500000000000000</double></property>
         </widget>
        </item>
        <item>
