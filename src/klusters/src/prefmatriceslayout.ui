<ui version="4.0">
 <class>PrefMatricesLayout</class>
 <widget class="QWidget" name="PrefMatricesLayout">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>420</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Matrices</string>
  </property>
  <layout class="QVBoxLayout" name="topLayout">
   <item>
    <widget class="QGroupBox" name="groupBox_matricesWhen">
     <property name="title">
      <string>When to compute</string>
     </property>
     <layout class="QVBoxLayout" name="groupBox_matricesWhenLayout">
      <item>
       <widget class="QCheckBox" name="autoShowMatricesOnOpenCheckBox">
        <property name="text">
         <string>Auto-show matrix displays on open</string>
        </property>
        <property name="toolTip">
         <string>When checked, opening a document automatically creates a Grouping Assistant Display with the Error, Template, Residual and Drift Matrix docks tabified into one frame (press E to step through them), then triggers an Update Error Matrix to populate them.  Saves the user from manually doing this on every document open.  Combines with the global window-geometry restore (already saved on close) to give a consistent layout across sessions.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="autoUpdateMatricesAfterMergeCheckBox">
        <property name="text">
         <string>Auto-update matrices after cluster edits</string>
        </property>
        <property name="toolTip">
         <string>After any cluster edit — merge, split, new cluster, delete-to-noise/artifact, recluster, or a membership change — automatically recompute the error / template / residual matrices (same as the Update Error Matrix action, U). No effect when no matrix view is open. Default: off.</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox_errormatrix">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="title">
      <string>Error matrix</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_errormatrix">
      <item row="0" column="0">
       <widget class="QCheckBox" name="errorMatrixIncrementalCheckBox">
        <property name="text">
         <string>Incremental reuse (else full recompute)</string>
        </property>
        <property name="toolTip">
         <string>When a single cluster edit changes the error matrix, reuse the cached per-cluster probability columns for unchanged clusters and recompute only the changed ones, rather than recomputing the whole matrix. On a fast GPU the full recompute is usually quicker; incremental helps most without a GPU or at very large cluster counts. Overridden by NS3_ERRORMATRIX_INCREMENTAL when that variable is set. Default: off.</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="errorMatrixLowPrecisionCheckBox">
        <property name="text">
         <string>Low-precision GPU compute (FP32, faster)</string>
        </property>
        <property name="toolTip">
         <string>Compute the error matrix in single precision (FP32) on the GPU. On Blackwell the FP64 rate is ~1/64 of FP32, so FP32 roughly halves the compute time for the same qualitative matrix, at ~5e-4 numerical error in the cells — invisible for visual curation. Uncheck for exact FP64 values (slower). Both paths use GPU-side aggregation (no large host buffer). Overridden by NS3_ERRORMATRIX_LOWPRECISION when that variable is set. Default: on.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox_templateMatrix">
     <property name="title">
      <string>Template matrix</string>
     </property>
     <layout class="QVBoxLayout" name="groupBox_templateMatrixLayout">
      <item>
       <widget class="QLabel" name="templateControlsHintLabel">
        <property name="text">
         <string>The template matrix, its match slider and the drift slider need Templates mode (Display page).</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="templateXcorrMetricLayout">
        <item>
         <widget class="QLabel" name="templateXcorrMetricLabel">
          <property name="text">
           <string>Template matrix &amp;metric:</string>
          </property>
          <property name="buddy">
           <cstring>templateXcorrMetricComboBox</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="templateXcorrMetricComboBox">
          <property name="toolTip">
           <string>Similarity metric for the Template Matrix cells.  Cosine: peak normalised cross-correlation between cluster mean waveforms.  Pearson: removes each waveform's overlap-window mean first (shape correlation, insensitive to a shared DC offset).  Raw: non-normalised cross-correlation, amplitude-weighted, globally scaled so the strongest pair reads 1.0.  Profile: inter-channel structure (amplitude profile, polarity profile, per-channel-normalised shape), amplitude-blind. The per-spike pair xcorr and auto-merge always use cosine/Pearson (never raw), since their thresholds need a bounded [0,1] score.</string>
          </property>
          <item>
           <property name="text">
            <string>Cosine similarity</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Pearson correlation</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Raw (non-normalised)</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Disattenuated (energy-corrected)</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Fast-AP window (energy-corrected)</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Profile (inter-channel)</string>
           </property>
          </item>
         </widget>
        </item>
        <item>
         <spacer name="templateXcorrMetricSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
