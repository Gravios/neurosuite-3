        <property name="maximum">
         <number>1000000</number>
        </property>
        <property name="singleStep">
         <number>100</number>
        </property>
        <property name="suffix">
         <string> clusters</string>
        </property>
        <property name="toolTip">
         <string>Each drift-slider step recomputes the correlation of every cluster pair, so the control stops being interactive well before the matrix stops being readable. Drift linking is also only meaningful once the sort has been consolidated. Above this count the slider is disabled and re-enables itself as you merge down. 0 disables it always. Default: 1000.</string>
        </property>
