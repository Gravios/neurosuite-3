          <item>
           <layout class="QHBoxLayout">
            <item>
             <widget class="QCheckBox" name="autoSelectFeaturesCheckBox">
              <property name="text">
               <string>Auto-select features (highest-variance)</string>
              </property>
              <property name="toolTip">
               <string>When checked, klusters ranks feature dimensions by variance for the selected cluster and passes the top N as 1s in the UseFeatures bit-string sent to KlustaKwik.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="autoSelectNFeaturesLabel">
              <property name="text">
               <string>N features:</string>
              </property>
              <property name="wordWrap">
               <bool>false</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="autoSelectNFeaturesSpinBox">
              <property name="minimum">
               <number>1</number>
              </property>
              <property name="maximum">
               <number>25</number>
              </property>
              <property name="value">
               <number>7</number>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="spacer_autosel">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
