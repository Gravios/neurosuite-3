<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PrefMergingLayout</class>
 <widget class="QWidget" name="PrefMergingLayout">
  <property name="geometry"><rect><x>0</x><y>0</y><width>520</width><height>520</height></rect></property>
  <property name="windowTitle"><string>Merging</string></property>
  <layout class="QVBoxLayout" name="topLayout">
   <item>
    <widget class="QGroupBox" name="groupBox_mergeRecommend">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="title">
      <string>Recommended merges (panel under the child palette)</string>
     </property>
     <layout class="QVBoxLayout" name="mergeRecommendGroupLayout">
      <item>
       <widget class="QCheckBox" name="showMergeRecommendPanelCheckBox">
        <property name="text">
         <string>Show the recommended-merges panel</string>
        </property>
        <property name="toolTip">
         <string>Show the Recommended merges dock in hierarchical sessions. Ranking compares every pair of clusters, so at high cluster counts the scan is substantial; turn this off to skip it entirely when you are not using the recommendations. The scan itself runs on a background thread and does not block editing. Default: on.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="mergeRecommendMaxRow">
        <item>
         <widget class="QLabel" name="mergeRecommendMaxLabel">
          <property name="text">
           <string>Maximum recommendations:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="mergeRecommendMaxSpinBox">
          <property name="toolTip">
           <string>Cap on how many merge recommendations the panel lists, best first. The panel ranks every candidate pair before capping, so raising this lengthens the list rather than widening the search. Default: 20.</string>
          </property>
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>200</number>
          </property>
          <property name="value">
           <number>20</number>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="mergeRecommendMaxSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="mergeRecommendErrorFloorRow">
        <item>
         <widget class="QLabel" name="mergeRecommendErrorFloorLabel">
          <property name="text">
           <string>Minimum error probability:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="mergeRecommendErrorFloorSpinBox">
          <property name="toolTip">
           <string>Absolute floor on the symmetrised error-matrix probability. A pair scoring below this is dropped no matter how well the waveform envelopes overlap: the error matrix holds probabilities, so a low value means "these are not one unit" and is a fact, not a ranking. This gate is applied BEFORE ranking, so a disbelieved pair does not occupy a rank slot. Raise it to demand stronger evidence; 0 disables the gate and leaves only the relative quality floor. Default: 0.05.</string>
          </property>
          <property name="decimals">
           <number>3</number>
          </property>
          <property name="minimum">
           <double>0.000000000000000</double>
          </property>
          <property name="maximum">
           <double>1.000000000000000</double>
          </property>
          <property name="singleStep">
           <double>0.010000000000000</double>
          </property>
          <property name="value">
           <double>0.050000000000000</double>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="mergeRecommendErrorFloorSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="mergeRecommendQualityFloorRow">
        <item>
         <widget class="QLabel" name="mergeRecommendQualityFloorLabel">
          <property name="text">
           <string>Minimum combined quality:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="mergeRecommendQualityFloorSpinBox">
          <property name="toolTip">
           <string>Minimum combined quality for a pair to be listed. Quality is the WEAKER of the two witnesses' percentile ranks, so 0.90 means both the error matrix and the waveform-envelope overlap must rank the pair in their own top decile. Because it is a percentile it is relative to the pairs on offer, which is why the absolute error floor above exists alongside it. Lower it to see more marginal suggestions. Default: 0.90.</string>
          </property>
          <property name="decimals">
           <number>2</number>
          </property>
          <property name="minimum">
           <double>0.000000000000000</double>
          </property>
          <property name="maximum">
           <double>1.000000000000000</double>
          </property>
          <property name="singleStep">
           <double>0.050000000000000</double>
          </property>
          <property name="value">
           <double>0.900000000000000</double>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="mergeRecommendQualityFloorSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxAlgorithm">
     <property name="title"><string>Auto-Merge: algorithm</string></property>
     <property name="toolTip"><string>Same mechanism as KKE: pairwise cross-correlation between cluster templates with bounded shift; pairs scoring above the threshold are merged.</string></property>
     <layout class="QVBoxLayout">
      <item><widget class="QRadioButton" name="algoMeanRadio"><property name="text"><string>&amp;Mean templates (matches KKE WithinChunkTemplateMatch)</string></property><property name="toolTip"><string>Build the per-cluster template as the mean of its waveforms. Faster; more sensitive to outlier spikes in a cluster.</string></property></widget></item>
      <item><widget class="QRadioButton" name="algoMedianRadio"><property name="text"><string>Me&amp;dian templates (matches KKE MedianKnn variant)</string></property><property name="toolTip"><string>Build the per-cluster template as the per-sample median. More robust against bursts and contamination; slightly slower.</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout">
        <item><widget class="QLabel" name="medianKLabel"><property name="text"><string>Median K (neighbours):</string></property></widget></item>
        <item><widget class="QSpinBox" name="medianKSpinBox"><property name="minimum"><number>1</number></property><property name="maximum"><number>500</number></property><property name="toolTip"><string>Number of nearest spikes used per cluster when building the median template. Only used when Median templates is selected.</string></property></widget></item>
        <item><spacer name="kSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxCriterion">
     <property name="title"><string>Auto-Merge: merge criterion</string></property>
     <layout class="QGridLayout">
      <item row="0" column="0" colspan="2"><widget class="QCheckBox" name="useErrorMatrixCheckBox"><property name="text"><string>Use &amp;error-matrix probability (instead of template cross-correlation)</string></property><property name="toolTip"><string>Score cluster pairs by the posterior-confusion matrix shown in the Error Matrix view rather than by template cross-correlation. A pair is proposed when max(P(i-&gt;j), P(j-&gt;i)) reaches the threshold below. Computing the error matrix takes seconds on a large session and is not cancellable mid-computation.</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="errorProbThresholdLabel"><property name="text"><string>Error-matrix threshold:</string></property></widget></item>
      <item row="1" column="1"><widget class="QDoubleSpinBox" name="errorProbThresholdSpinBox"><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>1.000000000000000</double></property><property name="singleStep"><double>0.010000000000000</double></property><property name="decimals"><number>3</number></property><property name="toolTip"><string>Minimum value of max(P(i-&gt;j), P(j-&gt;i)) for a cluster pair to be merged when the error-matrix criterion is selected. Only used when the checkbox above is ticked.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxScoring">
     <property name="title"><string>Auto-Merge: scoring (pairwise template cross-correlation)</string></property>
     <layout class="QGridLayout">
      <item row="0" column="0"><widget class="QLabel" name="thresholdLabel"><property name="text"><string>Score threshold:</string></property></widget></item>
      <item row="0" column="1"><widget class="QDoubleSpinBox" name="scoreThresholdSpinBox"><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>1.000000000000000</double></property><property name="singleStep"><double>0.010000000000000</double></property><property name="decimals"><number>3</number></property><property name="toolTip"><string>Minimum normalised xcorr score for a cluster pair to be merged. KKE uses 0.98 by default.</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="maxShiftLabel"><property name="text"><string>Max shift (samples, 0 = auto):</string></property></widget></item>
      <item row="1" column="1"><widget class="QSpinBox" name="maxShiftSpinBox"><property name="minimum"><number>0</number></property><property name="maximum"><number>128</number></property><property name="toolTip"><string>Maximum sample lag for the xcorr. 0 = automatic (nSamplesPerSpike / 4, matching KKE).</string></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="taperLabel"><property name="text"><string>Hann taper (samples, 0 = off):</string></property></widget></item>
      <item row="2" column="1"><widget class="QSpinBox" name="taperSpinBox"><property name="minimum"><number>0</number></property><property name="maximum"><number>64</number></property><property name="toolTip"><string>Taper window length on each end of the template, to suppress edge-discontinuity contributions to xcorr. 0 = off. Matches KKE's TemplateMatchTaperHannSamples.</string></property></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="minSizeLabel"><property name="text"><string>Min cluster size:</string></property></widget></item>
      <item row="3" column="1"><widget class="QSpinBox" name="minClusterSizeSpinBox"><property name="minimum"><number>2</number></property><property name="maximum"><number>1000000</number></property><property name="toolTip"><string>Clusters smaller than this are skipped (excluded from both source and target of merges).</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxScope">
     <property name="title"><string>Auto-Merge: clusters considered</string></property>
     <layout class="QVBoxLayout">
      <item><widget class="QRadioButton" name="scopeSelectedRadio"><property name="text"><string>&amp;Selected clusters in palette only</string></property><property name="toolTip"><string>Auto-merge considers only clusters currently selected. Safest for targeted curation.</string></property></widget></item>
      <item><widget class="QRadioButton" name="scopeAllActiveRadio"><property name="text"><string>&amp;All active clusters (excluding 0 artefact / 1 noise)</string></property><property name="toolTip"><string>Auto-merge considers every non-special cluster in the document. Use with the preview-before-apply option to inspect proposed merges first.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxBehaviour">
     <property name="title"><string>Auto-Merge: behaviour</string></property>
     <layout class="QVBoxLayout">
      <item><widget class="QCheckBox" name="previewBeforeApplyCheckBox"><property name="text"><string>&amp;Preview proposed merges before applying</string></property><property name="toolTip"><string>Open a confirmation dialog listing the proposed merge groups before any cluster labels are changed. Recommended when scope is set to All active.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item><spacer name="vSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
