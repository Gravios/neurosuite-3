# =============================================================================
# MetalBackend.cmake — Apple GPU (Metal) backend helpers (macOS, Apple silicon)
#
# Design: doc/design/metal-backend.md.  Host code uses Apple's C++ wrapper,
# metal-cpp; kernels are Metal Shading Language source embedded in the binary
# and compiled at run time by the OS, so neither full Xcode nor the Metal
# command-line compiler is needed to build.
#
#   ns_metal_setup()
#       On macOS with USE_METAL (default ON), finds the Metal and Foundation
#       frameworks and metal-cpp, and defines the INTERFACE target ns_metalcpp
#       (metal-cpp headers + frameworks).  Sets NS_METAL_FOUND in the caller's
#       scope.  Elsewhere, or with USE_METAL=OFF, NS_METAL_FOUND is FALSE and
#       nothing else happens.
#
#   ns_metal_embed(<target> <symbol> <file.metal>)
#       Adds a generated source to <target> defining
#           extern const char <symbol>[];   // the file's text
#       for MetalContext::pipeline() to compile.  The file is read at configure
#       time and the configure re-runs when it changes.
#
# metal-cpp comes from NS_METAL_CPP_DIR when set (a checkout or the unpacked
# download from developer.apple.com/metal/cpp), else it is fetched from
# Apple's repository at the pinned commit NS_METAL_CPP_COMMIT.
# =============================================================================
include_guard(GLOBAL)

if(NOT DEFINED USE_METAL)
    option(USE_METAL "Enable the Apple Metal GPU backend (macOS, Apple silicon)" ON)
endif()

# release/metal-cpp_macOS15.2_iOS18.2 of github.com/apple/metal-cpp: works with
# the macOS 15 SDK (the CI runner's) and newer.
set(NS_METAL_CPP_COMMIT "9b4029d993648571595451f3b965c7c438fb7dc4"
    CACHE STRING "metal-cpp commit fetched when NS_METAL_CPP_DIR is not set")
set(NS_METAL_CPP_DIR "" CACHE PATH
    "A metal-cpp directory (containing Metal/Metal.hpp) to use instead of fetching one")

function(ns_metal_setup)
    set(NS_METAL_FOUND FALSE PARENT_SCOPE)
    if(NOT APPLE OR NOT USE_METAL)
        return()
    endif()
    if(TARGET ns_metalcpp)
        set(NS_METAL_FOUND TRUE PARENT_SCOPE)
        return()
    endif()

    find_library(NS_METAL_FRAMEWORK Metal)
    find_library(NS_FOUNDATION_FRAMEWORK Foundation)
    if(NOT NS_METAL_FRAMEWORK OR NOT NS_FOUNDATION_FRAMEWORK)
        message(STATUS "neurosuite-3: Metal or Foundation framework not found — no Metal backend")
        return()
    endif()

    if(NS_METAL_CPP_DIR)
        set(_dir "${NS_METAL_CPP_DIR}")
    else()
        include(FetchContent)
        # metal-cpp is headers only and has no CMakeLists.txt; SOURCE_SUBDIR
        # names a directory that does not exist, so MakeAvailable only fetches.
        FetchContent_Declare(ns_metal_cpp
            GIT_REPOSITORY https://github.com/apple/metal-cpp.git
            GIT_TAG        "${NS_METAL_CPP_COMMIT}"
            SOURCE_SUBDIR  no-cmake-here)
        FetchContent_MakeAvailable(ns_metal_cpp)
        set(_dir "${ns_metal_cpp_SOURCE_DIR}")
    endif()
    if(NOT EXISTS "${_dir}/Metal/Metal.hpp")
        message(WARNING "neurosuite-3: metal-cpp not found at '${_dir}' — no Metal backend "
                        "(set NS_METAL_CPP_DIR, or USE_METAL=OFF)")
        return()
    endif()

    add_library(ns_metalcpp INTERFACE)
    # SYSTEM: metal-cpp's own headers are not held to our warning flags.
    target_include_directories(ns_metalcpp SYSTEM INTERFACE "${_dir}")
    target_link_libraries(ns_metalcpp INTERFACE
        "${NS_METAL_FRAMEWORK}" "${NS_FOUNDATION_FRAMEWORK}")
    message(STATUS "neurosuite-3: Metal backend enabled (metal-cpp: ${_dir})")
    set(NS_METAL_FOUND TRUE PARENT_SCOPE)
endfunction()

function(ns_metal_embed target symbol source)
    get_filename_component(_src "${source}" ABSOLUTE)
    file(READ "${_src}" NS_METAL_SOURCE_TEXT)
    string(FIND "${NS_METAL_SOURCE_TEXT}" ")nsmetal\"" _clash)
    if(NOT _clash EQUAL -1)
        message(FATAL_ERROR "ns_metal_embed: ${_src} contains the raw-string delimiter )nsmetal\"")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_src}")
    set(NS_METAL_SYMBOL "${symbol}")
    # file(CONFIGURE) rewrites the output only when it changes.
    file(CONFIGURE
        OUTPUT  "${CMAKE_CURRENT_BINARY_DIR}/ns_metal_${symbol}.cpp"
        CONTENT "// Generated by ns_metal_embed from ${_src}; do not edit.\nextern const char @NS_METAL_SYMBOL@[];\nconst char @NS_METAL_SYMBOL@[] = R\"nsmetal(@NS_METAL_SOURCE_TEXT@)nsmetal\";\n"
        @ONLY)
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/ns_metal_${symbol}.cpp")
endfunction()
